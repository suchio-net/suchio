{
  "name": "suchio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/prepare-cloudflare-assets.mjs",
    "start": "astro preview",
    "lint": "eslint .",
    "test": "bun test tests",
    "typecheck": "astro check",
    "deploy": "bun scripts/deploy-verified.mjs",
    "deploy:redirects": "bun scripts/deploy-verified.mjs --redirects",
    "types:workers": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --env-file .env.example",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "http-cache-semantics": "4.3.0",
    "nanoid": "3.3.18",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "undici": "7.29.1"
  }
}
