---
// Services as a list of large names. On wide screens the photo beside the list
// follows the service under the pointer or keyboard focus.
import Picture from "./Picture.astro";
import { base, services, tfm } from "./data";
---
<div class="switch" data-switch>
  <ul class="names">
    {services.map((service, index) => (
      <li>
        <a href={`${base}/leistungen/${service.slug}`} data-index={index} class:list={{ on: index === 0 }}>
          <span class="thumb" aria-hidden="true"><Picture name={service.image} alt="" sizes="96px" /></span>
          <span class="name">{service.name}</span>
          <span class="summary">{service.summary}</span>
        </a>
      </li>
    ))}
    <li class="b2b">
      <a href={tfm.href}>
        <span class="name">{tfm.name}</span>
        <span class="summary">Für Hausverwaltungen und Gewerbe: {tfm.summary.replace(/ für Hausverwaltungen und Gewerbe\.$/, ".")}</span>
      </a>
    </li>
  </ul>
  <div class="stage" aria-hidden="true">
    {services.map((service, index) => <figure class:list={["shot", { on: index === 0 }]} data-shot={index}><Picture name={service.image} alt="" sizes="(min-width: 1024px) 42vw, 1px" /></figure>)}
  </div>
</div>

<style>
  .switch { display: grid; gap: 40px; }
  .names { border-top: 1px solid var(--grout-line); }
  .names li { border-bottom: 1px solid var(--grout-line); }
  .names a { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 4px 18px; align-items: center; padding: 18px 0; text-decoration: none; }
  .thumb { grid-row: 1 / 3; width: 72px; height: 72px; overflow: hidden; border-radius: 14px; background: var(--grout); }
  .thumb :global(picture), .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .name { font-size: clamp(1.35rem, 1rem + 1.6vw, 2.35rem); font-weight: 640; letter-spacing: -0.035em; line-height: 1.1; transition: color 0.3s, transform 0.5s var(--ease); }
  .summary { color: var(--slate-soft); font-size: 0.98rem; line-height: 1.45; max-width: 46ch; }
  .b2b a { grid-template-columns: 1fr; }
  .names a:hover .name, .names a:focus-visible .name { color: var(--copper-text); }
  .stage { display: none; }

  @media (min-width: 1024px) {
    .switch { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; align-items: stretch; }
    .names a { grid-template-columns: 1fr; padding: 22px 0; }
    .thumb { display: none; }
    .names a:hover .name, .names a.on .name { transform: translateX(14px); }
    .names a.on .name { color: var(--copper-text); }
    .stage { position: relative; display: block; min-height: 480px; overflow: hidden; border-radius: var(--radius); background: var(--grout); }
    .shot { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 0.6s var(--ease); }
    .shot :global(picture), .shot :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .shot :global(img) { transform: scale(1.06); transition: transform 1.4s var(--ease); }
    .shot.on { opacity: 1; }
    .shot.on :global(img) { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-switch]").forEach(root => {
    const links = [...root.querySelectorAll<HTMLAnchorElement>("a[data-index]")];
    const shots = [...root.querySelectorAll<HTMLElement>("[data-shot]")];
    const show = (index: number) => {
      links.forEach(link => link.classList.toggle("on", Number(link.dataset.index) === index));
      shots.forEach(shot => shot.classList.toggle("on", Number(shot.dataset.shot) === index));
    };
    links.forEach(link => {
      const index = Number(link.dataset.index);
      link.addEventListener("pointerenter", () => show(index));
      link.addEventListener("focus", () => show(index));
    });
  });
</script>
