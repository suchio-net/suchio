---
// Verified Google review excerpts, one large quote at a time. A progress line
// runs under the quote and moves on when it is full; hover, focus or leaving
// the screen pause it. With reduced motion it only moves on request.
import Note from "../Note.astro";
import { company, google, testimonials } from "../data";

interface Props { title?: string }
const { title = "Stimmen" } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---
<section class="reviews wrap" aria-labelledby="reviews-title" data-reviews>
  <div class="top">
    <h2 id="reviews-title" class="index mono">{title}</h2>
    <a class="score" href={google.profile} rel="noopener">
      <span class="score-value" data-count={company.rating.value.replace(",", ".")} data-decimals="1">{company.rating.value}</span>
      <span class="score-meta mono"><span aria-hidden="true">★★★★★</span><span>{company.rating.count} Google-Bewertungen</span></span>
    </a>
  </div>

  <div class="stack rel" aria-roledescription="Karussell" aria-label="Google-Bewertungen">
    {testimonials.map((review, index) => (
      <figure class:list={["quote", { on: index === 0 }]} aria-roledescription="Folie" aria-label={`${index + 1} von ${testimonials.length}`} aria-hidden={index === 0 ? undefined : "true"} data-quote>
        <blockquote cite={review.href}><p>{review.quote}</p></blockquote>
        <figcaption class="mono"><span>{review.author}</span><a href={review.href} rel="noopener" tabindex={index === 0 ? undefined : -1} aria-label={`Vollständige Google-Bewertung von ${review.author} lesen`}>Auf Google lesen ↗</a></figcaption>
      </figure>
    ))}
    <Note n={4} style="right:0;top:-64px">Sechs originale Auszüge mit den Namen aus Ihrem Google-Profil und direkten Links zu den vollständigen Rezensionen. Google zeigt 5,0 Sterne aus 26 Bewertungen. Geprüft am 10. Oktober 2026.</Note>
  </div>

  <div class="controls">
    <span class="progress" aria-hidden="true"><i data-progress></i></span>
    <span class="count mono" aria-hidden="true"><span data-current>01</span> / {pad(testimonials.length)}</span>
    <button type="button" class="nav" data-step="-1"><span aria-hidden="true">←</span><span class="sr-only">Vorherige Bewertung</span></button>
    <button type="button" class="nav" data-step="1"><span aria-hidden="true">→</span><span class="sr-only">Nächste Bewertung</span></button>
  </div>
  <p class="links mono"><a href={google.profile} rel="noopener">Alle Bewertungen</a><a href={google.review} rel="noopener">Bewertung schreiben</a></p>
</section>

<style>
  .reviews { display: grid; gap: clamp(32px, 4vw, 56px); padding-block: clamp(96px, 12vw, 180px); }
  .top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px; }
  .score { display: flex; align-items: end; gap: 16px; text-decoration: none; }
  .score-value { font-size: clamp(3rem, 2rem + 4vw, 5.5rem); font-weight: 400; line-height: 0.85; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .score-meta { display: grid; gap: 4px; color: var(--mute); }
  .score-meta span:first-child { color: var(--ink); letter-spacing: 3px; }
  .score:hover .score-meta span:last-child { text-decoration: underline; text-underline-offset: 4px; }

  .stack { display: grid; min-height: clamp(260px, 30vw, 380px); }
  .quote { grid-area: 1 / 1; display: grid; align-content: space-between; gap: 32px; margin: 0; opacity: 0; visibility: hidden; transform: translateY(24px); filter: blur(8px); transition: opacity 0.6s var(--ease), transform 0.9s var(--ease), filter 0.6s var(--ease), visibility 0s 0.6s; }
  .quote:global(.on) { opacity: 1; visibility: visible; transform: none; filter: none; transition: opacity 0.9s var(--ease) 0.15s, transform 1.1s var(--ease) 0.15s, filter 0.9s var(--ease) 0.15s; }
  .quote blockquote { margin: 0; }
  .quote p { max-width: 30ch; font-size: clamp(1.6rem, 1rem + 2.6vw, 3.3rem); font-weight: 400; line-height: 1.1; letter-spacing: -0.045em; }
  .quote p::before { content: "„"; }
  .quote p::after { content: "“"; }
  .quote figcaption { display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--mute); }
  .quote figcaption span { color: var(--ink); }
  .quote figcaption a { text-decoration: none; }
  .quote figcaption a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  .controls { display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 12px 20px; }
  .progress { height: 1px; background: var(--line-2); overflow: hidden; }
  .progress i { display: block; height: 100%; background: var(--ink); transform-origin: left; transform: scaleX(0); }
  .reviews:global(.playing) .progress i { animation: fill 7s linear forwards; }
  .reviews:global(.paused) .progress i { animation-play-state: paused; }
  @keyframes fill { to { transform: scaleX(1); } }
  .count { color: var(--mute); font-variant-numeric: tabular-nums; }
  .count span { color: var(--ink); }
  .nav { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line-2); border-radius: 50%; background: none; font-family: var(--mono); cursor: pointer; transition: background-color 0.35s var(--ease), color 0.35s var(--ease), border-color 0.35s; }
  .nav:hover { background: var(--ink); color: var(--white); border-color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 24px; color: var(--mute); }
  .links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .links a:hover { color: var(--ink); }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-reviews]");
  if (root) {
    const quotes = [...root.querySelectorAll<HTMLElement>("[data-quote]")];
    const bar = root.querySelector<HTMLElement>("[data-progress]")!;
    const current = root.querySelector<HTMLElement>("[data-current]")!;
    const autoplay = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0, inView = false, held = false;

    const show = (next: number) => {
      index = (next + quotes.length) % quotes.length;
      quotes.forEach((quote, i) => {
        const on = i === index;
        quote.classList.toggle("on", on);
        if (on) quote.removeAttribute("aria-hidden"); else quote.setAttribute("aria-hidden", "true");
        quote.querySelector("a")?.setAttribute("tabindex", on ? "0" : "-1");
      });
      current.textContent = String(index + 1).padStart(2, "0");
      // Restart the progress line.
      root.classList.remove("playing");
      void bar.offsetWidth;
      if (autoplay) root.classList.add("playing");
    };
    const syncPause = () => root.classList.toggle("paused", held || !inView);

    root.querySelectorAll<HTMLButtonElement>("[data-step]").forEach(button => button.addEventListener("click", () => show(index + Number(button.dataset.step))));
    if (autoplay) {
      bar.addEventListener("animationend", () => show(index + 1));
      root.addEventListener("pointerenter", () => { held = true; syncPause(); });
      root.addEventListener("pointerleave", () => { held = false; syncPause(); });
      root.addEventListener("focusin", () => { held = true; syncPause(); });
      root.addEventListener("focusout", event => { if (!root.contains(event.relatedTarget as Node)) { held = false; syncPause(); } });
      new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; syncPause(); }, { threshold: 0.3 }).observe(root);
      syncPause();
      root.classList.add("playing");
    }

    let startX = 0;
    const stack = root.querySelector<HTMLElement>(".stack")!;
    stack.addEventListener("touchstart", event => { startX = event.touches[0].clientX; }, { passive: true });
    stack.addEventListener("touchend", event => { const delta = event.changedTouches[0].clientX - startX; if (Math.abs(delta) > 50) show(index + (delta < 0 ? 1 : -1)); });
  }
</script>
