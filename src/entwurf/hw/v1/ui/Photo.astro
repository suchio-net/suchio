---
// Project photo: grey until it reaches the middle of the screen or is hovered,
// then in colour. Opens full size in the lightbox (ui/Lightbox.astro).
import Picture from "@/entwurf/hw/Picture.astro";
import { imageSources } from "@/entwurf/hw/images";

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  group?: string;
  class?: string;
  wipe?: boolean;
  style?: string;
}
const { name, alt, sizes, eager, group = "page", class: className, wipe = false, style } = Astro.props;
const source = imageSources(name);
---

<figure class:list={["photo", className]} data-photo data-wipe={wipe || undefined} style={style}>
  <button
    type="button"
    class="photo-zoom"
    data-zoom={source.zoom}
    data-zoom-alt={alt}
    data-zoom-group={group}
    aria-label={`Foto vergrößern: ${alt}`}
  >
    <Picture name={name} alt={alt} sizes={sizes} eager={eager} />
  </button>
</figure>
<style>
  .photo-zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .photo-zoom :global(picture) {
    background: var(--fog) !important;
  }
  .photo-zoom:focus-visible {
    outline-offset: -3px;
  }
</style>
