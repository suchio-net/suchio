---
// Shared full-size photo viewer for every [data-zoom] button on the page.
---
<dialog class="lightbox" aria-label="Foto" data-lightbox>
  <div class="lb-bar mono">
    <p class="lb-count" data-lb-count></p>
    <button type="button" class="lb-btn mono" data-lb-close>Schließen</button>
  </div>
  <figure class="lb-figure">
    <img alt="" data-lb-img />
    <figcaption data-lb-caption></figcaption>
  </figure>
  <button type="button" class="lb-nav lb-prev mono" data-lb-step="-1"><span aria-hidden="true">←</span><span class="sr-only">Vorheriges Foto</span></button>
  <button type="button" class="lb-nav lb-next mono" data-lb-step="1"><span aria-hidden="true">→</span><span class="sr-only">Nächstes Foto</span></button>
</dialog>

<style>
  .lightbox { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: rgb(11 11 12 / 0.97); color: var(--on-night); }
  .lightbox[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); animation: lb-in 0.5s var(--ease) both; }
  @keyframes lb-in { from { opacity: 0; } }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.5); }
  .lb-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px var(--gutter); }
  .lb-count { color: var(--mute-night); font-variant-numeric: tabular-nums; }
  .lb-btn { min-height: 44px; padding: 0 4px; border: 0; background: none; color: inherit; cursor: pointer; }
  .lb-figure { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 14px; min-height: 0; margin: 0; padding: 0 clamp(12px, 8vw, 110px) 24px; }
  .lb-figure img { width: 100%; height: 100%; min-height: 0; object-fit: contain; animation: lb-img 0.7s var(--ease) both; }
  @keyframes lb-img { from { opacity: 0; transform: scale(0.97); } }
  .lb-figure figcaption { max-width: 70ch; margin-inline: auto; text-align: center; font-size: 0.88rem; color: var(--mute-night); }
  .lb-nav { position: absolute; top: 50%; display: grid; place-items: center; width: 52px; height: 52px; margin-top: -26px; border: 1px solid var(--line-night); border-radius: 50%; background: none; color: inherit; font-size: 1rem; cursor: pointer; transition: background-color 0.3s, color 0.3s; }
  .lb-nav:hover { background: var(--white); color: var(--ink); }
  .lb-prev { left: clamp(8px, 2vw, 32px); }
  .lb-next { right: clamp(8px, 2vw, 32px); }
  .lightbox:global(.single) .lb-nav, .lightbox:global(.single) .lb-count { visibility: hidden; }
  .lightbox :focus-visible { outline-color: #fff; }
  @media (max-width: 600px) { .lb-nav { top: auto; bottom: 16px; margin: 0; } .lb-figure { padding-bottom: 84px; } }
</style>

<script>
  const box = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (box) {
    const img = box.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const caption = box.querySelector<HTMLElement>("[data-lb-caption]")!;
    const count = box.querySelector<HTMLElement>("[data-lb-count]")!;
    let items: HTMLElement[] = [], index = 0, opener: HTMLElement | null = null;
    const pad = (n: number) => String(n).padStart(2, "0");
    const show = (next: number) => {
      index = (next + items.length) % items.length;
      const item = items[index];
      img.src = item.dataset.zoom!;
      img.alt = item.dataset.zoomAlt ?? "";
      caption.textContent = item.dataset.zoomAlt ?? "";
      count.textContent = `${pad(index + 1)} / ${pad(items.length)}`;
      img.getAnimations().forEach(animation => { animation.cancel(); animation.play(); });
    };
    document.addEventListener("click", event => {
      const trigger = (event.target as Element).closest<HTMLElement>("[data-zoom]");
      if (!trigger) return;
      items = [...document.querySelectorAll<HTMLElement>(`[data-zoom][data-zoom-group="${trigger.dataset.zoomGroup}"]`)].filter(item => item.offsetParent !== null);
      if (!items.includes(trigger)) items = [trigger];
      opener = trigger;
      box.classList.toggle("single", items.length < 2);
      show(items.indexOf(trigger));
      box.showModal();
    });
    box.querySelectorAll<HTMLButtonElement>("[data-lb-step]").forEach(button => button.addEventListener("click", () => show(index + Number(button.dataset.lbStep))));
    box.querySelector("[data-lb-close]")!.addEventListener("click", () => box.close());
    box.addEventListener("click", event => { if (event.target === box || event.target === box.querySelector(".lb-figure")) box.close(); });
    box.addEventListener("keydown", event => {
      if (items.length < 2) return;
      if (event.key === "ArrowRight") show(index + 1);
      if (event.key === "ArrowLeft") show(index - 1);
    });
    let startX = 0;
    box.addEventListener("touchstart", event => { startX = event.touches[0].clientX; }, { passive: true });
    box.addEventListener("touchend", event => { const delta = event.changedTouches[0].clientX - startX; if (items.length > 1 && Math.abs(delta) > 50) show(index + (delta < 0 ? 1 : -1)); });
    box.addEventListener("close", () => { img.removeAttribute("src"); opener?.focus(); });
  }
</script>
