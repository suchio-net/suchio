---
// A real sequence of steps in a row. The connecting line fills as the row
// scrolls through the viewport, so the order reads at a glance.
interface Step { title: string; text?: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<div class="steps-wrap" data-steps style={`--n:${steps.length}`}>
  <div class="track" aria-hidden="true"><span data-steps-fill></span></div>
  <ol class="steps">
    {steps.map((step, index) => (
      <li>
        <span class="dot" aria-hidden="true">{index + 1}</span>
        <h3>{step.title}</h3>
        {step.text && <p class="soft">{step.text}</p>}
      </li>
    ))}
  </ol>
</div>

<style>
  .steps-wrap { position: relative; }
  .steps { position: relative; display: grid; gap: 32px; }
  .steps li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 6px 20px; align-content: start; }
  .steps li > :not(.dot) { grid-column: 2; }
  .dot { grid-row: 1 / 3; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--grout-line); font-weight: 650; font-variant-numeric: tabular-nums; transition: background-color 0.4s, color 0.4s, box-shadow 0.4s; }
  .steps li.done .dot { background: var(--copper); color: #fff; box-shadow: none; }
  .steps h3 { padding-top: 10px; }
  .track { position: absolute; left: 23px; top: 24px; bottom: 24px; width: 2px; background: var(--grout-line); }
  .track span { position: absolute; inset: 0; background: var(--copper); transform: scaleY(var(--p, 0)); transform-origin: top; }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 32px; }
    .steps li { grid-template-columns: 1fr; gap: 12px; }
    .steps li > :not(.dot) { grid-column: 1; }
    .dot { grid-row: auto; }
    .steps h3 { padding-top: 8px; }
    .track { left: 24px; right: calc((100% - (var(--n) - 1) * 32px) / var(--n) - 24px); top: 23px; bottom: auto; width: auto; height: 2px; }
    .track span { transform: scaleX(var(--p, 0)); transform-origin: left; }
  }
  :global(html:not(.js)) .track span { transform: none; }
  :global(html:not(.js)) .dot { background: var(--copper); color: #fff; box-shadow: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-steps]").forEach(root => {
    const items = [...root.querySelectorAll("li")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let frame = 0;
    const update = () => {
      frame = 0;
      const box = root.getBoundingClientRect();
      // 0 when the row enters the lower third, 1 when it reaches the upper third.
      const progress = reduce ? 1 : Math.min(1, Math.max(0, (innerHeight * 0.85 - box.top) / (innerHeight * 0.5)));
      root.style.setProperty("--p", String(progress));
      items.forEach((item, index) => item.classList.toggle("done", progress >= index / Math.max(1, items.length - 1) - 0.001));
    };
    const request = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener("scroll", request, { passive: true });
    addEventListener("resize", request);
    update();
  });
</script>
