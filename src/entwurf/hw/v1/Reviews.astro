---
// Verified Google review excerpts in the existing scrolling row.
import Note from "./Note.astro";
import { company, google, testimonials } from "./data";

interface Props { title?: string }
const { title = "Das sagen unsere Kunden" } = Astro.props;
const stars = Array.from({ length: 5 });
const g = `<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>`;
---
<section class="reviews" aria-labelledby="reviews-title">
  <div class="wrap top">
    <div class="intro">
      <h2 id="reviews-title">{title}</h2>
      <a class="score" href={google.profile} rel="noopener">
        <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true" set:html={g} />
        <strong>{company.rating.value}</strong>
        <span class="stars" aria-hidden="true">{stars.map(() => <i />)}</span>
        <span class="count">{company.rating.count} Bewertungen auf Google</span>
      </a>
    </div>
    <p class="links"><a class="text-link" href={google.profile} rel="noopener">Alle Bewertungen auf Google</a><a class="text-link" href={google.review} rel="noopener">Bewertung schreiben</a></p>
  </div>
  <div class="rel">
    <ul class="row">
      {testimonials.map(review => (
        <li class="card">
          <div class="card-top">
            <span class="stars" role="img" aria-label={`${review.stars} von 5 Sternen`}>{Array.from({ length: review.stars }, () => <i />)}</span>
            <svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true" set:html={g} />
          </div>
          <blockquote cite={review.href}><p>{review.quote}</p></blockquote>
          <p class="source"><strong>{review.author}</strong><a href={review.href} rel="noopener" aria-label={`Vollständige Google-Bewertung von ${review.author} lesen`}>Google-Bewertung · Auszug</a></p>
        </li>
      ))}
    </ul>
    <Note n={4} style="left:var(--gutter);top:-56px">Sechs originale Auszüge mit den Namen aus Ihrem Google-Profil und direkten Links zu den vollständigen Rezensionen. Google zeigt 5,0 Sterne aus 26 Bewertungen. Geprüft am 10. Oktober 2026.</Note>
  </div>
</section>

<style>
  .reviews { padding-block: clamp(72px, 9vw, 136px); background: var(--grout); }
  .top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px 48px; margin-bottom: clamp(32px, 4vw, 48px); }
  .intro { display: grid; gap: 20px; }
  .intro h2 { max-width: 14ch; }
  .score { display: inline-grid; grid-template-columns: auto auto auto; align-items: center; justify-self: start; gap: 2px 12px; text-decoration: none; }
  .score strong { font-size: 2.4rem; font-weight: 650; letter-spacing: -0.03em; line-height: 1; }
  .count { grid-column: 2 / -1; color: var(--slate-soft); font-size: 0.95rem; }
  .score svg { grid-row: 1 / 3; }
  .score:hover .count { text-decoration: underline; }
  .stars { display: inline-flex; gap: 2px; }
  .stars i { width: 17px; height: 17px; background: #f5b400; clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 28px; }
  .row { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); padding: 4px max(var(--gutter), calc((100vw - var(--max)) / 2)) 20px; scrollbar-width: thin; scrollbar-color: var(--grout-line) transparent; }
  .card { flex: none; display: flex; flex-direction: column; gap: 16px; width: min(420px, 82vw); padding: 28px 28px 24px; background: var(--board); border-radius: var(--radius); scroll-snap-align: start; }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .card blockquote { flex: 1; margin: 0; }
  .card blockquote p { font-size: var(--step-1); line-height: 1.45; letter-spacing: -0.01em; }
  .card blockquote p::before { content: "„"; }
  .card blockquote p::after { content: "“"; }
  .source { font-size: 0.92rem; color: var(--slate-soft); }
  .source strong { display: block; color: var(--ink); }
  .source a { text-underline-offset: 0.2em; }
</style>
