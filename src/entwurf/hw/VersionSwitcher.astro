---
// Both drafts share the same routes, so the switch keeps the visitor on the same page.
interface Props { version: "v1" | "v2" }
const { version } = Astro.props;
const suffix = Astro.url.pathname.replace(/\/$/, "").replace(/^\/entwurf\/(?:hw\/v[12]|handwerker-work)/, "");
---
<nav class="hw-versions" aria-label="Entwurfsversion">
  <a href={`/entwurf/hw/v1${suffix}`} aria-current={version === "v1" ? "page" : undefined}>V1</a>
  <a href={`/entwurf/hw/v2${suffix}`} aria-current={version === "v2" ? "page" : undefined}>V2</a>
</nav>
<style>
  .hw-versions { position: fixed; right: 12px; bottom: 12px; z-index: 60; display: flex; padding: 3px; gap: 2px; border: 1px solid #2a383d; background: #fff; font: 700 14px/1 system-ui, sans-serif; }
  .hw-versions a { display: grid; place-items: center; min-width: 44px; min-height: 40px; color: #2a383d; text-decoration: none; }
  .hw-versions a[aria-current] { color: #fff; background: #2a383d; }
  .hw-versions a:focus-visible { outline: 3px solid #0050c8; outline-offset: 2px; }
  @media (max-width: 760px) { .hw-versions { bottom: calc(144px + env(safe-area-inset-bottom)); right: 8px; } }
</style>
