---
// Verified Google review excerpts, with authors and links to the originals.
import Note from "./Note.astro";
import { google, testimonials } from "./data";

interface Props { title?: string }
const { title = "Das sagen unsere Kunden" } = Astro.props;
---
<section class="band band-grout reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="top">
      <h2 id="reviews-title" class="section-title">{title}</h2>
    </div>
    <div class="rel">
    <ul class="cards" data-review-cards>
      {testimonials.map(review => (
        <li class="card">
          <a class="card-link" href={review.href} rel="noopener" aria-label={`Google-Bewertung von ${review.author} öffnen`}>
          <div class="card-top">
            <span class="stars" role="img" aria-label={`${review.stars} von 5 Sternen`}>{Array.from({ length: review.stars }, () => <i />)}</span>
            <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          </div>
          <blockquote cite={review.href}><p>{review.quote}</p></blockquote>
          <p class="source"><strong>{review.author}</strong></p>
          </a>
        </li>
      ))}
    </ul>
    <div class="dots" role="group" aria-label="Bewertungen durchblättern" data-review-dots>
      {testimonials.map((review, index) => <button type="button" aria-label={`Bewertung ${index + 1} von ${testimonials.length}: ${review.author}`} aria-current={index === 0 ? "true" : undefined}></button>)}
    </div>
      <Note n={5} style="right:0;top:-56px">Sechs originale Auszüge mit den Namen aus Ihrem Google-Profil und direkten Links zu den vollständigen Rezensionen. Google zeigt 5,0 Sterne aus 26 Bewertungen. Geprüft am 10. Oktober 2026.</Note>
    </div>
    <p class="links"><a class="text-link" href={google.profile} rel="noopener">Alle Bewertungen auf Google</a><a class="text-link" href={google.review} rel="noopener">Bewertung schreiben</a></p>
  </div>
</section>

<style>
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; margin-bottom: clamp(28px, 4vw, 48px); }
  .top .section-title { margin-bottom: 0; max-width: none; }
  @media (min-width: 700px) { .top .section-title { white-space: nowrap; } }
  .stars { display: inline-flex; gap: 2px; }
  .stars i { width: 16px; height: 16px; background: #fbbc04; clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
  .cards { display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr; gap: var(--joint); }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1060px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card { display: flex; min-width: 0; background: var(--board); }
  .dots { display: none; }
  /* Phones: a deck of cards. The front card is swiped away; the next two sit behind it
     to the right, smaller and darker, with part of their text showing. */
  @media (max-width: 699px) {
    .cards.stacked { grid-template-columns: minmax(0, calc(100% - 72px)); grid-template-areas: "deck"; grid-auto-rows: auto; gap: 0; }
    .stacked .card { --pos: 0; --x: 0px; grid-area: deck; z-index: calc(10 - var(--pos)); transform-origin: 100% 50%; transform: translateX(var(--x)) scale(calc(1 - var(--pos) * 0.06)); filter: brightness(calc(1 - var(--pos) * 0.1)); box-shadow: 0 1px 0 rgb(0 0 0 / 0.06), 0 10px 24px -14px rgb(20 28 31 / 0.45); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.45s, opacity 0.3s; touch-action: pan-y; user-select: none; }
    .stacked .card.far { opacity: 0; pointer-events: none; }
    .stacked .card.dragging { transition: none; }
    :global(.js) .dots { display: flex; justify-content: center; gap: 4px; margin-top: 10px; }
    .dots button { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; }
    .dots button::before { content: ""; width: 8px; height: 8px; background: var(--grout-line); transition: width 0.25s, background-color 0.25s; }
    .dots button[aria-current="true"]::before { width: 22px; background: var(--copper); }
  }
  @media (max-width: 699px) and (prefers-reduced-motion: reduce) { .stacked .card { transition: none; } }
  .card-link { display: flex; flex: 1; flex-direction: column; gap: 14px; min-width: 0; padding: 22px 24px 20px; color: inherit; text-decoration: none; }
  .card-link:hover .source strong { text-decoration: underline; text-underline-offset: 0.2em; }
  .card-link:focus-visible { outline-offset: -3px; }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .card blockquote { flex: 1; margin: 0; }
  .card blockquote p { font-size: var(--step-1); line-height: 1.45; }
  .card blockquote p::before { content: "„"; }
  .card blockquote p::after { content: "“"; }
  .source { font-size: 0.92rem; color: var(--slate-soft); }
  .source strong { display: block; color: var(--slate); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 24px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-review-cards]").forEach(list => {
    const dots = [...(list.parentElement?.querySelectorAll<HTMLButtonElement>("[data-review-dots] button") ?? [])];
    const cards = [...list.children] as HTMLElement[];
    const phone = matchMedia("(max-width: 699px)");
    const n = cards.length;
    let index = 0;

    const render = () => {
      const stacked = phone.matches;
      list.classList.toggle("stacked", stacked);
      cards.forEach((card, position) => {
        const pos = (position - index + n) % n;
        card.style.setProperty("--pos", String(Math.min(pos, 3)));
        card.style.setProperty("--x", `${[0, 46, 72, 72][Math.min(pos, 3)]}px`);
        card.classList.toggle("far", stacked && pos > 2);
        // Only the front card can be focused or read out while the deck is shown.
        card.inert = stacked && pos !== 0;
      });
      dots.forEach((dot, position) => position === index ? dot.setAttribute("aria-current", "true") : dot.removeAttribute("aria-current"));
    };
    const go = (next: number) => { index = (next + n) % n; render(); };
    dots.forEach((dot, position) => dot.addEventListener("click", () => go(position)));
    phone.addEventListener("change", () => { cards.forEach(card => { card.style.transform = ""; }); render(); });

    // Swipe the front card: left for the next review, right for the previous one.
    cards.forEach(card => {
      let startX = 0, startY = 0, dx = 0, active = false, moved = false;
      card.addEventListener("pointerdown", event => {
        if (!phone.matches || card.inert) return;
        startX = event.clientX; startY = event.clientY; dx = 0; active = true; moved = false;
      });
      card.addEventListener("pointermove", event => {
        if (!active) return;
        dx = event.clientX - startX;
        if (!moved && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(event.clientY - startY)) { moved = true; card.classList.add("dragging"); card.setPointerCapture(event.pointerId); }
        if (moved) card.style.transform = `translateX(${dx}px) rotate(${dx / 24}deg)`;
      });
      const end = () => {
        if (!active) return;
        active = false;
        card.classList.remove("dragging");
        if (moved && Math.abs(dx) > 70) {
          card.style.transform = `translateX(${Math.sign(dx) * 120}%) rotate(${Math.sign(dx) * 12}deg)`;
          setTimeout(() => { card.style.transform = ""; go(index + (dx < 0 ? 1 : -1)); }, 220);
        } else card.style.transform = "";
      };
      card.addEventListener("pointerup", end);
      card.addEventListener("pointercancel", end);
      // Links are draggable by default, which would cancel the swipe.
      card.addEventListener("dragstart", event => event.preventDefault());
      // A swipe must not also open the review.
      card.addEventListener("click", event => { if (moved) { event.preventDefault(); moved = false; } }, true);
    });
    render();
  });
</script>
