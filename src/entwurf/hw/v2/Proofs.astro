---
// Proof strip: master qualification, Google rating and the platform marks from the
// current site. "full" adds the quality standards list for the services overview.
import Note from "@/entwurf/hw/Note.astro";
import { assetBase, company, google } from "./data";
import { platformBadges, qualityStandards } from "../proofs";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;
---

<section class:list={["proofs", { "band band-grout": full }]} aria-labelledby="proofs-title">
  <div class="wrap">
    <h2 id="proofs-title" class:list={[full ? "section-title proofs-title" : "sr-only"]}>
      {full ? "Qualität und Nachweise" : "Nachweise"}
    </h2>
    <div class="strip rel">
      <div class="cell master">
        <img
          class="seal"
          src={`${assetBase}/badges/meisterbetrieb-240.webp`}
          srcset={`${assetBase}/badges/meisterbetrieb-240.webp 240w, ${assetBase}/badges/meisterbetrieb-480.webp 480w`}
          sizes="76px"
          alt="Siegel Meisterbetrieb"
          width="240"
          height="240"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="cell-title">Meisterbetrieb</p>
          <p class="cell-text">In der Handwerkskammer eingetragen für {company.credentials}</p>
        </div>
      </div>
      <a class="cell google" href={google.profile} rel="noopener">
        <svg viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
          <path
            fill="#EA4335"
            d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
          />
          <path
            fill="#4285F4"
            d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
          />
          <path
            fill="#FBBC05"
            d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
          />
          <path
            fill="#34A853"
            d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
          />
        </svg>
        <div>
          <p class="cell-title rating-line">
            {company.rating.value} von 5
            <span class="stars" role="img" aria-label="5 von 5 Sternen">
              {Array.from({ length: 5 }, () => (
                <i />
              ))}
            </span>
          </p>
          <p class="cell-text">{company.rating.count} Bewertungen auf Google</p>
        </div>
      </a>
      <div class="cell platforms">
        {platformBadges.map((badge) => (
          <img
            src={`${assetBase}/badges/${badge.file}`}
            alt={badge.alt}
            width={badge.width}
            height={badge.height}
            loading="lazy"
            decoding="async"
            class={badge.key}
          />
        ))}
      </div>
      <Note n={2} style="right:0;top:-56px">
        Ihre Nachweise von der heutigen Seite. Bitte senden Sie den Namen der Handwerkskammer und aktuelle Profil-Links:
        Die CHECK24- und MyHammer-Links auf Ihrer Seite führen ins Leere.
      </Note>
    </div>
    {full && (
      <ul class="standards items">
        {qualityStandards.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .proofs:not(.band) {
    padding-block: 0 clamp(40px, 5vw, 64px);
    background: var(--grout);
  }
  .strip {
    display: grid;
    gap: var(--joint);
    background: var(--grout);
  }
  @media (min-width: 760px) {
    .strip {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  .cell {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 104px;
    padding: 18px 22px;
    background: var(--board);
    color: inherit;
    text-decoration: none;
  }
  .cell p {
    max-width: none;
  }
  .cell-title {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.05;
  }
  .cell-text {
    font-size: 0.96rem;
    line-height: 1.4;
    color: var(--slate-soft);
  }
  .seal {
    flex: none;
    width: 76px;
    height: 76px;
  }
  .google svg {
    flex: none;
  }
  .rating-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
  }
  .stars i {
    width: 18px;
    height: 18px;
    background: #fbbc04;
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .google:hover .cell-text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .platforms {
    justify-content: center;
    gap: 28px;
  }
  .platforms .check24 {
    width: 74px;
    height: auto;
  }
  .platforms .myhammer {
    width: 132px;
    height: auto;
  }
  .proofs-title {
    max-width: none;
  }
  /* Phones: three compact rows instead of three tall boxes. */
  @media (max-width: 759px) {
    .strip .cell {
      min-height: 0;
      padding: 14px 16px;
      gap: 14px;
    }
    .strip .seal {
      width: 60px;
      height: 60px;
    }
    .strip .google svg {
      width: 40px;
      height: 26px;
    }
    .strip .platforms {
      justify-content: flex-start;
      gap: 20px;
      padding-left: 18px;
    }
    .strip .platforms .check24 {
      width: 52px;
    }
    .strip .platforms .myhammer {
      width: 104px;
    }
  }
  .standards {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 12px 48px;
    margin-top: clamp(28px, 4vw, 40px);
  }
</style>
