---
import Zoom from "./Zoom.astro";
import { base } from "./data";

interface Crumb { name: string; href?: string }
interface Props { crumbs: Crumb[]; title: string; intro?: string[]; image?: string; imageAlt?: string }
const { crumbs, title, intro = [], image, imageAlt = "" } = Astro.props;
const aside = Astro.slots.has("aside");
---
<section class="page-head">
  <div class="wrap">
    <nav aria-label="Brotkrumen"><ol class="crumbs">
      <li><a href={base}>Start</a></li>
      {crumbs.map(crumb => <li>{crumb.href ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}</li>)}
    </ol></nav>
    <div class:list={["head-grid", { "with-image": image || aside }]}>
      <div class="copy">
        <h1>{title}</h1>
        {intro.map((paragraph, index) => <p class:list={{ lead: index === 0 }}>{paragraph}</p>)}
        <slot />
      </div>
      {aside && <div class="head-aside"><slot name="aside" /></div>}
      {image && <figure class="head-image"><Zoom name={image} alt={imageAlt} group="head" eager sizes="(min-width: 960px) 44vw, 100vw" /></figure>}
    </div>
  </div>
</section>
<style>
  .page-head { padding-block: 8px clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--grout-line); }
  .head-grid { display: grid; gap: 32px; margin-top: clamp(16px, 3vw, 32px); }
  @media (min-width: 960px) { .head-grid.with-image { grid-template-columns: 1fr 1fr; gap: 56px; align-items: end; } }
  .copy { display: grid; gap: 18px; align-content: start; }
  .copy h1 { font-size: var(--step-4); max-width: 16ch; }
  .head-image { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--grout); }
  .head-image :global(picture), .head-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
