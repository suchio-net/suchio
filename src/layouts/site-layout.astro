---
import ScrollReveal from "@/components/scroll-reveal.astro";
import SiteHeader from "@/components/header/site-header.astro";
import SiteFooter from "@/components/site-footer.astro";
import StructuredData from "@/components/structured-data.astro";
import dmSansLatin from "@/assets/fonts/dm-sans-latin-standard-normal.woff2?url";
import { t, type Locale } from "@/lib/i18n";
import { getServiceCatalog } from "@/lib/service-catalog";
import { pageMetadata } from "@/lib/site";
import { siteNodes, type SchemaNode } from "@/lib/structured-data";
import "@/styles/site.css";

interface Props {
  locale: Locale;
  canonicalPathname?: string;
  documentTitle?: string;
  title?: string;
  description: string;
  noindex?: boolean;
  referrer?: "no-referrer";
  /** Page-specific schema.org nodes, added to the site graph on indexable pages. */
  schema?: SchemaNode[];
}
// Prerendered files are emitted as "/about.html" and "/index.html"; public URLs drop the file name and trailing slash.
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "")
    .replace(/\/$/, "") || "/";
const {
  locale,
  canonicalPathname = pathname,
  documentTitle,
  title,
  description,
  noindex = false,
  referrer,
  schema = [],
} = Astro.props;
const metadata = pageMetadata({ locale, pathname: canonicalPathname, title, description });
const robots = noindex ? "noindex, follow" : "index, follow";
const serviceNames = getServiceCatalog(locale).map((service) => service.copy.name);
const graph = noindex
  ? undefined
  : { "@context": "https://schema.org", "@graph": [...siteNodes(locale, serviceNames), ...schema] };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF9F6" />
    <title>{documentTitle ?? metadata.title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta
      name="googlebot"
      content={noindex ? robots : `${robots}, max-video-preview:-1, max-image-preview:large, max-snippet:-1`}
    />
    <meta name="google-site-verification" content="ttGSsltDw6LeGrJfs_anOu-yBfO_hJ6rXYidUt_S0xI" />
    {referrer && <meta name="referrer" content={referrer} />}
    <link rel="canonical" href={metadata.alternates.canonical} />
    {Object.entries(metadata.alternates.languages).map(([language, href]) => (
      <link rel="alternate" hreflang={language} href={href} />
    ))}
    <meta property="og:type" content={metadata.openGraph.type} />
    <meta property="og:site_name" content={metadata.openGraph.siteName} />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={metadata.openGraph.url} />
    <meta property="og:locale" content={metadata.openGraph.locale} />
    {metadata.openGraph.alternateLocale.map((content) => (
      <meta property="og:locale:alternate" content={content} />
    ))}
    {metadata.openGraph.images.map((image) => (
      <>
        <meta property="og:image" content={image.url} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
      </>
    ))}
    <meta name="twitter:card" content={metadata.twitter.card} />
    <meta name="twitter:site" content="@suchionet" />
    <!-- Generated by scripts/generate-icons.mjs. Search engines use the 48px multiples. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/suchio-favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/suchio-favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/suchio-favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/suchio-favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    {graph && <StructuredData value={graph} />}
  </head>
  <body class="flex min-h-screen min-w-0 flex-col bg-canvas font-sans text-ink antialiased">
    <div
      aria-hidden="true"
      class="scroll-progress pointer-events-none fixed inset-x-0 top-0 z-[1100] h-1 origin-left bg-accent"
    ></div>
    <a
      class="fixed top-3 left-4 z-[1000] -translate-y-[160%] rounded-full bg-inverse-surface px-3.5 py-2.5 text-white focus-visible:translate-y-0"
      href="#main-content"
    >
      {t(locale, "a11y.skip")}
    </a>
    <ScrollReveal />
    <SiteHeader locale={locale} pathname={pathname} />
    <slot />
    <SiteFooter locale={locale} />
  </body>
</html>
