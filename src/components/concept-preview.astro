---
// Screenshot of a concept's first screen, taken at 1440 x 900 without the pitch-notes pill.
// The link next to it carries the meaning, so the picture is decorative.
interface Props {
  base?: string;
  sizes?: string;
  className?: string;
}
const {
  base = "/examples/hotels/flughotel-nordtor-preview",
  sizes = "(max-width: 760px) 100vw, 640px",
  className = "rounded-control border border-line shadow-surface",
} = Astro.props;
const srcset = (ext: string) => `${base}-720.${ext} 720w, ${base}-1440.${ext} 1440w`;
---

<picture>
  <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
  <img
    src={`${base}-1440.webp`}
    srcset={srcset("webp")}
    sizes={sizes}
    width="1440"
    height="900"
    alt=""
    loading="lazy"
    decoding="async"
    class={`block h-auto w-full ${className}`}
  />
</picture>
