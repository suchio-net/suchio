---
import { Check } from "@lucide/astro";
import CtaButton from "@/components/cta-button.astro";
import OfferVisual from "@/components/offer-visual.astro";
import type { ServiceCatalogEntry } from "@/lib/service-catalog";
import type { Locale } from "@/i18n/config";
interface Props {
  locale: Locale;
  service: ServiceCatalogEntry;
  revealDelay: number;
}
const { locale, service, revealDelay } = Astro.props;
const { copy } = service;
---

<div class="reveal mb-content-stack last:mb-0" data-reveal style={{ "--reveal-delay": `${revealDelay}ms` }}>
  <article class="grid grid-cols-2 items-center gap-x-8 max-nav:grid-cols-1 max-nav:gap-10">
    <div class={`min-w-0 max-w-[31rem] ${service.reverse ? "nav:order-2 nav:justify-self-end" : ""}`}>
      <h3 class="m-0 text-heading-lg text-balance">{copy.headline}</h3>
      <p class="mt-4 max-w-[46ch] text-lg/7 text-muted">{copy.summary}</p>
      <ul class="m-0 mt-7 grid list-none gap-3 p-0">
        {copy.highlights.map((item) => (
          <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] items-start gap-3 text-base/6 text-ink">
            <Check aria-hidden="true" class="mt-0.5 size-5 text-brand-500" stroke-width={2} />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <CtaButton href={service.href} className="mt-8">
        {copy.cta}
      </CtaButton>
    </div>
    <OfferVisual
      animation={service.animation}
      locale={locale}
      className={`max-nav:order-first ${service.reverse ? "nav:order-1" : ""}`}
    />
  </article>
</div>
