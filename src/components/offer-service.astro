---
import Disclosure from "@/components/disclosure.astro";
import CtaButton from "@/components/cta-button.astro";
import OfferVisual from "@/components/offer-visual.astro";
import type { ServiceCatalogEntry } from "@/lib/service-catalog";
import type { Locale } from "@/i18n/config";
interface Props {
  locale: Locale;
  service: ServiceCatalogEntry;
  revealDelay: number;
}
const { locale, service, revealDelay } = Astro.props;
const { copy } = service;
---

<div class="reveal mb-content-stack last:mb-0" data-reveal style={{ "--reveal-delay": `${revealDelay}ms` }}>
  <article class="grid grid-cols-2 items-center gap-x-8 max-nav:grid-cols-1 max-nav:gap-10">
    <div class={`min-w-0 max-w-[31rem] ${service.reverse ? "nav:order-2 nav:justify-self-end" : ""}`}>
      <h3 class="m-0 text-heading-md">{copy.name}</h3>
      <p class="mt-4 max-w-[46ch] text-lg/7 text-muted">{copy.summary}</p>
      <div class="relative mt-8">
        {copy.rows.map(([label, detail], row) => (
          <Disclosure
            id={`service-${service.id}-${row}`}
            group={`service-${service.id}`}
            title={label}
            compact
            defaultOpen={row === 0}
          >
            <p class="m-0 max-w-[44ch]">{detail}</p>
          </Disclosure>
        ))}
      </div>
      <CtaButton href={service.href} className="mt-6">
        {copy.cta}
      </CtaButton>
    </div>
    <OfferVisual
      animation={service.animation}
      locale={locale}
      className={service.reverse ? "nav:order-1" : undefined}
    />
  </article>
</div>
