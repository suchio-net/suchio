---
import { MapPin, Phone, Globe, Navigation, Sparkles } from "@lucide/astro";
import SectionHeading from "@/components/section-heading.astro";
import type { SearchPlace, SearchSourcesCopy } from "@/i18n/service-features";

interface Props {
  copy: SearchSourcesCopy;
}
const { copy } = Astro.props;
const places: SearchPlace[] = ["google", "maps", "ai"];
const id = "search-sources";
const actionIcons = [Navigation, Phone, Globe] as const;
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[70rem]">
    <SectionHeading title={copy.heading} copy={copy.copy} />
    <div
      class="sources-stage grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-10 rounded-[1.75rem] bg-service-search-bg p-12 max-compact:grid-cols-1 max-compact:gap-6 max-compact:p-5"
      data-search-sources
      data-active="google"
    >
      <div class="source-page min-w-0" aria-hidden="true">
        <div class="source-bar">mustermann-baeder.de/badsanierung-hofheim</div>
        <div class="source-part" data-source="google">
          <small>{copy.forSearch}</small>
          <b class="source-seo-title">{copy.seoTitle}</b>
          <span>{copy.seoDescription}</span>
        </div>
        <div class="source-content">
          <p class="source-title">{copy.pageTitle}</p>
          <p class="source-copy">{copy.pageCopy}</p>
        </div>
        <div class="source-part" data-source="maps">
          <span class="flex items-center gap-1.5">
            <MapPin class="size-3.5 shrink-0" stroke-width={2} />
            {copy.address}
          </span>
          <span class="text-subtle">{copy.hours}</span>
        </div>
        <div class="source-part" data-source="ai">
          <b>{copy.faqQuestion}</b>
          <span>{copy.faqAnswer}</span>
        </div>
      </div>

      <div class="min-w-0">
        <div class="sources-tabs" role="tablist" aria-label={copy.tabsLabel}>
          {places.map((place) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${place}`}
              aria-controls={`${id}-panel-${place}`}
              aria-selected={place === "google" ? "true" : "false"}
              tabindex={place === "google" ? 0 : -1}
              data-place={place}
            >
              {copy.places[place].label}
            </button>
          ))}
        </div>
        {places.map((place) => (
          <div
            class="mt-5"
            role="tabpanel"
            id={`${id}-panel-${place}`}
            aria-labelledby={`${id}-tab-${place}`}
            hidden={place !== "google"}
            data-panel={place}
          >
            <div class="result" aria-hidden="true">
              {place === "google" && (
                <div class="result-google">
                  <span class="result-site">
                    <i>M</i>
                    <span class="min-w-0">
                      <b>Mustermann Bäder</b>
                      <small>mustermann-baeder.de › badsanierung-hofheim</small>
                    </span>
                  </span>
                  <span class="result-link">{copy.seoTitle}</span>
                  <span class="result-text">{copy.seoDescription}</span>
                </div>
              )}
              {place === "maps" && (
                <div class="result-maps">
                  <div class="map">
                    <span class="map-pin">
                      <MapPin class="size-4" stroke-width={2.2} />
                    </span>
                  </div>
                  <div class="p-4">
                    <b class="block text-[14px]">Mustermann Bäder</b>
                    <small class="block">{copy.mapsCategory}</small>
                    <small class="map-open block">{copy.mapsOpen}</small>
                    <span class="map-actions">
                      {copy.mapsActions.map((action, index) => {
                        const Icon = actionIcons[index]!;
                        return (
                          <span>
                            <Icon class="size-3.5" stroke-width={2} />
                            {action}
                          </span>
                        );
                      })}
                    </span>
                    <small class="mt-3 block">{copy.address}</small>
                  </div>
                </div>
              )}
              {place === "ai" && (
                <div class="result-ai">
                  <span class="ai-question">{copy.aiQuestion}</span>
                  <span class="ai-answer">
                    <Sparkles class="size-4 shrink-0 text-service-search-fg" stroke-width={2} />
                    <span class="min-w-0">
                      {copy.aiAnswer}
                      <span class="ai-source">mustermann-baeder.de</span>
                    </span>
                  </span>
                </div>
              )}
            </div>
            <p class="mt-5 mb-0 text-base/6 text-muted">{copy.places[place].explain}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Tabs follow the ARIA tabs pattern; the active place also marks the matching part of the page.
  document.querySelectorAll<HTMLElement>("[data-search-sources]").forEach((stage) => {
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      const place = tab.dataset.place!;
      stage.dataset.active = place;
      tabs.forEach((other) => {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
      });
      stage.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.panel !== place;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        event.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length]!, true);
      });
    });
  });
</script>

<style>
  .source-page,
  .result {
    border-radius: 1.25rem;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 5%),
      0 18px 40px -24px rgb(38 115 77 / 45%);
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .source-page {
    display: grid;
    gap: 0.625rem;
    align-content: start;
    padding: 0.75rem 0.875rem 1rem;
  }
  .source-bar {
    justify-self: center;
    max-width: 100%;
    overflow: hidden;
    border-radius: 999px;
    background: #f1f2f4;
    padding: 4px 12px;
    color: #6b7280;
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .source-part {
    display: grid;
    gap: 2px;
    border-radius: 12px;
    padding: 0.625rem 0.75rem;
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      box-shadow 250ms var(--ease-out),
      background-color 250ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }
  .source-part small {
    color: var(--color-subtle);
    font-size: 11px;
  }
  .source-part b {
    font-weight: 600;
  }
  .source-seo-title {
    color: #1a0dab;
    font-weight: 500 !important;
  }
  .source-content {
    padding: 0.5rem 0.75rem;
    transition: opacity 250ms var(--ease-out);
  }
  .source-title {
    margin: 0;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .source-copy {
    margin: 4px 0 0;
    color: var(--color-muted);
  }
  /* The active place marks its part of the page and fades the rest. */
  [data-active] .source-part,
  [data-active] .source-content {
    opacity: 0.42;
  }
  [data-active="google"] [data-source="google"],
  [data-active="maps"] [data-source="maps"],
  [data-active="ai"] [data-source="ai"] {
    opacity: 1;
    background: #f3fbf6;
    box-shadow: inset 0 0 0 2px var(--color-service-search-fg);
  }

  .sources-tabs {
    display: flex;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    border-radius: 999px;
    background: rgb(255 255 255 / 70%);
    padding: 4px;
    box-shadow: inset 0 0 0 1px rgb(38 115 77 / 14%);
  }
  .sources-tabs button {
    border-radius: 999px;
    padding: 0.5rem 0.875rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  @media (max-width: 37.5rem) {
    .sources-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      border-radius: 1.25rem;
    }
    .sources-tabs button {
      border-radius: 1rem;
      padding: 0.5rem 0.375rem;
      line-height: 1.25;
      white-space: normal;
    }
  }
  .sources-tabs button:hover {
    color: var(--color-ink);
  }
  .sources-tabs button[aria-selected="true"] {
    background: var(--color-service-search-fg);
    color: white;
  }
  [role="tabpanel"]:not([hidden]) .result {
    animation: result-in 320ms var(--ease-out);
  }
  @keyframes result-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .result small {
    color: var(--color-subtle);
    font-size: 11.5px;
  }
  .result-google {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    padding: 1.125rem 1.25rem 1.25rem;
  }
  .result-site {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .result-site i {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #eaf2ff;
    color: #245bb8;
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
  }
  .result-site b,
  .result-site small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .result-link {
    margin-top: 6px;
    color: #1a0dab;
    font-size: 17px;
    line-height: 1.3;
  }
  .result-text {
    color: #4d5156;
  }
  .result-maps {
    overflow: hidden;
    border-radius: inherit;
  }
  .map {
    position: relative;
    height: 7.5rem;
    background:
      linear-gradient(28deg, transparent 47%, white 47%, white 53%, transparent 53%),
      linear-gradient(118deg, transparent 62%, white 62%, white 66%, transparent 66%),
      linear-gradient(90deg, transparent 30%, #fff 30%, #fff 33%, transparent 33%),
      radial-gradient(circle at 78% 30%, #cfe8d6 0 18%, transparent 19%), #ecebe4;
  }
  .map-pin {
    position: absolute;
    top: 38%;
    left: 48%;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50% 50% 50% 0;
    background: #d93025;
    color: white;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .map-pin :global(svg) {
    transform: rotate(45deg);
  }
  .map-open {
    color: #26734d !important;
  }
  .map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0.75rem;
  }
  .map-actions span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 999px;
    padding: 5px 10px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: #1a5fb4;
    font-size: 11.5px;
    font-weight: 600;
  }
  .result-ai {
    display: grid;
    gap: 0.75rem;
    padding: 1.125rem;
  }
  .ai-question {
    justify-self: end;
    max-width: 85%;
    border-radius: 16px 16px 4px 16px;
    background: var(--color-neutral-100);
    padding: 0.5rem 0.75rem;
  }
  .ai-answer {
    display: flex;
    gap: 0.625rem;
    font-size: 13.5px;
  }
  .ai-source {
    display: inline-block;
    margin-left: 4px;
    border-radius: 999px;
    background: #e9f7ef;
    padding: 1px 8px;
    color: #26734d;
    font-size: 11px;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    [role="tabpanel"]:not([hidden]) .result {
      animation: none;
    }
  }
</style>
