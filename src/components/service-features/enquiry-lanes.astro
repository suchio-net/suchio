---
import { Bot, UsersRound } from "@lucide/astro";
import SectionHeading from "@/components/section-heading.astro";
import type { EnquiryLanesCopy } from "@/i18n/service-features";

interface Props {
  copy: EnquiryLanesCopy;
}
const { copy } = Astro.props;
const laneIcons = { auto: Bot, team: UsersRound } as const;
const laneRows = { auto: 2, team: 3 } as const;
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[70rem]">
    <SectionHeading title={copy.heading} copy={copy.copy} />
    <div class="lanes" style={{ "--steps": copy.steps.length }} data-reveal data-reveal-threshold="half">
      {(["auto", "team"] as const).map((lane) => {
        const Icon = laneIcons[lane];
        return (
          <div class={`lane-band lane-band--${lane}`} style={{ "--row": laneRows[lane] }} aria-hidden="true">
            <span class="lane-name">
              <Icon class="size-4 shrink-0" stroke-width={2} />
              {copy.lanes[lane]}
            </span>
          </div>
        );
      })}
      <span class="lanes-axis" aria-hidden="true">
        <i></i>
      </span>
      {copy.steps.map((step, index) => (
        <span class="lane-time" style={{ "--col": index + 2, "--step": index }} aria-hidden="true">
          {step.time}
        </span>
      ))}
      <ol class="lanes-steps">
        {copy.steps.map((step, index) => {
          const Icon = laneIcons[step.lane];
          return (
            <li
              class={`lane-step lane-step--${step.lane}`}
              style={{ "--col": index + 2, "--row": laneRows[step.lane], "--step": index }}
            >
              <span class="lane-step-meta">
                <Icon class="size-3.5 shrink-0" stroke-width={2} aria-hidden="true" />
                <span class="sr-only">{copy.lanes[step.lane]}, </span>
                <span>{step.time}</span>
              </span>
              {step.items.map((item) => (
                <span class="lane-item">
                  <b>{item.title}</b>
                  <small>{item.detail}</small>
                </span>
              ))}
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Desktop: a swimlane chart, time runs left to right. Phone: one list in time order. */
  .lanes {
    --lane-auto: #f2edff;
    --step-delay: 600ms;
    display: grid;
    grid-template-columns: 8.5rem repeat(var(--steps), minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    column-gap: 0.75rem;
    overflow: hidden;
    border-radius: 1.75rem;
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 1.5rem 1.25rem 1.25rem;
  }
  .lane-band {
    grid-row: var(--row);
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    margin: 0 -1.25rem;
    padding: 0 1.25rem;
    min-height: 9rem;
  }
  .lane-band--auto {
    background: var(--lane-auto);
  }
  .lane-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 8.5rem;
    font-size: var(--text-meta);
    font-weight: 600;
  }
  .lane-band--auto .lane-name {
    color: var(--color-service-automation-fg);
  }
  .lanes-axis {
    grid-row: 1;
    grid-column: 2 / -1;
    align-self: end;
    height: 2px;
    margin-bottom: 0.75rem;
    border-radius: 2px;
    background: var(--color-line-strong);
  }
  .lanes-axis i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-service-automation-fg);
  }
  .lane-time {
    grid-row: 1;
    grid-column: var(--col);
    padding-bottom: 1.5rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }
  .lanes-steps {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lane-step {
    grid-row: var(--row);
    grid-column: var(--col);
    z-index: 1;
    display: grid;
    align-content: start;
    gap: 0.625rem;
    align-self: center;
    margin: 0.875rem 0;
    border-radius: 14px;
    background: var(--color-surface);
    padding: 0.75rem 0.875rem;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 6%),
      0 12px 26px -16px rgb(0 0 0 / 28%);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .lane-step-meta {
    display: none;
  }
  .lane-item {
    display: grid;
    gap: 2px;
  }
  .lane-item b {
    font-weight: 600;
  }
  .lane-item small {
    color: var(--color-muted);
    font-size: 12px;
  }

  /* One sequence: the time line runs once, and each step appears as the line reaches it. */
  .lanes.is-reveal-armed .lane-step,
  .lanes.is-reveal-armed .lane-time {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: calc(var(--step) * var(--step-delay) + 120ms);
  }
  .lanes.is-reveal-armed .lanes-axis i {
    width: 0;
    transition: width calc(var(--steps) * var(--step-delay)) linear;
  }
  .lanes.is-visible .lane-step,
  .lanes.is-visible .lane-time {
    opacity: 1;
    transform: none;
  }
  .lanes.is-visible .lanes-axis i {
    width: 100%;
  }

  @media (max-width: 56.25rem) {
    .lanes {
      display: block;
      padding: 1rem;
    }
    .lane-band,
    .lanes-axis,
    .lane-time {
      display: none;
    }
    .lanes-steps {
      position: relative;
      display: grid;
      gap: 0.75rem;
    }
    .lane-step {
      grid-row: auto;
      grid-column: auto;
      margin: 0;
    }
    .lane-step--auto {
      background: var(--lane-auto);
      box-shadow: none;
    }
    .lane-step-meta {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--color-muted);
      font-size: 12px;
    }
    .lane-step--auto .lane-step-meta {
      color: var(--color-service-automation-fg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lanes .lane-step,
    .lanes .lane-time,
    .lanes .lanes-axis i {
      transition: none !important;
    }
  }
</style>
