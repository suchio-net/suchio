---
import { Check, Menu } from "@lucide/astro";
import SectionHeading from "@/components/section-heading.astro";
import type { SiteEditorCopy } from "@/i18n/service-features";

interface Props {
  copy: SiteEditorCopy;
}
const { copy } = Astro.props;
const id = "site-editor";
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[70rem]">
    <SectionHeading title={copy.heading} copy={copy.copy} />
    <div
      class="editor-stage grid grid-cols-[minmax(0,25rem)_minmax(0,1fr)] items-center gap-10 rounded-[1.75rem] bg-service-websites-bg p-12 max-compact:grid-cols-1 max-compact:gap-8 max-compact:p-5"
      data-site-editor
    >
      <form class="editor-panel min-w-0" data-editor-form>
        <div class="flex items-center justify-between gap-4">
          <h3 class="m-0 text-ui font-semibold">{copy.panelTitle}</h3>
          <span class="editor-status" data-editor-status data-state="live">
            <span data-label-live>{copy.live}</span>
            <span data-label-draft hidden>
              {copy.draft}
            </span>
          </span>
        </div>
        <label class="editor-field" for={`${id}-headline`}>
          <span>{copy.headlineLabel}</span>
          <input
            id={`${id}-headline`}
            name="headline"
            type="text"
            maxlength="52"
            autocomplete="off"
            value={copy.headlineDefault}
            data-bind="headline"
          />
        </label>
        <label class="editor-field" for={`${id}-hours`}>
          <span>{copy.hoursLabel}</span>
          <input
            id={`${id}-hours`}
            name="hours"
            type="text"
            maxlength="28"
            autocomplete="off"
            value={copy.hoursDefault}
            data-bind="hours"
          />
        </label>
        <label class="editor-toggle" for={`${id}-notice`}>
          <input id={`${id}-notice`} name="notice" type="checkbox" class="peer sr-only" data-bind="notice" />
          <span class="editor-switch" aria-hidden="true"></span>
          <span class="min-w-0">
            <span class="block">{copy.noticeLabel}</span>
            <small class="block text-subtle">{copy.noticeText}</small>
          </span>
        </label>
        <button
          type="submit"
          class="pill-button pill-button--dark mt-6 inline-flex min-h-[46px] items-center gap-2 rounded-pill bg-inverse-surface px-5 text-ui font-semibold text-white shadow-dark-surface disabled:cursor-default"
          data-editor-publish
          disabled
        >
          <Check class="size-4" stroke-width={2.2} aria-hidden="true" data-published-icon />
          <span data-label-published>{copy.published}</span>
          <span data-label-publish hidden>
            {copy.publish}
          </span>
        </button>
        <p class="sr-only" aria-live="polite" data-editor-announce></p>
      </form>

      <div class="grid min-w-0 place-items-center">
        <div class="phone" aria-hidden="true">
          <div class="phone-screen" data-phone>
            <div class="phone-bar">mustermann-baeder.de</div>
            <div class="phone-notice" data-preview="notice" hidden>
              {copy.noticeText}
            </div>
            <div class="phone-nav">
              <span class="phone-brand">
                <i></i>Mustermann Bäder
              </span>
              <Menu class="size-4" stroke-width={2} />
            </div>
            <div class="phone-body">
              <p class="phone-title" data-preview="headline">
                {copy.headlineDefault}
              </p>
              <p class="phone-copy">{copy.pageCopy}</p>
              <span class="phone-cta">{copy.pageCta}</span>
              <div class="phone-photo" role="img" aria-label={copy.photoAlt}></div>
              <p class="phone-hours">
                <b>{copy.hoursPrefix}</b>
                <span data-preview="hours">{copy.hoursDefault}</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typing updates the phone at once, like a CMS preview. "Publish" marks the draft as live.
  document.querySelectorAll<HTMLElement>("[data-site-editor]").forEach((editor) => {
    const form = editor.querySelector<HTMLFormElement>("[data-editor-form]")!;
    const publish = editor.querySelector<HTMLButtonElement>("[data-editor-publish]")!;
    const status = editor.querySelector<HTMLElement>("[data-editor-status]")!;
    const announce = editor.querySelector<HTMLElement>("[data-editor-announce]")!;
    const phone = editor.querySelector<HTMLElement>("[data-phone]")!;
    const preview = (name: string) => editor.querySelector<HTMLElement>(`[data-preview="${name}"]`)!;
    const toggle = (selector: string, show: boolean) =>
      // The check icon is an SVG element, which has no `hidden` property, so set the attribute.
      editor.querySelectorAll(selector).forEach((element) => element.toggleAttribute("hidden", !show));

    const setLive = (live: boolean) => {
      status.dataset.state = live ? "live" : "draft";
      toggle("[data-label-live], [data-label-published], [data-published-icon]", live);
      toggle("[data-label-draft], [data-label-publish]", !live);
      publish.disabled = live;
    };

    form.addEventListener("input", (event) => {
      const field = event.target as HTMLInputElement;
      const name = field.dataset.bind;
      if (name === "notice") preview("notice").hidden = !field.checked;
      else if (name) preview(name).textContent = field.value.trim() || field.defaultValue;
      setLive(false);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      setLive(true);
      announce.textContent = publish.querySelector("[data-label-published]")!.textContent ?? "";
      phone.classList.remove("is-published");
      void phone.offsetWidth;
      phone.classList.add("is-published");
    });
  });
</script>

<style>
  .editor-panel {
    border-radius: 1.25rem;
    background: var(--color-surface);
    padding: 1.5rem;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 5%),
      0 18px 40px -24px rgb(36 91 184 / 45%);
  }
  .editor-status {
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .editor-status[data-state="live"] {
    background: #e9f7ef;
    color: #26734d;
  }
  .editor-status[data-state="draft"] {
    background: var(--color-neutral-100);
    color: var(--color-muted);
  }
  .editor-field {
    display: grid;
    gap: 6px;
    margin-top: 1.25rem;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .editor-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    border-radius: 10px;
    background: var(--color-surface-subtle);
    padding: 0.625rem 0.75rem;
    box-shadow: var(--shadow-surface);
    color: var(--color-ink);
    font-size: 1rem;
    transition:
      background-color 150ms var(--ease-out),
      box-shadow 150ms var(--ease-out);
  }
  .editor-field input:hover {
    background: var(--color-surface);
    box-shadow: var(--shadow-surface-hover);
  }
  .editor-field input:focus-visible {
    background: var(--color-surface);
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .editor-toggle {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.25rem;
    cursor: pointer;
    font-size: var(--text-meta);
  }
  .editor-switch {
    position: relative;
    flex: none;
    width: 38px;
    height: 22px;
    margin-top: 1px;
    border-radius: 999px;
    background: var(--color-neutral-300, #d4d4d4);
    transition: background-color 200ms var(--ease-out);
  }
  .editor-switch::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
    transition: transform 200ms var(--ease-out);
  }
  .editor-toggle input:checked + .editor-switch {
    background: var(--color-service-websites-fg);
  }
  .editor-toggle input:checked + .editor-switch::after {
    transform: translateX(16px);
  }
  .editor-toggle input:focus-visible + .editor-switch {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .phone {
    width: min(100%, 17.5rem);
    border-radius: 2.5rem;
    background: #1d1d1f;
    padding: 9px;
    box-shadow: 0 30px 60px -30px rgb(20 40 80 / 55%);
  }
  .phone-screen {
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    overflow: hidden;
    border-radius: 2rem;
    background: white;
    color: #1b2430;
    font-size: 12px;
    line-height: 1.4;
  }
  .phone-screen.is-published {
    animation: published 900ms var(--ease-out);
  }
  @keyframes published {
    0% {
      box-shadow: inset 0 0 0 0 rgb(38 115 77 / 0%);
    }
    30% {
      box-shadow: inset 0 0 0 3px rgb(38 115 77 / 55%);
    }
    100% {
      box-shadow: inset 0 0 0 0 rgb(38 115 77 / 0%);
    }
  }
  .phone-bar {
    margin: 10px auto 6px;
    border-radius: 999px;
    background: #f1f2f4;
    padding: 4px 12px;
    color: #6b7280;
    font-size: 10.5px;
  }
  .phone-notice {
    background: #245bb8;
    padding: 7px 14px;
    color: white;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
  }
  .phone-notice:not([hidden]) {
    animation: notice-in 300ms var(--ease-out);
  }
  @keyframes notice-in {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
  }
  .phone-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
  }
  .phone-brand {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
  }
  .phone-brand i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: #245bb8;
  }
  .phone-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 10px 16px 18px;
  }
  .phone-title {
    margin: 0;
    font-size: 22px;
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .phone-copy {
    margin: 10px 0 0;
    color: #5b6472;
  }
  .phone-cta {
    align-self: flex-start;
    margin-top: 14px;
    border-radius: 999px;
    background: #1b2430;
    padding: 8px 14px;
    color: white;
    font-weight: 600;
  }
  .phone-photo {
    flex: 1;
    min-height: 8rem;
    margin-top: 16px;
    border-radius: 14px;
    /* A tiled wall in light: grout lines over a soft gradient. */
    background:
      linear-gradient(90deg, rgb(255 255 255 / 70%) 1.5px, transparent 1.5px) 0 0 / 22px 22px,
      linear-gradient(rgb(255 255 255 / 70%) 1.5px, transparent 1.5px) 0 0 / 22px 22px,
      linear-gradient(140deg, #cfe0f7, #9fbde6 55%, #7fa3d6);
  }
  .phone-hours {
    margin: 12px 0 0;
    color: #5b6472;
    overflow-wrap: anywhere;
  }
  .phone-hours b {
    margin-right: 6px;
    color: #1b2430;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone-screen.is-published,
    .phone-notice:not([hidden]) {
      animation: none;
    }
  }
</style>
