---
import SectionHeading from "@/components/section-heading.astro";
import type { AdCalculatorCopy } from "@/i18n/service-features";
import type { Locale } from "@/lib/i18n";
import { calculateAd, formatAd, adInputs, betterPoints } from "./ad-math";

interface Props {
  copy: AdCalculatorCopy;
  locale: Locale;
}
const { copy, locale } = Astro.props;
const id = "ad-calculator";
const defaults = { budget: adInputs.budget.value, cpc: adInputs.cpc.value, rate: adInputs.rate.value };
const result = calculateAd(defaults);
const text = formatAd(locale, defaults, result);
const better = copy.better.replace("{points}", String(betterPoints));
const sliders = [
  { name: "budget", label: copy.budget, ...adInputs.budget, shown: text.budget },
  { name: "cpc", label: copy.cpc, ...adInputs.cpc, shown: text.cpc },
  { name: "rate", label: copy.rate, ...adInputs.rate, shown: text.rate },
] as const;
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[70rem]">
    <SectionHeading title={copy.heading} copy={copy.copy} />
    <div
      class="grid grid-cols-[minmax(0,24rem)_minmax(0,1fr)] gap-10 rounded-[1.75rem] bg-service-campaigns-bg p-12 max-compact:grid-cols-1 max-compact:gap-6 max-compact:p-5"
      data-ad-calculator
      data-locale={locale}
    >
      <form class="calc-panel grid content-start gap-7 self-start p-6" data-calc-form>
        {sliders.map((slider) => (
          <label class="grid gap-3" for={`${id}-${slider.name}`}>
            <span class="flex items-baseline justify-between gap-4 text-meta text-muted">
              {slider.label}
              <output
                class="text-ui font-semibold text-ink tabular-nums"
                for={`${id}-${slider.name}`}
                data-out={slider.name}
              >
                {slider.shown}
              </output>
            </span>
            <input
              id={`${id}-${slider.name}`}
              name={slider.name}
              type="range"
              min={slider.min}
              max={slider.max}
              step={slider.step}
              value={slider.value}
              aria-valuetext={slider.shown}
            />
          </label>
        ))}
      </form>

      <div class="min-w-0">
        <div class="calc-panel p-6">
          <p class="calc-row">
            <span data-out="budget">{text.budget}</span>
            <span class="calc-op" aria-hidden="true">
              ÷
            </span>
            <span data-out="cpc">{text.cpc}</span>
            <span class="calc-op" aria-hidden="true">
              =
            </span>
            <span>
              <b data-out="clicks">{text.clicks}</b> {copy.clicks}
            </span>
          </p>
          <p class="calc-row">
            <span>
              <span data-out="clicks">{text.clicks}</span> {copy.clicks}
            </span>
            <span class="calc-op" aria-hidden="true">
              ×
            </span>
            <span data-out="rate">{text.rate}</span>
            <span class="calc-op" aria-hidden="true">
              =
            </span>
            <span>
              <b data-out="enquiries">{text.enquiries}</b> {copy.enquiries}
            </span>
          </p>
          <p class="calc-row calc-row--total" aria-live="polite">
            <span data-out="budget">{text.budget}</span>
            <span class="calc-op" aria-hidden="true">
              ÷
            </span>
            <span data-out="enquiries">{text.enquiries}</span>
            <span class="calc-op" aria-hidden="true">
              =
            </span>
            <span>
              <b data-out="cost" data-empty={copy.noEnquiry}>
                {text.cost ?? copy.noEnquiry}
              </b>
              <span class="ml-1.5" data-per hidden={!text.cost}>
                {copy.perEnquiry}
              </span>
            </span>
          </p>
        </div>

        <div class="mt-4 grid gap-3 px-1" aria-label={copy.compareHeading} role="group">
          <div class="calc-bar">
            <span class="flex justify-between gap-4 text-meta">
              <span class="text-muted">{copy.today}</span>
              <b class="tabular-nums" data-out="cost" data-empty={copy.noEnquiry}>
                {text.cost ?? copy.noEnquiry}
              </b>
            </span>
            <span class="calc-track">
              <i style={{ width: "100%" }} data-bar="today"></i>
            </span>
          </div>
          <div class="calc-bar">
            <span class="flex justify-between gap-4 text-meta">
              <span class="text-muted">{better}</span>
              <b class="tabular-nums" data-out="betterCost" data-empty={copy.noEnquiry}>
                {text.betterCost ?? copy.noEnquiry}
              </b>
            </span>
            <span class="calc-track">
              <i class="calc-better" style={{ width: `${result.betterShare * 100}%` }} data-bar="better"></i>
            </span>
          </div>
        </div>
        <p class="mt-5 mb-0 px-1 text-meta text-muted">{copy.note}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Locale } from "@/lib/i18n";
  import { calculateAd, formatAd } from "./ad-math";

  document.querySelectorAll<HTMLElement>("[data-ad-calculator]").forEach((calculator) => {
    const form = calculator.querySelector<HTMLFormElement>("[data-calc-form]")!;
    const locale = calculator.dataset.locale as Locale;
    const update = () => {
      const data = new FormData(form);
      const inputs = { budget: +data.get("budget")!, cpc: +data.get("cpc")!, rate: +data.get("rate")! };
      const result = calculateAd(inputs);
      const text = formatAd(locale, inputs, result);
      calculator.querySelectorAll<HTMLElement>("[data-out]").forEach((element) => {
        const key = element.dataset.out as keyof typeof text;
        element.textContent = text[key] ?? element.dataset.empty ?? "";
      });
      calculator.querySelectorAll<HTMLElement>("[data-per]").forEach((element) => (element.hidden = !text.cost));
      form.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
        input.setAttribute("aria-valuetext", text[input.name as "budget" | "cpc" | "rate"]);
      });
      calculator.querySelector<HTMLElement>("[data-bar=better]")!.style.width = `${result.betterShare * 100}%`;
    };
    form.addEventListener("input", update);
  });
</script>

<style>
  .calc-panel {
    border-radius: 1.25rem;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 5%),
      0 18px 40px -24px rgb(145 96 10 / 45%);
  }
  input[type="range"] {
    width: 100%;
    accent-color: var(--color-service-campaigns-fg);
    cursor: pointer;
  }
  .calc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin: 0;
    padding: 0.875rem 0;
    color: var(--color-muted);
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }
  .calc-row:first-child {
    padding-top: 0;
  }
  .calc-row b {
    color: var(--color-ink);
    font-weight: 600;
  }
  .calc-op {
    color: var(--color-subtle);
  }
  .calc-row--total {
    margin-top: 0.375rem;
    border-radius: 12px;
    background: #fff8e8;
    padding: 0.875rem 1rem;
    color: var(--color-ink);
  }
  .calc-row--total b {
    color: var(--color-service-campaigns-fg);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  .calc-bar {
    display: grid;
    gap: 6px;
  }
  .calc-track {
    display: block;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(145 96 10 / 12%);
  }
  .calc-track i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #d9a441;
    transition: width 300ms var(--ease-out);
  }
  .calc-track .calc-better {
    background: var(--color-service-campaigns-fg);
  }
  @media (prefers-reduced-motion: reduce) {
    .calc-track i {
      transition: none;
    }
  }
</style>
