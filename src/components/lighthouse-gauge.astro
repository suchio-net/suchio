---
// A Lighthouse score ring in Lighthouse's colours: red below 50, orange below 90, green from 90.
// With `before`, a thinner inner ring shows the earlier score. The ring fills once when its
// revealed parent becomes visible; the figures stay readable without the animation.
interface Props {
  score: number;
  before?: number;
  label: string;
  beforeLabel?: string;
  tone?: "dark" | "light";
  size?: "lg" | "sm";
}
const { score, before, label, beforeLabel, tone = "dark", size = "lg" } = Astro.props;
const rating = (value: number) => (value >= 90 ? "pass" : value >= 50 ? "average" : "fail");
---

<figure class={`lh-gauge lh-gauge--${tone} lh-gauge--${size} m-0`}>
  <div class="lh-gauge__ring">
    <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <circle class="lh-gauge__track" cx="60" cy="60" r="52" />
      <circle
        class={`lh-gauge__arc lh-${rating(score)}`}
        cx="60"
        cy="60"
        r="52"
        pathLength="100"
        style={{ "--lh-value": score }}
      />
      {before !== undefined && (
        <>
          <circle class="lh-gauge__track lh-gauge__track--inner" cx="60" cy="60" r="44" />
          <circle
            class={`lh-gauge__arc lh-gauge__arc--inner lh-${rating(before)}`}
            cx="60"
            cy="60"
            r="44"
            pathLength="100"
            style={{ "--lh-value": before }}
          />
        </>
      )}
    </svg>
    <span class={`lh-gauge__score lh-text-${rating(score)}`}>{score}</span>
  </div>
  <figcaption class="lh-gauge__caption">
    <span class="lh-gauge__label">{label}</span>
    {before !== undefined && beforeLabel && (
      <span class="lh-gauge__before">
        <span class={`lh-gauge__dot lh-${rating(before)}`} aria-hidden="true" />
        {beforeLabel} {before}
      </span>
    )}
  </figcaption>
</figure>

<style>
  .lh-gauge {
    --lh-pass: #0cce6b;
    --lh-average: #ffa400;
    --lh-fail: #ff4e42;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .lh-gauge--light {
    /* Lighthouse's darker text colours keep the figures readable on a light background. */
    --lh-text-pass: #080;
    --lh-text-average: #c33300;
    --lh-text-fail: #c00;
    --lh-track: rgb(0 0 0 / 8%);
  }
  .lh-gauge--dark {
    --lh-text-pass: var(--lh-pass);
    --lh-text-average: var(--lh-average);
    --lh-text-fail: var(--lh-fail);
    --lh-track: rgb(255 255 255 / 12%);
  }
  .lh-gauge__ring {
    position: relative;
    width: var(--lh-size);
    aspect-ratio: 1;
  }
  .lh-gauge--lg {
    --lh-size: clamp(6.5rem, 22vw, 9.5rem);
  }
  .lh-gauge--sm {
    --lh-size: 4.25rem;
  }
  .lh-gauge svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .lh-gauge circle {
    fill: none;
  }
  .lh-gauge__track {
    stroke: var(--lh-track);
    stroke-width: 8;
  }
  .lh-gauge__track--inner,
  .lh-gauge__arc--inner {
    stroke-width: 4;
  }
  .lh-gauge__arc {
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: var(--lh-value) 100;
  }
  .lh-pass {
    stroke: var(--lh-pass);
    background: var(--lh-pass);
  }
  .lh-average {
    stroke: var(--lh-average);
    background: var(--lh-average);
  }
  .lh-fail {
    stroke: var(--lh-fail);
    background: var(--lh-fail);
  }
  .lh-gauge__score {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: calc(var(--lh-size) * 0.26);
    font-weight: 500;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .lh-text-pass {
    color: var(--lh-text-pass);
  }
  .lh-text-average {
    color: var(--lh-text-average);
  }
  .lh-text-fail {
    color: var(--lh-text-fail);
  }
  .lh-gauge__caption {
    display: grid;
    gap: 0.25rem;
  }
  .lh-gauge__label {
    font-size: 1rem;
    font-weight: 500;
  }
  .lh-gauge--sm .lh-gauge__label {
    font-size: var(--text-meta);
    font-weight: 400;
  }
  .lh-gauge__before {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: var(--text-meta);
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .lh-gauge__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
  }

  /* One fill when the band scrolls into view. */
  :global(.reveal-ready) :global([data-reveal]:not(.is-visible)) .lh-gauge__arc {
    stroke-dasharray: 0 100;
  }
  :global(.reveal-ready) :global([data-reveal].is-reveal-armed) .lh-gauge__arc {
    transition: stroke-dasharray 1100ms cubic-bezier(0.16, 1, 0.3, 1) 150ms;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.reveal-ready) :global([data-reveal]) .lh-gauge__arc {
      stroke-dasharray: var(--lh-value) 100;
      transition: none;
    }
  }
</style>
