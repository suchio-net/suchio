---
import CtaButton from "@/components/cta-button.astro";
import Reveal from "@/components/reveal.astro";
import WhatsAppButton from "@/components/whatsapp-button.astro";
import type { ServicesCopy } from "@/i18n/services";
import { publicContactEmail, publicContactPhone, publicContactPhoneHref } from "@/lib/contact";
import type { Locale } from "@/lib/i18n";

interface Props {
  copy: ServicesCopy["contact"];
  title: string;
  text: string;
  cta: string;
  href: string;
  locale: Locale;
}
const { copy, title, text, cta, href, locale } = Astro.props;

const linkClass =
  "text-white underline decoration-white/30 underline-offset-4 transition-[text-decoration-color] hover:decoration-white";
---

<section class="bg-black px-page py-section text-inverse">
  <div class="mx-auto grid max-w-[75rem] grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] items-center gap-20 max-nav:grid-cols-1 max-nav:gap-12">
    <Reveal className="min-w-0">
      <h2 class="m-0 max-w-[18ch] text-display-sm text-white">{title}</h2>
      <p class="mt-6 mb-7 max-w-[35rem] text-lg/7 text-inverse-muted">{text}</p>
      <div class="flex gap-3">
        <CtaButton href={href} light>
          {cta}
        </CtaButton>
        <WhatsAppButton locale={locale} />
      </div>
    </Reveal>
    <Reveal className="min-w-0" delay={70}>
      <h3 class="m-0 text-heading-sm text-white">{copy.heading}</h3>
      <p class="mt-2 mb-0 text-base/6 text-inverse-muted">{copy.text}</p>
      <p class="mt-6 mb-0 flex flex-wrap gap-x-6 gap-y-2 text-base">
        <a class={linkClass} href={`mailto:${publicContactEmail}`}>
          {publicContactEmail}
        </a>
        <a class={linkClass} href={publicContactPhoneHref}>
          {publicContactPhone}
        </a>
      </p>
    </Reveal>
  </div>
</section>
