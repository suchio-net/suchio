---
import { ArrowRight, CalendarDays, Check, FileText, Lock, PencilLine, Upload, Volume2 } from "@lucide/astro";

interface Props {
  id: string;
}
const { id } = Astro.props;

// German demo text for the website rows. Every card shows a real-looking piece of the product the row
// describes; the page structure and the phone screenshot come from our Wendmark Sanierung concept.
const text = {
  structure: "Seitenstruktur",
  pages: [
    { name: "Startseite" },
    {
      name: "Leistungen",
      children: ["Badsanierung", "Sanitär & Heizung", "Elektro", "Fliesen", "Renovierung"],
    },
    { name: "Gebäudebetreuung" },
    { name: "Referenzen" },
    { name: "Kontakt" },
  ],
  sponsored: "Gesponsert",
  adDomain: "mustermann-baeder.de › badsanierung",
  adTitle: "Badsanierung in Hofheim, fertig in drei Wochen",
  adText: "Planung, Fliesen und Sanitär aus einem Betrieb. Jetzt Termin vereinbaren.",
  landingTitle: "Ihr neues Bad in Hofheim",
  landingFields: ["Badsanierung", "65719 Hofheim"],
  landingSubmit: "Anfrage senden",
  campaign: "Diese Kampagne, Beispielwerte",
  metrics: [
    ["Besucher", "412"],
    ["Anfragen", "14"],
    ["Quote", "3,4 %"],
  ],
  cart: "Warenkorb",
  cartCount: "2 Artikel",
  products: [
    { name: "Duscharmatur Linea", variant: "Chrom", price: "189,00 €", image: "dusche-armatur" },
    { name: "Waschtisch Vela", variant: "Eiche, 80 cm", price: "349,00 €", image: "bad-waschtisch" },
  ],
  subtotal: ["Zwischensumme", "538,00 €"],
  shipping: ["Versand", "kostenlos"],
  total: ["Gesamt", "538,00 €"],
  payments: ["PayPal", "Kreditkarte", "Klarna", "Apple Pay"],
  checkout: "Zur Kasse",
  orderSynced: "Bestellung 2041",
  orderSyncedText: "an Warenwirtschaft übertragen",
  portal: "Kundenportal",
  customer: "Anna Schmidt",
  order: "Auftrag 1042",
  orderTitle: "Badsanierung, Hofheim",
  steps: ["Planung", "Rückbau", "Fliesen", "Abnahme"],
  nextAppointment: "Nächster Termin",
  appointment: "Do., 12. Nov., 8:00 Uhr",
  appointmentText: "Fliesenleger vor Ort",
  documents: "Dokumente",
  files: [
    ["Angebot_1042.pdf", "84 KB"],
    ["Grundriss_Bad.pdf", "1,2 MB"],
  ],
  upload: "Fotos hochladen",
  redirects: "Weiterleitungen",
  redirectRows: [
    ["/leistungen.php?id=3", "/leistungen/badsanierung"],
    ["/bad-sanierung.html", "/leistungen/badsanierung"],
    ["/ueber-uns.html", "/referenzen"],
    ["/kontakt.php", "/kontakt"],
  ],
  redirectsDone: "Alle alten Adressen erreichbar",
  console: "Google Search Console",
  indexed: "32",
  indexedOf: "von 33 Seiten indexiert",
  consoleNote: "Handwerker.work, Ende Oktober 2026",
  emailLabel: "E-Mail-Adresse",
  emailValue: "anna.schmidt@",
  required: "Pflichtfeld",
  tabKey: "Tab",
  tabHint: "führt zum nächsten Feld",
  reader: "Screenreader",
  readerText: "Eingabefeld, E-Mail-Adresse, Pflichtfeld",
  contrast: "Kontrast",
  contrastValue: "15,8 : 1",
  contrastLevel: "AAA",
  hours: "Öffnungszeiten",
  hoursValue: "Mo–Fr 7–18 Uhr, Sa 9–13 Uhr",
  publish: "Veröffentlichen",
  edited: "Von Ihnen geändert, heute 09:12",
  operations: "Betrieb",
  status: [
    ["Sicherung", "heute, 03:00"],
    ["Updates", "aktuell"],
    ["SSL-Zertifikat", "gültig"],
  ],
};
---

<div class="visual" aria-hidden="true">
  {id === "business-websites" && (
    <div class="flex items-center justify-center">
      <div class="phone w-[11.5rem] shrink-0 max-narrow:w-[7.75rem]">
        <img
          src="/examples/trades/wendmark-sanierung-mobile-780.webp"
          width="390"
          height="844"
          alt=""
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
      <div class="card relative z-10 -ml-8 w-[13.5rem] p-4 max-narrow:-ml-5 max-narrow:w-[10.5rem] max-narrow:p-3">
        <span class="label">{text.structure}</span>
        <ul class="m-0 mt-2.5 grid list-none gap-1.5 p-0 text-[13px] text-[#1b2430] max-narrow:gap-1 max-narrow:text-[11.5px]">
          {text.pages.map((page) => (
            <li>
              <span class="font-medium">{page.name}</span>
              {page.children && (
                <ul class="m-0 mt-1.5 mb-0.5 ml-1 grid list-none gap-1 border-0 border-l-2 border-solid border-[#dbe6f8] p-0 pl-3 text-neutral-500">
                  {page.children.map((child) => (
                    <li>{child}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  {id === "landing-pages" && (
    <div class="grid w-full max-w-[22rem] gap-3">
      <div class="card p-4">
        <span class="block text-[11.5px] font-bold text-[#1b2430]">{text.sponsored}</span>
        <span class="mt-0.5 block truncate text-[11.5px] text-neutral-500">{text.adDomain}</span>
        <span class="mt-1.5 block text-[16px] leading-snug text-[#1a0dab]">{text.adTitle}</span>
        <span class="mt-1 block text-[12.5px] leading-snug text-[#4d5156] max-narrow:hidden">{text.adText}</span>
      </div>
      <div class="card ml-8 overflow-hidden p-4 max-narrow:ml-4">
        <span class="block text-[16px] font-semibold tracking-[-0.01em] text-[#1b2430]">{text.landingTitle}</span>
        <span class="mt-3 grid gap-2">
          {text.landingFields.map((field) => (
            <span class="field">{field}</span>
          ))}
          <span class="button bg-[#245bb8] text-white">{text.landingSubmit}</span>
        </span>
      </div>
      <div class="card p-4 max-narrow:hidden">
        <span class="label">{text.campaign}</span>
        <span class="mt-2 grid grid-cols-3 gap-2">
          {text.metrics.map(([label, value]) => (
            <span class="rounded-[10px] bg-neutral-50 px-3 py-2">
              <span class="block text-[11px] text-neutral-500">{label}</span>
              <span class="block text-[17px] font-semibold text-[#1b2430] tabular-nums">{value}</span>
            </span>
          ))}
        </span>
      </div>
    </div>
  )}

  {id === "online-shops" && (
    <div class="relative w-full max-w-[22rem]">
      <div class="card p-5 max-narrow:p-4">
        <span class="flex items-baseline justify-between">
          <span class="text-[15px] font-semibold text-[#1b2430]">{text.cart}</span>
          <span class="text-[12px] text-neutral-500">{text.cartCount}</span>
        </span>
        <span class="mt-4 grid gap-3">
          {text.products.map((product) => (
            <span class="flex items-center gap-3">
              <img
                src={`/examples/trades/img/${product.image}-480.webp`}
                width="48"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
                class="size-12 shrink-0 rounded-[10px] object-cover"
              />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[13px] font-medium text-[#1b2430]">{product.name}</span>
                <span class="block text-[12px] text-neutral-500">{product.variant}</span>
              </span>
              <span class="text-[13px] text-[#1b2430] tabular-nums">{product.price}</span>
            </span>
          ))}
        </span>
        <span class="mt-4 grid gap-1 rounded-[12px] bg-neutral-50 p-3 text-[12.5px] text-neutral-500 max-narrow:hidden">
          {[text.subtotal, text.shipping].map(([label, value]) => (
            <span class="flex justify-between">
              <span>{label}</span>
              <span class="tabular-nums">{value}</span>
            </span>
          ))}
          <span class="mt-1 flex justify-between text-[14px] font-semibold text-[#1b2430]">
            <span>{text.total[0]}</span>
            <span class="tabular-nums">{text.total[1]}</span>
          </span>
        </span>
        <span class="mt-3 flex flex-wrap gap-1.5 max-narrow:hidden">
          {text.payments.map((payment) => (
            <span class="rounded-[7px] bg-neutral-100 px-2 py-1 text-[11px] font-medium text-neutral-600">
              {payment}
            </span>
          ))}
        </span>
        <span class="button mt-4 bg-[#16181d] text-white">{text.checkout}</span>
      </div>
      <div class="card relative -mt-4 -ml-8 flex w-fit items-center gap-2.5 px-3.5 py-2.5 max-narrow:hidden">
        <span class="grid size-6 place-items-center rounded-full bg-[#e3f4ea] text-[#1f7a4f]">
          <Check class="size-3.5" stroke-width={2.6} />
        </span>
        <span>
          <span class="block text-[12px] font-semibold text-[#1b2430]">{text.orderSynced}</span>
          <span class="block text-[11.5px] text-neutral-500">{text.orderSyncedText}</span>
        </span>
      </div>
    </div>
  )}

  {id === "web-apps-portals" && (
    <div class="card w-full max-w-[23rem] p-5 max-narrow:p-4">
      <span class="flex items-center gap-2.5">
        <span class="grid size-8 place-items-center rounded-full bg-[#eaf2ff] text-[11px] font-bold text-[#245bb8]">
          AS
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[13px] font-semibold text-[#1b2430]">{text.customer}</span>
          <span class="block text-[11.5px] text-neutral-500">{text.portal}</span>
        </span>
        <span class="rounded-[7px] bg-neutral-100 px-2 py-1 text-[11px] font-medium text-neutral-600">
          {text.order}
        </span>
      </span>
      <span class="mt-4 block text-[15px] font-semibold text-[#1b2430]">{text.orderTitle}</span>
      <span class="mt-3 grid grid-cols-4 gap-1.5">
        {text.steps.map((step, index) => (
          <span>
            <span
              class:list={[
                "block h-1.5 rounded-full",
                index < 2 ? "bg-[#245bb8]" : index === 2 ? "step-current" : "bg-neutral-200",
              ]}
            />
            <span
              class:list={["mt-1.5 block text-[11px]", index <= 2 ? "font-medium text-[#1b2430]" : "text-neutral-400"]}
            >
              {step}
            </span>
          </span>
        ))}
      </span>
      <span class="mt-4 flex items-center gap-3 rounded-[12px] bg-neutral-50 p-3">
        <CalendarDays class="size-4 shrink-0 text-[#245bb8]" stroke-width={2} />
        <span class="min-w-0">
          <span class="block text-[11px] text-neutral-500">{text.nextAppointment}</span>
          <span class="block text-[13px] font-medium text-[#1b2430]">{text.appointment}</span>
          <span class="block text-[12px] text-neutral-500">{text.appointmentText}</span>
        </span>
      </span>
      <span class="label mt-4 block max-narrow:hidden">{text.documents}</span>
      <span class="mt-2 grid gap-1.5 max-narrow:hidden">
        {text.files.map(([name, size]) => (
          <span class="flex items-center gap-2.5 text-[12.5px] text-[#1b2430]">
            <FileText class="size-4 shrink-0 text-neutral-400" stroke-width={1.8} />
            <span class="min-w-0 flex-1 truncate">{name}</span>
            <span class="text-[11.5px] text-neutral-400">{size}</span>
          </span>
        ))}
        <span class="mt-1 flex items-center justify-center gap-2 rounded-[10px] border border-dashed border-neutral-300 py-2 text-[12px] font-medium text-neutral-500">
          <Upload class="size-3.5" stroke-width={2} />
          {text.upload}
        </span>
      </span>
    </div>
  )}

  {id === "relaunch" && (
    <div class="relative w-full max-w-[24rem]">
      <div class="card overflow-hidden">
        <span class="flex items-center justify-between px-4 pt-4 pb-3">
          <span class="text-[14px] font-semibold text-[#1b2430]">{text.redirects}</span>
          <span class="rounded-[7px] bg-neutral-100 px-2 py-1 text-[11px] font-semibold text-neutral-600">301</span>
        </span>
        <span class="grid">
          {text.redirectRows.map(([from, to], index) => (
            <span
              class:list={[
                "grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 px-4 py-2 text-[12px]",
                index % 2 === 0 && "bg-neutral-50",
              ]}
            >
              <span class="truncate text-neutral-400">{from}</span>
              <ArrowRight class="size-3.5 text-neutral-400" stroke-width={2} />
              <span class="truncate font-medium text-[#1b2430]">{to}</span>
            </span>
          ))}
        </span>
        <span class="flex items-center gap-2 px-4 py-3 text-[12.5px] font-medium text-[#1f7a4f]">
          <Check class="size-4" stroke-width={2.4} />
          {text.redirectsDone}
        </span>
      </div>
      <div class="card relative -mt-3 mr-[-1.5rem] ml-auto w-[15rem] p-4 max-narrow:hidden">
        <span class="label">{text.console}</span>
        <span class="mt-1.5 flex items-baseline gap-2">
          <span class="text-[30px] leading-none font-light tracking-[-0.03em] text-[#1b2430] tabular-nums">
            {text.indexed}
          </span>
          <span class="text-[12px] text-neutral-500">{text.indexedOf}</span>
        </span>
        <span class="mt-2 block text-[11px] text-neutral-400">{text.consoleNote}</span>
      </div>
    </div>
  )}

  {id === "accessibility" && (
    <div class="grid w-full max-w-[22rem]">
      <div class="relative z-10 -mb-3 mr-[-1.5rem] flex max-w-[15rem] items-start gap-2.5 justify-self-end rounded-[14px] bg-[#16181d] px-3.5 py-3 text-white shadow-lg max-narrow:mr-0">
        <Volume2 class="mt-0.5 size-4 shrink-0" stroke-width={2} />
        <span>
          <span class="block text-[11px] text-white/60">{text.reader}</span>
          <span class="block text-[12.5px] leading-snug">{text.readerText}</span>
        </span>
      </div>
      <div class="card px-5 pt-7 pb-8">
        <span class="block text-[12.5px] font-semibold text-[#1b2430]">
          {text.emailLabel} <span class="font-normal text-neutral-500">({text.required})</span>
        </span>
        <span class="focus-field mt-2 flex h-10 items-center rounded-[10px] px-3 text-[13px] text-[#1b2430]">
          {text.emailValue}
          <span class="caret ml-px h-4 w-px bg-[#1b2430]" />
        </span>
        <span class="mt-3 flex items-center gap-2 text-[12px] text-neutral-500 max-narrow:hidden">
          <kbd class="rounded-[6px] bg-neutral-100 px-1.5 py-0.5 font-sans text-[11px] font-semibold text-neutral-600 shadow-[inset_0_-1px_0_rgb(0_0_0/12%)]">
            {text.tabKey}
          </kbd>
          {text.tabHint}
        </span>
        <span class="button mt-4 bg-[#16181d] text-white">{text.landingSubmit}</span>
      </div>
      <div class="card relative -mt-4 -ml-6 flex w-fit items-center gap-3 px-3.5 py-2.5 max-narrow:hidden">
        <span class="grid size-8 place-items-center rounded-[8px] bg-white text-[13px] font-bold text-[#1b2430] shadow-[inset_0_0_0_1px_rgb(0_0_0/10%)]">
          Aa
        </span>
        <span>
          <span class="block text-[11px] text-neutral-500">{text.contrast}</span>
          <span class="block text-[13px] font-semibold text-[#1b2430] tabular-nums">{text.contrastValue}</span>
        </span>
        <span class="rounded-[7px] bg-[#e3f4ea] px-2 py-1 text-[11px] font-semibold text-[#1f7a4f]">
          {text.contrastLevel}
        </span>
      </div>
    </div>
  )}

  {id === "hosting-care" && (
    <div class="grid w-full max-w-[22rem]">
      <div class="card p-5">
        <span class="flex items-center gap-2 text-[13px] font-semibold text-[#1b2430]">
          <PencilLine class="size-4 text-[#245bb8]" stroke-width={2} />
          {text.hours}
        </span>
        <span class="focus-field mt-3 flex h-10 items-center rounded-[10px] px-3 text-[13px] text-[#1b2430]">
          <span class="truncate">{text.hoursValue}</span>
        </span>
        <span class="mt-3 flex items-center justify-between gap-3">
          <span class="text-[11.5px] text-neutral-500 max-narrow:hidden">{text.edited}</span>
          <span class="button shrink-0 bg-[#245bb8] px-4 text-white">{text.publish}</span>
        </span>
      </div>
      <div class="card relative -mt-4 mr-[-1.5rem] w-[14rem] justify-self-end p-4 max-narrow:mr-0">
        <span class="flex items-center gap-1.5">
          <Lock class="size-3 text-neutral-400" stroke-width={2.2} />
          <span class="label">{text.operations}</span>
        </span>
        <span class="mt-2.5 grid gap-2">
          {text.status.map(([label, value]) => (
            <span class="flex items-center gap-2 text-[12.5px]">
              <span class="size-2 rounded-full bg-[#28a26b]" />
              <span class="flex-1 text-[#1b2430]">{label}</span>
              <span class="text-neutral-500">{value}</span>
            </span>
          ))}
        </span>
      </div>
    </div>
  )}
</div>

<style>
  .visual {
    display: grid;
    place-items: center;
    width: 100%;
  }
  .card {
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 5%),
      0 1px 2px rgb(0 0 0 / 4%),
      0 18px 36px -20px rgb(0 0 0 / 28%);
  }
  .label {
    font-size: 11px;
    font-weight: 500;
    color: #737373;
  }
  .phone {
    overflow: hidden;
    border: 6px solid #16181d;
    border-radius: 1.75rem;
    background: #16181d;
    box-shadow: 0 30px 50px -28px rgb(0 0 0 / 45%);
  }
  .field {
    display: flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 9px;
    background: #f5f5f4;
    font-size: 12.5px;
    color: #1b2430;
  }
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    border-radius: 9px;
    font-size: 12.5px;
    font-weight: 600;
  }
  .step-current {
    background: linear-gradient(90deg, #245bb8 55%, #dbe6f8 55%);
  }
  .focus-field {
    background: #fff;
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 14%),
      0 0 0 2px #fff,
      0 0 0 4px #245bb8;
  }
</style>
