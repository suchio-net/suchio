---
import SectionHeading from "@/components/section-heading.astro";
import ServiceLink from "@/components/service-page/service-link.astro";
import type { ServiceCopy, ServiceId } from "@/i18n/services";
import { getSubServiceCopy } from "@/i18n/sub-services";
import type { Locale } from "@/lib/i18n";
import { getSubServicePath, subServiceRoutes } from "@/lib/sub-service-routes";

interface Props {
  details: NonNullable<ServiceCopy["page"]["details"]>;
  serviceId: ServiceId;
  locale: Locale;
}
const { details, serviceId, locale } = Astro.props;
const links = subServiceRoutes.filter((route) => route.area === serviceId);
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[75rem]">
    <SectionHeading title={details.heading} copy={details.intro} />
    <div class="reveal grid grid-cols-2 gap-x-12 gap-y-2 max-nav:grid-cols-1 max-nav:gap-y-1" data-reveal>
      {links.map(({ id }) => {
        const copy = getSubServiceCopy(locale, id);
        return <ServiceLink href={getSubServicePath(id, locale)} name={copy.name} text={copy.summary} />;
      })}
    </div>
    {details.items.length > 0 && (
      <div class="mt-10 grid grid-cols-2 gap-x-12 gap-y-8 max-nav:grid-cols-1">
        {details.items.map((item) => (
          <div class="max-w-[34rem]">
            <h3 class="m-0 text-heading-sm">{item.heading}</h3>
            {item.paragraphs.map((paragraph) => (
              <p class="mt-2 mb-0 text-base/7 text-muted">{paragraph}</p>
            ))}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
