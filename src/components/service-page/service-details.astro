---
import { ChevronRight } from "@lucide/astro";
import SectionHeading from "@/components/section-heading.astro";
import type { ServiceCopy } from "@/i18n/services";
import { localizePath, t, type Locale } from "@/lib/i18n";
import { getServicePath } from "@/lib/service-routes";

interface Props {
  details: NonNullable<ServiceCopy["page"]["details"]>;
  locale: Locale;
}
const { details, locale } = Astro.props;

type Target = NonNullable<(typeof details.items)[number]["link"]>["to"];
const linkHref = (to: Target) => {
  if (to === "reference") return localizePath("/references/handwerker-work", locale);
  if (to === "examples") return localizePath("/examples", locale);
  return getServicePath(to, locale);
};
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[75rem]">
    <SectionHeading title={details.heading} copy={details.intro} />
    <!-- Every panel is in the HTML, so search engines and AI crawlers read the text of all sub-services.
         Wide screens show a list beside one panel. Phones show each name with its first sentence, and the rest opens in place. -->
    <div class="reveal service-list" data-reveal data-service-list style={{ "--rows": details.items.length }}>
      {details.items.map((item, index) => (
        <>
          <h3 class="service-list-heading m-0">
            <button
              type="button"
              id={`service-tab-${item.id}`}
              aria-controls={item.id}
              aria-expanded={index === 0 ? "true" : "false"}
              class="service-list-button"
            >
              <span class="min-w-0">{item.heading}</span>
              <ChevronRight class="service-list-chevron size-4.5 shrink-0" stroke-width={2} aria-hidden="true" />
            </button>
          </h3>
          <div
            id={item.id}
            role="region"
            aria-labelledby={`service-tab-${item.id}`}
            class="service-list-panel"
            data-open={index === 0 ? "" : undefined}
          >
            {item.lead && <p class="service-list-lead m-0 text-heading-md text-balance text-ink">{item.lead}</p>}
            <div class="service-list-more" id={`${item.id}-more`}>
              <div class="service-list-more-inner">
                {item.paragraphs.map((paragraph) => (
                  <p class="mt-4 mb-0 text-lg/8 text-muted max-narrow:text-base/7">{paragraph}</p>
                ))}
                {item.link && (
                  <a
                    class="mt-5 inline-block text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
                    href={linkHref(item.link.to)}
                  >
                    {item.link.label}
                  </a>
                )}
              </div>
            </div>
            <button
              type="button"
              class="service-list-toggle"
              aria-controls={`${item.id}-more`}
              aria-expanded="false"
              data-service-toggle
            >
              <span class="service-list-toggle-more">{t(locale, "service.readMore")}</span>
              <span class="service-list-toggle-less">{t(locale, "service.readLess")}</span>
              <span class="sr-only">{item.heading}</span>
            </button>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .service-list-heading {
    font: inherit;
  }
  .service-list-button {
    display: flex;
    align-items: center;
    color: var(--color-muted);
    font-weight: 500;
    text-align: left;
    transition:
      background-color 150ms,
      color 150ms;
  }
  .service-list-button[aria-expanded="true"] {
    color: var(--color-ink);
  }
  .service-list-chevron {
    color: var(--color-subtle);
  }
  .service-list-panel {
    max-width: 44rem;
  }
  .service-list-toggle {
    display: none;
  }

  @media (min-width: 56.26rem) {
    .service-list {
      display: grid;
      /* The panels span one extra flexible row, so a tall panel does not stretch the list rows. */
      grid-template-rows: repeat(var(--rows), auto) 1fr;
      grid-template-columns: 21rem minmax(0, 1fr);
      column-gap: 5rem;
      row-gap: 0.25rem;
    }
    .service-list-heading {
      grid-column: 1;
    }
    .service-list-button {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
      border-radius: var(--radius-card);
      padding: 0.8rem 1rem;
      font-size: 1.0625rem;
      line-height: 1.3;
    }
    .service-list-button:hover {
      color: var(--color-ink);
      background: var(--color-interaction);
    }
    .service-list-chevron {
      opacity: 0;
      transition: opacity 150ms;
    }
    .service-list-button[aria-expanded="true"] {
      background: #fff;
      box-shadow: var(--shadow-surface);
    }
    .service-list-button[aria-expanded="true"] .service-list-chevron {
      opacity: 1;
    }
    .service-list-panel {
      grid-row: 1 / span calc(var(--rows) + 1);
      grid-column: 2;
      padding-top: 0.4rem;
    }
    /* The closed panels keep their space, so the page does not jump when the selection changes. */
    :global(.reveal-ready) .service-list-panel {
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 160ms ease,
        visibility 0s linear 160ms;
    }
    :global(.reveal-ready) .service-list-panel[data-open] {
      visibility: visible;
      opacity: 1;
      transition: opacity 160ms ease;
    }
  }

  @media (max-width: 56.25rem) {
    .service-list-button {
      width: 100%;
      padding: 0;
      color: var(--color-ink);
      font-size: 1.1875rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .service-list-chevron {
      display: none;
    }
    .service-list-panel {
      margin-top: 0.3rem;
      margin-bottom: 1.25rem;
    }
    .service-list-panel:last-child {
      margin-bottom: 0;
    }
    .service-list-lead {
      color: var(--color-muted);
      font-size: 1.0625rem;
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1.5;
      text-wrap: pretty;
    }
    .service-list-more-inner > p {
      margin-top: 0.75rem;
    }
    :global(.reveal-ready) .service-list-toggle {
      display: inline-block;
      padding: 0.45rem 0;
      color: var(--color-ink);
      font-size: 0.9375rem;
      font-weight: 500;
      text-decoration: underline;
      text-decoration-color: var(--color-line-strong);
      text-underline-offset: 4px;
    }
    .service-list-toggle-less {
      display: none;
    }
    .service-list-panel[data-expanded] .service-list-toggle-less {
      display: inline;
    }
    .service-list-panel[data-expanded] .service-list-toggle-more {
      display: none;
    }
    /* The text opens to its real height. A hidden link cannot take keyboard focus. */
    :global(.reveal-ready) .service-list-more {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 200ms ease,
        visibility 0s linear 200ms;
    }
    :global(.reveal-ready) .service-list-panel[data-expanded] .service-list-more {
      grid-template-rows: 1fr;
      visibility: visible;
      transition: grid-template-rows 200ms ease;
    }
    .service-list-more-inner {
      min-height: 0;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-list-button,
    .service-list-chevron,
    :global(.reveal-ready) .service-list-panel,
    :global(.reveal-ready) .service-list-panel[data-open],
    :global(.reveal-ready) .service-list-more,
    :global(.reveal-ready) .service-list-panel[data-expanded] .service-list-more {
      transition: none;
    }
  }
</style>

<script>
  const compact = window.matchMedia("(max-width: 56.25rem)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-service-list]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("h3 button[aria-controls]")];
    const toggles = [...root.querySelectorAll<HTMLButtonElement>("[data-service-toggle]")];
    const panels = buttons.map((button) => document.getElementById(button.getAttribute("aria-controls") ?? ""));
    // Wide screens show one selected panel. Phones open any number of texts in place.
    let selected = 0;
    const expanded = new Set<number>();
    const sync = () => {
      buttons.forEach((button, at) =>
        button.setAttribute("aria-expanded", String(compact.matches ? expanded.has(at) : at === selected)),
      );
      toggles.forEach((toggle, at) => toggle.setAttribute("aria-expanded", String(expanded.has(at))));
      panels.forEach((panel, at) => {
        panel?.toggleAttribute("data-open", at === selected);
        panel?.toggleAttribute("data-expanded", expanded.has(at));
      });
    };
    const flip = (index: number) => {
      if (!expanded.delete(index)) expanded.add(index);
      sync();
    };
    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        if (compact.matches) return flip(index);
        selected = index;
        sync();
      }),
    );
    toggles.forEach((toggle, index) => toggle.addEventListener("click", () => flip(index)));
    // A link to a sub-service, such as #relaunch, opens that sub-service.
    const linked = panels.findIndex((panel) => panel && `#${panel.id}` === location.hash);
    if (linked >= 0) {
      selected = linked;
      expanded.add(linked);
    }
    compact.addEventListener("change", sync);
    sync();
  }
</script>
