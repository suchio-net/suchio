---
import SectionHeading from "@/components/section-heading.astro";

interface Props {
  heading: string;
  intro: string;
  columns: readonly string[];
  rows: readonly { title: string; cells: readonly string[] }[];
  link?: { label: string; href: string };
}
const { heading, intro, columns, rows, link } = Astro.props;
// Phones show the first rows only. The other rows stay in the HTML.
const phoneRows = 3;
---

<section class="px-page pb-section">
  <div class="mx-auto max-w-[75rem]">
    <SectionHeading title={heading} copy={intro} />
    <div class="reveal service-table-wrap" data-reveal>
      <table class="service-table">
        <thead>
          <tr>
            {columns.map((column) => (
              <th scope="col">{column}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, index) => (
            <tr data-phone-hidden={index >= phoneRows ? "" : undefined}>
              <th scope="row">{row.title}</th>
              {row.cells.map((cell, at) => (
                <td data-label={columns[at + 1]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {link && (
      <a
        class="mt-6 inline-block text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
        href={link.href}
      >
        {link.label}
      </a>
    )}
  </div>
</section>

<style>
  .service-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .service-table th,
  .service-table td {
    vertical-align: top;
    font-weight: 400;
  }

  @media (min-width: 56.26rem) {
    .service-table-wrap {
      overflow: hidden;
      border-radius: var(--radius-card);
      background: #fff;
      box-shadow: var(--shadow-surface);
    }
    .service-table {
      table-layout: fixed;
    }
    .service-table th,
    .service-table td {
      padding: 1.1rem 1.5rem;
      font-size: 1rem;
      line-height: 1.5;
    }
    .service-table thead th {
      padding-block: 0.9rem;
      color: var(--color-subtle);
      font-size: 0.875rem;
      font-weight: 500;
    }
    .service-table thead th:first-child {
      width: 13rem;
    }
    .service-table tbody tr:nth-child(odd) {
      background: var(--color-canvas);
    }
    .service-table tbody th {
      color: var(--color-ink);
      font-weight: 600;
    }
    .service-table td {
      color: var(--color-muted);
    }
    .service-table td:last-child {
      color: var(--color-ink);
    }
  }

  @media (max-width: 56.25rem) {
    .service-table,
    .service-table tbody,
    .service-table tr,
    .service-table th,
    .service-table td {
      display: block;
    }
    /* Each cell names its column below, so the header row is for screen readers only. */
    .service-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .service-table tbody {
      display: grid;
      gap: 2rem;
    }
    .service-table tbody th {
      color: var(--color-ink);
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .service-table td {
      margin-top: 0.75rem;
      color: var(--color-muted);
      font-size: 1rem;
      line-height: 1.5;
    }
    .service-table td::before {
      content: attr(data-label);
      display: block;
      color: var(--color-subtle);
      font-size: 0.875rem;
    }
    .service-table td:last-child {
      color: var(--color-ink);
    }
  }

  @media (max-width: 37.5rem) {
    .service-table tr[data-phone-hidden] {
      display: none;
    }
  }
</style>
