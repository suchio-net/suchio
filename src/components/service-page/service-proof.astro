---
import { ArrowRight } from "@lucide/astro";
import { getReferencesCopy } from "@/i18n/references";
import type { ServiceProof } from "@/i18n/services";
import { localizePath, type Locale } from "@/lib/i18n";

interface Props {
  proof: ServiceProof;
  locale: Locale;
}
const { proof, locale } = Astro.props;
const { handwerkerWork } = getReferencesCopy(locale);
// The real screenshots of the old and the new website, the same ones as on the reference page.
const shots = [
  {
    base: "/references/handwerker-work-before",
    ...handwerkerWork.beforeShot,
    note: handwerkerWork.beforeShot.findings,
  },
  { base: "/references/handwerker-work-preview", ...handwerkerWork.afterShot, note: handwerkerWork.afterShot.changes },
];
---

<section class="bg-white px-page py-section">
  <div class="mx-auto max-w-[75rem]">
    <div class="reveal grid grid-cols-2 items-end gap-16 max-nav:grid-cols-1 max-nav:gap-8" data-reveal>
      <div>
        <h2 class="m-0 text-heading-lg text-balance">{proof.heading}</h2>
        <p class="mt-4 mb-0 max-w-[34rem] text-lg/7 text-muted">{proof.text}</p>
        <a
          class="mt-5 inline-block text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
          href={localizePath("/references/handwerker-work", locale)}
        >
          {proof.link}
        </a>
      </div>
      <dl class="m-0 grid gap-4">
        {proof.facts.map((fact) => (
          <div class="flex items-baseline justify-between gap-4 max-narrow:grid max-narrow:gap-1">
            <dt class="text-base text-muted">{fact.label}</dt>
            <dd class="m-0 flex items-center gap-2.5 text-[1.375rem] leading-none tabular-nums">
              <span class="sr-only">{proof.beforeLabel}</span>
              <span class="text-[#b4443f] line-through decoration-1">{fact.before}</span>
              <ArrowRight class="size-4 text-subtle" stroke-width={2} aria-hidden="true" />
              <span class="sr-only">{proof.afterLabel}</span>
              <span class="font-semibold text-[#1f6b46]">{fact.after}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-8 max-narrow:mt-10 max-narrow:grid-cols-1 max-narrow:gap-6">
      {shots.map((shot, index) => (
        <figure class="reveal m-0" data-reveal style={{ "--reveal-delay": `${index * 80}ms` }}>
          <picture class="block overflow-hidden rounded-card shadow-surface">
            <source
              type="image/avif"
              srcset={`${shot.base}-720.avif 720w, ${shot.base}-1440.avif 1440w`}
              sizes="(max-width: 37.5rem) 100vw, 37rem"
            />
            <img
              src={`${shot.base}-1440.webp`}
              srcset={`${shot.base}-720.webp 720w, ${shot.base}-1440.webp 1440w`}
              sizes="(max-width: 37.5rem) 100vw, 37rem"
              width="1440"
              height="900"
              alt={shot.alt}
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </picture>
          <figcaption class="mt-4">
            <span class="block text-sm font-semibold text-ink">{shot.caption}</span>
            <span class="mt-1 block max-w-[34rem] text-base/6 text-muted max-narrow:hidden">{shot.note}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
