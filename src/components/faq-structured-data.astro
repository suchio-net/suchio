---
import StructuredData from "@/components/structured-data.astro";
import type { Faq } from "@/lib/faqs";
interface Props {
  items: readonly Pick<Faq, "question" | "answer">[];
}
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: Astro.props.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<StructuredData value={schema} />
