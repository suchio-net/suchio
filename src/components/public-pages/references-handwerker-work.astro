---
import CtaButton from "@/components/cta-button.astro";
import EditorialHero from "@/components/editorial-hero.astro";
import FinalCta from "@/components/final-cta.astro";
import ImageViewer from "@/components/image-viewer.astro";
import LighthouseGauge from "@/components/lighthouse-gauge.astro";
import SectionHeading from "@/components/section-heading.astro";
import { serviceIcons } from "@/components/service-icons";
import { serviceStyles } from "@/components/service-styles";
import SiteLayout from "@/layouts/site-layout.astro";
import { Maximize2 } from "@lucide/astro";
import { getReferencesCopy, handwerkerWorkMeasurements as measured } from "@/i18n/references";
import { localizePath, type Locale } from "@/lib/i18n";
import { getServiceCatalog } from "@/lib/service-catalog";
import { breadcrumbNode, pageNode } from "@/lib/structured-data";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { label, handwerkerWork: copy } = getReferencesCopy(locale);
const lh = copy.lighthouse;
const logDate = new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", timeZone: "UTC" });
// The services this project used, linked from the side panel next to the project log.
const projectServices = getServiceCatalog(locale).filter((service) =>
  ["websites-apps", "seo-ai-visibility", "ai-automation"].includes(service.id),
);
const overviewPath = localizePath("/references", locale);
const path = localizePath("/references/handwerker-work", locale);
const site = "https://handwerker.work/";

const seconds = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const megabytes = new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const [lcpBefore, lcpAfter] = measured.lcpSeconds;
const [weightBefore, weightAfter] = measured.transferMegabytes;
const desktop = [
  { name: lh.performance, value: measured.desktop.performance },
  { name: lh.accessibility, value: measured.desktop.accessibility },
  { name: lh.bestPractices, value: measured.desktop.bestPractices },
  { name: lh.seo, value: measured.desktop.seo },
];
// The LCP scale ends just past the old value; Google's thresholds are 2.5 s and 4 s.
const lcpMax = 11;
const lcpAt = (value: number) => `${(value / lcpMax) * 100}%`;
// The page chart starts at 40 so the differences stay readable; the zones follow Lighthouse.
// The scale is inset by half a dot, so a dot at 40 or 100 stays inside the track.
const scoreMin = 40;
const scoreTicks = [40, 50, 90, 100];
const scoreAt = (value: number) =>
  `calc(var(--score-inset) + (100% - 2 * var(--score-inset)) * ${(value - scoreMin) / (100 - scoreMin)})`;
const rating = (value: number) => (value >= 90 ? "pass" : value >= 50 ? "average" : "fail");
const pages = (["home", "contact", "badNauheim"] as const).map((id) => ({
  name: copy.pages[id],
  before: measured.pages[id][0],
  after: measured.pages[id][1],
}));
// The viewer opens the largest file: the old site exists only at 1440 px, the new one also at 2880 px.
const shots = [
  {
    base: "/references/handwerker-work-before",
    full: "/references/handwerker-work-before-1440.webp",
    ...copy.beforeShot,
    text: copy.beforeShot.findings,
  },
  {
    base: "/references/handwerker-work-preview",
    full: "/references/handwerker-work-preview-2880.webp",
    ...copy.afterShot,
    text: copy.afterShot.changes,
  },
];
---

<SiteLayout
  locale={locale}
  title={copy.title.replace(/ \| Suchio$/, "")}
  description={copy.description}
  schema={[
    pageNode(locale, path, copy.title, "WebPage", {
      about: { "@type": "Organization", name: copy.name, url: site },
    }),
    breadcrumbNode(locale, [
      { name: label, path: overviewPath },
      { name: copy.name, path },
    ]),
  ]}
>
  <main id="main-content">
    <EditorialHero title={copy.h1} copy={copy.intro}>
      <ol class="m-0 flex list-none items-center gap-2 p-0 text-sm text-muted">
        <li>
          <a class="underline decoration-line-strong underline-offset-4 hover:decoration-ink" href={overviewPath}>
            {label}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{copy.name}</li>
      </ol>
      <CtaButton href={site} className="mt-4 [&>span:first-child]:min-w-0">
        {copy.visit}
      </CtaButton>
    </EditorialHero>

    <section class="px-page pb-section">
      <div class="mx-auto grid max-w-layout grid-cols-2 gap-x-8 gap-y-12 max-nav:grid-cols-1">
        {shots.map((shot) => (
          <figure class="m-0">
            <button
              type="button"
              aria-haspopup="dialog"
              data-image-viewer
              data-src={shot.full}
              data-alt={shot.alt}
              data-caption={shot.caption}
              data-ratio="1.6"
              class="group/shot relative block w-full cursor-zoom-in rounded-shell text-left"
            >
              <picture class="block overflow-hidden rounded-shell shadow-floating">
                <source
                  type="image/avif"
                  srcset={`${shot.base}-720.avif 720w, ${shot.base}-1440.avif 1440w`}
                  sizes="(max-width: 900px) 100vw, 37rem"
                />
                <img
                  src={`${shot.base}-1440.webp`}
                  srcset={`${shot.base}-720.webp 720w, ${shot.base}-1440.webp 1440w`}
                  sizes="(max-width: 900px) 100vw, 37rem"
                  width="1440"
                  height="900"
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </picture>
              <span class="absolute right-3 bottom-3 inline-flex size-10 items-center justify-center rounded-pill bg-inverse-surface/80 text-inverse opacity-80 transition-opacity duration-150 group-hover/shot:opacity-100">
                <Maximize2 aria-hidden="true" class="size-4" stroke-width={1.8} />
                <span class="sr-only">{copy.viewer.open}</span>
              </span>
            </button>
            <figcaption class="mt-5">
              <span class="block text-heading-sm">{shot.caption}</span>
              <span class="mt-2 block max-w-[34rem] text-base/6 text-muted">{shot.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <ImageViewer labels={copy.viewer} />
    </section>

    <section class="bg-black px-page py-section text-inverse">
      <div class="reveal mx-auto max-w-[62rem]" data-reveal>
        <div class="mx-auto max-w-[40rem] text-center">
          <h2 class="m-0 text-heading-lg text-white">{lh.heading}</h2>
          <p class="mt-4 text-lg/7 text-inverse-muted">{lh.text}</p>
        </div>

        <div class="mt-14 grid grid-cols-3 gap-6 max-narrow:gap-3">
          <LighthouseGauge
            score={measured.scores.performance[1]}
            before={measured.scores.performance[0]}
            label={lh.performance}
            beforeLabel={lh.before}
          />
          <LighthouseGauge
            score={measured.scores.accessibility[1]}
            before={measured.scores.accessibility[0]}
            label={lh.accessibility}
            beforeLabel={lh.before}
          />
          <LighthouseGauge
            score={measured.scores.seo[1]}
            before={measured.scores.seo[0]}
            label={lh.seo}
            beforeLabel={lh.before}
          />
        </div>
        <p class="mt-6 text-center text-meta text-inverse-muted">{lh.legend}</p>

        <div class="mt-16 grid grid-cols-2 gap-x-14 gap-y-12 max-nav:grid-cols-1">
          <div>
            <h3 class="m-0 text-heading-sm text-white">{lh.lcp}</h3>
            <div class="lcp-meter relative mt-12">
              <div class="flex h-2.5 overflow-hidden rounded-pill" aria-hidden="true">
                <span class="lh-zone lh-zone--pass" style={{ width: lcpAt(2.5) }}></span>
                <span class="lh-zone lh-zone--average" style={{ width: lcpAt(1.5) }}></span>
                <span class="lh-zone lh-zone--fail grow"></span>
              </div>
              {[
                { value: lcpAfter, name: lh.newSite },
                { value: lcpBefore, name: lh.oldSite },
              ].map((mark) => (
                <span class={`lcp-mark ${mark.value > 4 ? "lcp-mark--poor" : ""}`} style={{ left: lcpAt(mark.value) }}>
                  <span class="lcp-mark__label">
                    {mark.name} {seconds.format(mark.value)} s
                  </span>
                </span>
              ))}
            </div>
            <p class="mt-5 text-meta text-inverse-muted">{lh.lcpScale}</p>
          </div>

          <div>
            <h3 class="m-0 text-heading-sm text-white">{lh.weight}</h3>
            <dl class="mt-6 grid gap-4">
              {[
                { name: lh.oldSite, value: weightBefore, tone: "bg-inverse-muted" },
                { name: lh.newSite, value: weightAfter, tone: "bg-white" },
              ].map((bar) => (
                <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] items-center gap-3">
                  <dt class="text-meta text-inverse-muted">{bar.name}</dt>
                  <dd class="m-0 flex items-center gap-3">
                    <span
                      class={`block h-2.5 rounded-pill ${bar.tone}`}
                      style={{ width: `${(bar.value / weightBefore) * 72}%` }}
                    />
                    <span class="text-ui whitespace-nowrap tabular-nums">{megabytes.format(bar.value)} MB</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <div class="mt-16 border-t border-inverse-line pt-12">
          <h3 class="m-0 text-heading-sm text-white">{lh.desktop}</h3>
          <p class="mt-2 max-w-[40rem] text-meta text-inverse-muted">{lh.desktopText}</p>
          <dl class="mt-8 grid grid-cols-5 gap-6 max-nav:grid-cols-3 max-narrow:grid-cols-2">
            {desktop.map((item) => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-meta text-inverse-muted">{item.name}</dt>
                <dd class={`desktop-figure m-0 tabular-nums lh-figure--${rating(item.value)}`}>{item.value}</dd>
              </div>
            ))}
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-meta text-inverse-muted">LCP</dt>
              <dd class="desktop-figure m-0 tabular-nums text-white">
                {seconds.format(measured.desktop.lcpSeconds)} s
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto max-w-layout">
        <SectionHeading title={copy.pagesHeading} copy={copy.pagesText} />
        <ul class="m-0 grid list-none gap-8 p-0">
          {pages.map((page) => (
            <li class="grid grid-cols-[minmax(0,14rem)_minmax(0,1fr)] items-center gap-x-8 gap-y-3 max-nav:grid-cols-1">
              <span class="text-heading-sm">{page.name}</span>
              <span class="score-track relative block h-12" aria-hidden="true">
                <span
                  class="score-line"
                  style={{
                    left: scoreAt(page.before),
                    width: `calc(${scoreAt(page.after)} - ${scoreAt(page.before)})`,
                  }}
                />
                <span
                  class={`score-dot score-dot--before lh-dot--${rating(page.before)}`}
                  style={{ left: scoreAt(page.before) }}
                >
                  <span>{page.before}</span>
                </span>
                <span class={`score-dot lh-dot--${rating(page.after)}`} style={{ left: scoreAt(page.after) }}>
                  <span>{page.after}</span>
                </span>
              </span>
              <span class="sr-only">
                {lh.oldSite} {page.before}, {lh.newSite} {page.after}
              </span>
            </li>
          ))}
        </ul>
        <div
          class="score-axis relative mt-3 ml-[calc(14rem+2rem)] h-5 text-meta text-muted tabular-nums max-nav:ml-0"
          aria-hidden="true"
        >
          {scoreTicks.map((tick) => (
            <span class="absolute top-0 -translate-x-1/2" style={{ left: scoreAt(tick) }}>
              {tick}
            </span>
          ))}
        </div>
        <p class="mt-10 max-w-[45rem] text-meta text-muted">{copy.sourceNote}</p>
      </div>
    </section>

    <section class="bg-white px-page py-section">
      <div class="mx-auto max-w-layout">
        <SectionHeading title={copy.findingsHeading} copy={copy.findingsText} />
        <div class="findings-wrap reveal" data-reveal>
          <table class="findings-table w-full border-collapse text-left">
            <thead>
              <tr>
                <th scope="col">{copy.topicLabel}</th>
                <th scope="col">{copy.beforeLabel}</th>
                <th scope="col">{copy.afterLabel}</th>
              </tr>
            </thead>
            <tbody>
              {copy.findings.map((finding) => (
                <tr>
                  <th scope="row">{finding.title}</th>
                  <td data-label={copy.beforeLabel}>{finding.before}</td>
                  <td data-label={copy.afterLabel}>{finding.after}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto grid max-w-layout grid-cols-[minmax(0,1fr)_minmax(0,22rem)] gap-x-16 gap-y-14 max-wide:grid-cols-1">
        <div class="min-w-0">
          <SectionHeading title={copy.logHeading} copy={copy.logText} />
          <ol class="project-log m-0 list-none p-0">
            {copy.log.map((entry) => (
              <li class="project-log__entry reveal" data-reveal>
                <time class="project-log__date" datetime={entry.date}>
                  {logDate.format(new Date(`${entry.date}T12:00:00Z`))}
                </time>
                <div class="project-log__body">
                  <h3 class="m-0 text-heading-sm">{entry.title}</h3>
                  <p class="mt-2 mb-0 max-w-[40rem] text-base/7 text-muted">{entry.copy}</p>
                  {entry.link && (
                    <a
                      class="mt-3 inline-block text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
                      href={entry.link.href}
                    >
                      {entry.link.label}
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <aside
          class="reveal min-w-0 self-start rounded-card bg-white p-card-fluid shadow-surface wide:sticky wide:top-28"
          data-reveal
        >
          <h2 class="m-0 text-heading-md">{copy.nowHeading}</h2>
          <p class="mt-4 text-base/7 text-muted">{copy.nowText}</p>
          <h3 class="mt-8 mb-3 text-meta font-semibold text-ink">{copy.servicesLabel}</h3>
          <ul class="m-0 grid list-none gap-2 p-0">
            {projectServices.map((service) => {
              const Icon = serviceIcons[service.id];
              return (
                <li>
                  <a
                    class="flex items-center gap-3 rounded-control p-2 transition-colors duration-150 hover:bg-interaction"
                    href={service.href}
                  >
                    <span
                      class={`grid size-9 shrink-0 place-items-center rounded-inset ${serviceStyles[service.id].icon}`}
                    >
                      <Icon class="size-4.5" stroke-width={1.7} aria-hidden="true" />
                    </span>
                    <span class="text-sm font-semibold text-ink">{service.copy.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      </div>
    </section>

    <FinalCta
      locale={locale}
      title={copy.cta.heading}
      copy={copy.cta.text}
      button={copy.cta.button}
      href={`${localizePath("/contact", locale)}?service=websites-apps`}
    />
  </main>
</SiteLayout>

<style>
  /* The findings table. On wide screens, area and old state form one bordered card with a light
     red column. The new-state column looks cut out and lifted forward: a green card in front of the
     table edge, a little larger than the column, with a shadow. Column widths are fixed, so the
     card can be drawn exactly behind the third column. */
  .findings-wrap {
    --findings-topic: 13rem;
    --findings-lift: 0.75rem;
    --findings-split: calc(var(--findings-topic) + (100% - var(--findings-topic)) / 2);
    position: relative;
    isolation: isolate;
  }
  .findings-table {
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }
  .findings-table th,
  .findings-table td {
    padding: 1.25rem 1.5rem;
    vertical-align: top;
    font-size: 1rem;
    line-height: 1.75rem;
  }
  .findings-table thead th {
    padding-block: 0.875rem;
    color: var(--color-muted);
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.5;
  }
  .findings-table thead th:first-child {
    width: var(--findings-topic);
    border-top-left-radius: var(--radius-card);
    background: var(--color-canvas);
  }
  .findings-table thead th:last-child {
    color: var(--color-ink);
  }
  .findings-table tbody th,
  .findings-table tbody td:nth-of-type(1) {
    border-top: 1px solid var(--color-line-strong);
  }
  .findings-table tbody th {
    color: var(--color-ink);
    font-weight: 600;
  }
  .findings-table td {
    color: var(--color-ink);
  }
  .findings-table td:nth-of-type(1),
  .findings-table thead th:nth-child(2) {
    background: rgb(255 78 66 / 6%);
  }
  @media (min-width: 56.3rem) {
    .findings-table thead th:nth-child(2) {
      border-top-right-radius: var(--radius-card);
    }
    .findings-table tbody tr:last-child td:nth-of-type(1) {
      border-bottom-right-radius: var(--radius-card);
    }
    /* The new-state cells sit above the lifted card. */
    .findings-table thead th:last-child,
    .findings-table td:last-child {
      position: relative;
      z-index: 3;
    }
    .findings-table tbody td:last-child::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 1px;
      background: rgb(12 206 107 / 22%);
    }
    /* The lifted card: in front of the left card's edge, larger than the column on every side. */
    .findings-wrap::before {
      content: "";
      position: absolute;
      top: calc(-1 * var(--findings-lift));
      right: calc(-1 * var(--findings-lift));
      bottom: calc(-1 * var(--findings-lift));
      left: calc(var(--findings-split) - var(--findings-lift));
      z-index: 2;
      border-radius: var(--radius-card);
      background: rgb(240 251 245);
      box-shadow:
        0 0 0 1px rgb(12 206 107 / 30%),
        0 2px 4px rgb(0 0 0 / 6%),
        0 24px 48px -16px rgb(0 0 0 / 28%);
    }
    /* The border of the left card, drawn above the cell backgrounds. */
    .findings-wrap::after {
      content: "";
      position: absolute;
      inset: 0 calc(100% - var(--findings-split)) 0 0;
      z-index: 1;
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-card);
      pointer-events: none;
    }
  }
  @media (max-width: 56.25rem) {
    .findings-wrap {
      overflow: hidden;
      border: 1px solid var(--color-line-strong);
      border-radius: var(--radius-card);
    }
    .findings-table td:last-child {
      background: rgb(12 206 107 / 6%);
    }
    .findings-table tbody td:nth-of-type(1) {
      border-top: 0;
    }
    .findings-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .findings-table tbody,
    .findings-table tr,
    .findings-table th,
    .findings-table td {
      display: block;
    }
    .findings-table tbody tr:first-child th {
      border-top: 0;
    }
    .findings-table tbody th {
      padding-bottom: 0.25rem;
    }
    .findings-table td {
      padding-block: 0.75rem;
    }
    .findings-table td:last-child {
      padding-bottom: 1.25rem;
    }
    .findings-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.125rem;
      color: var(--color-muted);
      font-size: var(--text-meta);
      font-weight: 600;
    }
  }
  /* A dated log: the date sits left of a vertical line, each entry has a dot on that line. */
  .project-log__entry {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 1.5rem;
  }
  .project-log__date {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .project-log__body {
    position: relative;
    padding: 0 0 2.75rem 2rem;
  }
  .project-log__body::before {
    content: "";
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-ink);
  }
  .project-log__body::after {
    content: "";
    position: absolute;
    top: 1.45rem;
    bottom: 0.25rem;
    left: calc(0.375rem - 1px);
    width: 2px;
    background: var(--color-line-strong);
  }
  .project-log__entry:last-child .project-log__body {
    padding-bottom: 0;
  }
  .project-log__entry:last-child .project-log__body::before {
    background: #0cce6b;
  }
  .project-log__entry:last-child .project-log__body::after {
    content: none;
  }
  @media (max-width: 40rem) {
    .project-log__entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.25rem;
    }
    .project-log__date {
      padding-left: 2rem;
    }
  }
  .desktop-figure {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lh-figure--pass {
    color: #0cce6b;
  }
  .lh-figure--average {
    color: #ffa400;
  }
  .lh-figure--fail {
    color: #ff4e42;
  }
  .lh-zone--pass {
    background: #0cce6b;
  }
  .lh-zone--average {
    background: #ffa400;
  }
  .lh-zone--fail {
    background: #ff4e42;
  }
  .lcp-mark {
    position: absolute;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    border: 3px solid #000;
    border-radius: 999px;
    background: #fff;
    transform: translate(-50%, -50%);
  }
  .lcp-mark__label {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    font-size: var(--text-ui);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transform: translateX(-50%);
  }
  /* The old value sits near the right end, so its label ends at the marker. */
  .lcp-mark--poor .lcp-mark__label {
    right: -0.5rem;
    left: auto;
    transform: none;
  }
  .score-track,
  .score-axis {
    --score-inset: 1.25rem;
  }
  .score-track {
    /* Lighthouse zones from 40 to 100: red below 50, orange below 90, green from 90.
       The zone edges sit on the same inset scale as the dots. */
