---
import { Maximize2 } from "@lucide/astro";
import CtaButton from "@/components/cta-button.astro";
import ImageViewer from "@/components/image-viewer.astro";
import LighthouseGauge from "@/components/lighthouse-gauge.astro";
import { getReferencesCopy, handwerkerWorkMeasurements as measured } from "@/i18n/references";
import { localizePath, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { teaser: copy, handwerkerWork } = getReferencesCopy(locale);
const lh = handwerkerWork.lighthouse;
// The same before and after shots as the reference page, so the homepage shows the change itself.
const shots = [
  {
    base: "/references/handwerker-work-before",
    full: "/references/handwerker-work-before-1440.webp",
    ...handwerkerWork.beforeShot,
    text: handwerkerWork.beforeShot.findings,
  },
  {
    base: "/references/handwerker-work-preview",
    full: "/references/handwerker-work-preview-2880.webp",
    ...handwerkerWork.afterShot,
    text: handwerkerWork.afterShot.changes,
  },
];
const gauges = [
  { name: lh.performance, scores: measured.scores.performance },
  { name: lh.accessibility, scores: measured.scores.accessibility },
  { name: lh.seo, scores: measured.scores.seo },
];
---

<section class="bg-black px-page py-section text-inverse" aria-labelledby="reference-teaser-heading">
  <div class="mx-auto max-w-layout">
    <div class="reveal mx-auto max-w-[44rem] text-center" data-reveal>
      <h2 id="reference-teaser-heading" class="m-0 text-heading-lg text-balance text-white">
        {copy.heading}
      </h2>
      <p class="mt-4 text-lg/7 text-inverse-muted">{copy.text}</p>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-x-8 gap-y-12 max-nav:grid-cols-1">
      {shots.map((shot, index) => (
        <figure class="reveal m-0" data-reveal style={{ "--reveal-delay": `${index * 80}ms` }}>
          <button
            type="button"
            aria-haspopup="dialog"
            data-image-viewer
            data-src={shot.full}
            data-alt={shot.alt}
            data-caption={shot.caption}
            data-ratio="1.6"
            class="group/shot relative block w-full cursor-zoom-in rounded-shell text-left"
          >
            <picture class="block overflow-hidden rounded-shell shadow-floating">
              <source
                type="image/avif"
                srcset={`${shot.base}-720.avif 720w, ${shot.base}-1440.avif 1440w`}
                sizes="(max-width: 900px) 100vw, 37rem"
              />
              <img
                src={`${shot.base}-1440.webp`}
                srcset={`${shot.base}-720.webp 720w, ${shot.base}-1440.webp 1440w`}
                sizes="(max-width: 900px) 100vw, 37rem"
                width="1440"
                height="900"
                alt={shot.alt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
            </picture>
            <span class="absolute right-3 bottom-3 inline-flex size-10 items-center justify-center rounded-pill bg-inverse-surface/80 text-inverse opacity-80 transition-opacity duration-150 group-hover/shot:opacity-100">
              <Maximize2 aria-hidden="true" class="size-4" stroke-width={1.8} />
              <span class="sr-only">{handwerkerWork.viewer.open}</span>
            </span>
          </button>
          <figcaption class="mt-5">
            <span class="block text-heading-sm text-white">{shot.caption}</span>
            <span class="mt-2 block max-w-[34rem] text-base/6 text-inverse-muted">{shot.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="reveal mx-auto mt-16 max-w-[62rem]" data-reveal>
      <div class="grid grid-cols-3 gap-6 max-narrow:gap-3">
        {gauges.map((gauge) => (
          <LighthouseGauge
            score={gauge.scores[1]}
            before={gauge.scores[0]}
            label={gauge.name}
            beforeLabel={lh.before}
          />
        ))}
      </div>
      <p class="mt-6 text-center text-meta text-inverse-muted">{lh.legend}</p>
      <div class="mt-10 flex justify-center">
        <CtaButton href={localizePath("/references/handwerker-work", locale)} light>
          {copy.link}
        </CtaButton>
      </div>
    </div>
  </div>
  <ImageViewer labels={handwerkerWork.viewer} />
</section>
