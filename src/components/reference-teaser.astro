---
import { ArrowUpRight } from "@lucide/astro";
import Reveal from "@/components/reveal.astro";
import { getReferencesCopy, handwerkerWorkMeasurements as measured } from "@/i18n/references";
import { localizePath, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { teaser: copy, handwerkerWork } = getReferencesCopy(locale);
const [before, after] = measured.pages.home;
---

<section class="px-page py-section" aria-labelledby="reference-teaser-heading">
  <Reveal className="mx-auto grid max-w-[70rem] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]">
    <div class="min-w-0">
      <p class="mt-0 mb-4 text-meta text-muted">{copy.eyebrow}</p>
      <h2 id="reference-teaser-heading" class="m-0 max-w-[28ch] text-heading-lg">
        {copy.heading}
      </h2>
      <p class="mt-6 max-w-narrow text-lg/7 text-muted">{copy.text}</p>
      <dl class="my-8 grid gap-6 sm:grid-cols-3">
        {[
          [`${before} → ${after}`, copy.performance],
          [copy.urlsFigure, copy.urlsLabel],
          [copy.indexedFigure, copy.indexedLabel],
        ].map(([figure, label]) => (
          <div class="min-w-0">
            <dt class="text-heading-sm font-semibold">{figure}</dt>
            <dd class="m-0 mt-2 text-sm text-muted">{label}</dd>
          </div>
        ))}
      </dl>
      <a
        href={localizePath("/references/handwerker-work", locale)}
        class="inline-flex items-center gap-2 font-medium underline underline-offset-4 hover:text-muted"
      >
        {copy.link}
        <ArrowUpRight class="size-5 shrink-0" aria-hidden="true" />
      </a>
    </div>
    <figure class="m-0 min-w-0">
      <div class="overflow-hidden rounded-card shadow-surface">
        <picture>
          <source
            type="image/avif"
            srcset="/references/handwerker-work-before-720.avif 720w, /references/handwerker-work-before-1440.avif 1440w"
            sizes="(min-width: 1024px) 30rem, 100vw"
          />
          <img
            class="block h-auto w-full"
            src="/references/handwerker-work-before-1440.webp"
            srcset="/references/handwerker-work-before-720.webp 720w, /references/handwerker-work-before-1440.webp 1440w"
            sizes="(min-width: 1024px) 30rem, 100vw"
            width="1440"
            height="900"
            alt={handwerkerWork.beforeShot.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <figcaption class="mt-3 text-meta text-muted">{handwerkerWork.beforeShot.caption}</figcaption>
    </figure>
  </Reveal>
</section>
