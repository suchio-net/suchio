---
import CtaButton from "@/components/cta-button.astro";
import WhatsAppButton from "@/components/whatsapp-button.astro";
import { localizePath, t, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
  singleLine?: boolean;
  /** Page-specific copy; the site-wide closing copy is used for anything left out. */
  title?: string;
  copy?: string;
  button?: string;
  href?: string;
}
const {
  locale,
  singleLine = false,
  title = t(locale, "finalCta.title"),
  copy = t(locale, "finalCta.copy"),
  button = t(locale, "home.ctaContact"),
  href = localizePath("/contact", locale),
} = Astro.props;
---

<section class="flex min-h-[28rem] flex-col items-center justify-center bg-black px-page py-section text-center text-inverse">
  <div class="reveal min-w-0 w-full" data-reveal>
    <h2
      class={`mx-auto text-display-sm text-white ${singleLine ? "w-max max-w-full whitespace-nowrap max-nav:w-auto max-nav:whitespace-normal" : "max-w-[18ch]"}`}
    >
      {title}
    </h2>
    <p class="mx-auto mt-6 mb-7 max-w-[35rem] text-lg/7 text-inverse-muted">{copy}</p>
    <div class="flex justify-center gap-3">
      <CtaButton href={href} light className="[&>span:first-child]:min-w-0">
        {button}
      </CtaButton>
      <WhatsAppButton locale={locale} />
    </div>
  </div>
</section>
