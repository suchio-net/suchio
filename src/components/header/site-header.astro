---
import { ArrowUpRight, ChevronDown, ChevronLeft, ChevronRight } from "@lucide/astro";
import BrandMark from "@/components/brand-mark.astro";
import CtaButton from "@/components/cta-button.astro";
import LanguageMenu from "@/components/header/language-menu.astro";
import WhatsAppButton from "@/components/whatsapp-button.astro";
import { localeConfig, locales } from "@/i18n/config";
import { publicContactEmail } from "@/lib/contact";
import { t, type Locale } from "@/lib/i18n";
import { alternatePath, localizePath } from "@/lib/locale-path";
import { getSubServiceCopy } from "@/i18n/sub-services";
import { getServiceCatalog } from "@/lib/service-catalog";
import { getSubServicePath, subServiceRoutes } from "@/lib/sub-service-routes";
interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
const services = getServiceCatalog(locale);
// The industry concepts under /examples are part of the references page, so that tab marks them too.
const navItems = [
  {
    href: localizePath("/references", locale),
    label: t(locale, "nav.references"),
    also: [localizePath("/examples", locale)],
  },
  { href: localizePath("/about", locale), label: t(locale, "nav.about") },
  { href: localizePath("/contact", locale), label: t(locale, "nav.contact") },
];
const within = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const isActive = (href: string) =>
  within(href) || (navItems.find((item) => item.href === href)?.also ?? []).some(within);
const servicesActive =
  pathname === localizePath("/services", locale) || pathname.startsWith(`${localizePath("/services", locale)}/`);
const selectLocale = t(locale, "nav.selectLocale");
const pressable = "active:scale-[.96] motion-reduce:transition-none motion-reduce:active:scale-100";
// The area of the current page gets a dot in the first level of the phone menu.
const isCurrentArea = (area: string, href: string) =>
  pathname === href ||
  subServiceRoutes.some((route) => route.area === area && getSubServicePath(route.id, locale) === pathname);
const menuView =
  "absolute inset-x-0 top-0 px-1 pt-1 pb-3 opacity-0 transition-[translate,opacity] duration-[280ms] ease-[var(--ease-out)] data-open:translate-x-0 data-open:opacity-100 motion-reduce:transition-none";
const menuRow =
  "flex min-h-[46px] w-full cursor-pointer items-center justify-between gap-2 rounded-inset px-2 py-1.5 text-left text-lg/[1.2] font-semibold tracking-[-0.015em] transition-colors duration-150 hover:bg-interaction active:bg-interaction motion-reduce:transition-none";
---

<noscript>
  <style is:inline>
    [data-navigation-enhanced] {
      display: none !important;
    }
  </style>
  <nav
    data-navigation-fallback
    aria-label={t(locale, "nav.mainMenu")}
    class="fixed inset-x-4 top-6 z-50 max-h-[80vh] overflow-y-auto rounded-control bg-white p-3 shadow-floating"
  >
    <details>
      <summary class="min-h-11 cursor-pointer text-sm font-medium">{t(locale, "nav.mainMenu")}</summary>
      <div class="grid min-w-0 gap-2 py-2 text-sm">
        <a class="py-2" href={localizePath("/", locale)}>
          {t(locale, "nav.brandHome")}
        </a>
        {services.map((service) => (
          <a class="py-2" href={service.href}>
            {service.copy.name}
          </a>
        ))}
        {navItems.map((item) => (
          <a class="py-2" href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
        <span class="mt-2 font-medium">{selectLocale}</span>
        {locales.map((candidate) => (
          <a
            class="py-2"
            href={alternatePath(pathname, candidate)}
            hreflang={candidate}
            lang={candidate}
            aria-current={candidate === locale ? "page" : undefined}
          >
            {localeConfig[candidate].name}
          </a>
        ))}
      </div>
    </details>
  </nav>
</noscript>

<header
  data-navigation-enhanced
  class="fixed top-[max(1rem,env(safe-area-inset-top))] left-1/2 z-50 flex w-max -translate-x-1/2 items-center gap-2 transition-[opacity,transform] duration-[550ms] ease-[var(--ease-out)] max-nav:right-3 max-nav:left-3 max-nav:block max-nav:w-auto max-nav:[translate:none] nav:top-[max(1.5rem,env(safe-area-inset-top))] data-scrolling:duration-[260ms] data-scrolling:ease-[cubic-bezier(.4,0,.2,1)] motion-safe:data-scrolling:pointer-events-none motion-safe:data-scrolling:[transform:translateY(-0.75rem)] motion-safe:data-scrolling:opacity-0"
>
  <a
    href={localizePath("/", locale)}
    class={`group/brand inline-flex h-11 min-w-0 items-center justify-center rounded-control bg-white px-4.5 shadow-surface transition-[transform,box-shadow] duration-150 hover:shadow-surface-hover ${pressable} max-nav:hidden`}
    aria-label={t(locale, "nav.brandHome")}
    data-scroll-top
  >
    <BrandMark />
  </a>
  <nav
    class="relative inline-flex h-11 items-center justify-center gap-px rounded-control bg-white p-1 shadow-surface max-nav:hidden"
    aria-label={t(locale, "nav.mainMenu")}
  >
    <div data-services>
      <button
        class={`group/services relative z-1 inline-flex h-9 cursor-pointer items-center gap-1 rounded-inset px-3.5 text-sm font-medium transition-[color,background-color,scale] duration-150 ${pressable} ${servicesActive ? "bg-interaction text-ink" : "text-muted hover:bg-interaction hover:text-ink aria-expanded:bg-interaction aria-expanded:text-ink"}`}
        type="button"
        aria-expanded="false"
        aria-controls="services-menu"
      >
        {t(locale, "nav.services")}
        <ChevronDown
          class="size-3.5 transition-transform duration-200 group-aria-expanded/services:rotate-180 motion-reduce:transition-none max-narrow:hidden"
          stroke-width={1.8}
          aria-hidden="true"
        />
      </button>
      <div
        id="services-menu"
        class="pointer-events-none absolute top-full left-1/2 w-[min(70rem,calc(100vw-3rem))] -translate-x-1/2 -translate-y-1 pt-3 opacity-0 transition-[opacity,translate] duration-200 ease-[var(--ease-out)] will-change-[opacity,translate] data-open:pointer-events-auto data-open:translate-y-0 data-open:opacity-100 motion-reduce:duration-0"
        aria-hidden="true"
        inert
      >
        <div class="rounded-shell bg-white shadow-floating">
          <div class="grid grid-cols-[repeat(5,auto)] px-3 py-4">
            {services.map((service) => {
              const active = pathname === service.href;
              return (
                <div class="min-w-0 border-l border-line px-2 first:border-l-0">
                  <a
                    class="group/area mb-1 flex items-start gap-1 rounded-inset px-2 py-1.5 text-sm/snug font-semibold text-ink transition-colors duration-150 hover:bg-interaction"
                    href={service.href}
                    aria-current={active ? "page" : undefined}
                    data-scroll-top
                  >
                    <span class="min-w-0">{service.copy.name}</span>
                    {active ? (
                      <span class="mt-[7px] ml-0.5 size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />
                    ) : (
                      <ArrowUpRight
                        class="mt-[3px] size-3.5 shrink-0 text-subtle transition-[color,translate] duration-150 ease-[var(--ease-out)] group-hover/area:translate-x-0.5 group-hover/area:-translate-y-0.5 group-hover/area:text-ink motion-reduce:transition-none motion-reduce:group-hover/area:translate-x-0 motion-reduce:group-hover/area:translate-y-0"
                        stroke-width={1.8}
                        aria-hidden="true"
                      />
                    )}
                  </a>
                  <ul class="m-0 grid list-none gap-px p-0">
                    {subServiceRoutes
                      .filter((route) => route.area === service.id)
                      .map(({ id }) => {
                        const href = getSubServicePath(id, locale);
                        const current = pathname === href;
                        return (
                          <li>
                            <a
                              class={`group/link flex items-start justify-between gap-2 rounded-inset px-2 py-1.5 text-meta leading-snug transition-colors duration-150 hover:bg-interaction hover:text-ink ${current ? "font-medium text-ink" : "text-neutral-700"}`}
                              href={href}
                              aria-current={current ? "page" : undefined}
                              data-scroll-top
                            >
                              <span class="min-w-0">
                                {getSubServiceCopy(locale, id).name}
                                {current && (
                                  <span
                                    class="ml-1.5 inline-block size-1.5 rounded-full bg-ink align-middle"
                                    aria-hidden="true"
                                  />
                                )}
                              </span>
                              {!current && (
                                <ArrowUpRight
                                  class="mt-[3px] size-3.5 shrink-0 opacity-0 transition-opacity duration-150 group-hover/link:opacity-100 group-focus-visible/link:opacity-100 motion-reduce:transition-none"
                                  stroke-width={1.8}
                                  aria-hidden="true"
                                />
                              )}
                            </a>
                          </li>
                        );
                      })}
                  </ul>
                </div>
              );
            })}
          </div>
          <div class="flex justify-end border-t border-line px-5 py-2.5">
            <a
              class="group/all inline-flex items-center gap-1 text-meta font-medium text-muted transition-colors duration-150 hover:text-ink"
              href={localizePath("/services", locale)}
              data-scroll-top
            >
              {t(locale, "service.allServices")}
              <ArrowUpRight
                class="size-3.5 transition-transform duration-150 ease-[var(--ease-out)] group-hover/all:translate-x-0.5 group-hover/all:-translate-y-0.5 motion-reduce:transform-none motion-reduce:transition-none"
                stroke-width={1.8}
                aria-hidden="true"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`relative z-1 inline-flex h-9 items-center rounded-inset px-3.5 text-sm font-medium transition-[color,background-color,scale] duration-150 ${pressable} ${isActive(item.href) ? "bg-interaction text-ink" : "text-muted hover:bg-interaction hover:text-ink"}`}
        aria-current={isActive(item.href) ? "page" : undefined}
        data-scroll-top
      >
        {item.label}
      </a>
    ))}
  </nav>
  <LanguageMenu id="desktop-language-menu" locale={locale} pathname={pathname} label={selectLocale} />
  <nav
    class="overflow-hidden rounded-shell bg-white shadow-surface transition-shadow duration-200 data-open:shadow-floating motion-reduce:transition-none nav:hidden"
    aria-label={t(locale, "nav.mainMenu")}
    data-mobile-nav
  >
    <div class="flex h-12 items-center pl-3">
      <a
        href={localizePath("/", locale)}
        class={`inline-flex h-11 min-w-0 items-center rounded-inset transition-transform duration-150 ${pressable}`}
        aria-label={t(locale, "nav.brandHome")}
        data-scroll-top
      >
        <BrandMark />
      </a>
      <button
        class="group/burger relative ml-auto size-11 shrink-0 cursor-pointer rounded-control"
        type="button"
        aria-label={t(locale, "nav.openMenu")}
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
        data-label-open={t(locale, "nav.openMenu")}
        data-label-close={t(locale, "nav.closeMenu")}
      >
        <span
          class="absolute top-1/2 left-[13px] -mt-[.85px] h-[1.7px] w-[18px] -translate-y-[3.5px] rounded-full bg-ink transition-[translate,rotate] duration-[240ms] ease-[var(--ease-out)] group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:rotate-45 motion-reduce:transition-none"
          aria-hidden="true"
        ></span>
        <span
          class="absolute top-1/2 left-[13px] -mt-[.85px] h-[1.7px] w-[18px] translate-y-[3.5px] rounded-full bg-ink transition-[translate,rotate] duration-[240ms] ease-[var(--ease-out)] group-aria-expanded/burger:translate-y-0 group-aria-expanded/burger:-rotate-45 motion-reduce:transition-none"
          aria-hidden="true"
        ></span>
      </button>
    </div>
    <div
      id="site-menu"
      class="h-0 max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain opacity-0 transition-[height,opacity] duration-[280ms] ease-[var(--ease-out)] data-open:opacity-100 motion-reduce:transition-none"
      aria-hidden="true"
      inert
    >
      <div
        class="relative overflow-hidden transition-[height] duration-[280ms] ease-[var(--ease-out)] motion-reduce:transition-none"
        data-menu-views
      >
        <div class={`-translate-x-[30%] ${menuView}`} data-menu-view data-open>
          {services.map((service) => (
            <button class={menuRow} type="button" aria-controls={`menu-area-${service.id}`} data-menu-area>
              <span class="min-w-0">{service.copy.name}</span>
              <span class="flex shrink-0 items-center gap-2">
                {isCurrentArea(service.id, service.href) && (
                  <span class="size-1.5 rounded-full bg-ink" aria-hidden="true" />
                )}
                <ChevronRight class="size-[18px] text-subtle" stroke-width={1.7} aria-hidden="true" />
              </span>
            </button>
          ))}
          <a
            class={`${menuRow} !min-h-11 !text-ui !font-medium !tracking-[-0.01em] !text-muted`}
            href={localizePath("/services", locale)}
            aria-current={pathname === localizePath("/services", locale) ? "page" : undefined}
            data-scroll-top
          >
            <span class="min-w-0">{t(locale, "service.allServices")}</span>
            {pathname === localizePath("/services", locale) ? (
              <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />
            ) : (
              <ArrowUpRight class="size-4 shrink-0 text-subtle" stroke-width={1.7} aria-hidden="true" />
            )}
          </a>
          <div class="h-2.5"></div>
          {navItems
            .filter((item) => item.href !== localizePath("/contact", locale))
            .map((item) => (
              <a
                class={menuRow}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                data-scroll-top
              >
                <span class="min-w-0">{item.label}</span>
                {isActive(item.href) && <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />}
              </a>
            ))}
        </div>
        {services.map((service) => (
          <div id={`menu-area-${service.id}`} class={`translate-x-full ${menuView}`} data-menu-view inert>
            <button
              class="flex h-10 cursor-pointer items-center gap-0.5 pr-2 pl-[3px] text-sm font-medium text-muted"
              type="button"
              data-menu-back
            >
              <ChevronLeft class="size-[18px]" stroke-width={1.7} aria-hidden="true" />
              {t(locale, "nav.back")}
            </button>
            <a
              class="mb-2 flex items-center justify-between gap-2 rounded-inset px-2 py-0.5 text-heading-md"
              href={service.href}
              aria-current={pathname === service.href ? "page" : undefined}
              data-scroll-top
            >
              <span class="min-w-0">{service.copy.name}</span>
              {pathname === service.href ? (
                <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />
              ) : (
                <ArrowUpRight class="size-5 shrink-0 text-subtle" stroke-width={1.7} aria-hidden="true" />
              )}
            </a>
            <ul class="m-0 list-none p-0">
              {subServiceRoutes
                .filter((route) => route.area === service.id)
                .map(({ id }) => {
                  const href = getSubServicePath(id, locale);
                  const current = pathname === href;
                  return (
                    <li>
                      <a
                        class={`${menuRow} !min-h-11 !text-base !tracking-[-0.01em] ${current ? "" : "!font-medium"}`}
                        href={href}
                        aria-current={current ? "page" : undefined}
                        data-scroll-top
                      >
                        <span class="min-w-0">{getSubServiceCopy(locale, id).name}</span>
                        {current && <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />}
                      </a>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))}
      </div>
      <div class="px-2 pb-1.5" data-menu-foot>
        <div class="flex gap-2">
          <CtaButton
            href={localizePath("/contact", locale)}
            className="!flex-nowrap !gap-2 whitespace-nowrap !pl-3.5 max-narrow:flex-1"
          >
            {t(locale, "nav.cta")}
          </CtaButton>
          <WhatsAppButton locale={locale} />
        </div>
        <div class="flex items-center justify-between px-1 pt-1">
          <div class="flex text-meta font-semibold text-subtle" role="group" aria-label={selectLocale}>
            {locales.map((candidate) => (
              <a
                class="grid h-11 min-w-8 place-items-center justify-items-start aria-[current=page]:text-ink"
                href={alternatePath(pathname, candidate)}
                hreflang={candidate}
                lang={candidate}
                aria-label={localeConfig[candidate].name}
                aria-current={candidate === locale ? "page" : undefined}
                data-menu-locale={candidate}
              >
                {localeConfig[candidate].shortLabel}
              </a>
            ))}
          </div>
          <a class="text-meta text-muted" href={`mailto:${publicContactEmail}`}>
            {publicContactEmail}
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<div
  class="pointer-events-none fixed inset-0 z-40 touch-none bg-neutral-900/24 opacity-0 transition-opacity duration-200 ease-[var(--ease-out)] data-open:pointer-events-auto data-open:opacity-100 motion-reduce:transition-none nav:hidden"
  aria-hidden="true"
  data-menu-scrim
></div>

<script>
  import { alternatePath } from "@/lib/locale-path";
  import { rememberLocale } from "@/lib/locale-preference";
  import { hasLocale } from "@/i18n/config";

  const header = document.querySelector<HTMLElement>("[data-navigation-enhanced]")!;
  const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]")!;
  const menu = document.getElementById("site-menu")!;
  const menuScrim = document.querySelector<HTMLElement>("[data-menu-scrim]")!;
  const openButton = header.querySelector<HTMLButtonElement>("[data-menu-open]")!;
  const menuViewport = menu.querySelector<HTMLElement>("[data-menu-views]")!;
  const menuFoot = menu.querySelector<HTMLElement>("[data-menu-foot]")!;
  const menuViews = [...menu.querySelectorAll<HTMLElement>("[data-menu-view]")];
  const menuRoot = menuViews[0]!;
  // Everything next to the header is inert while the menu is open.
  const menuBackground = [...document.body.children].filter(
    (element): element is HTMLElement => element instanceof HTMLElement && element !== header && element !== menuScrim,
  );
  const services = header.querySelector<HTMLElement>("[data-services]")!;
  const servicesButton = services.querySelector<HTMLButtonElement>("button")!;
  const servicesPanel = document.getElementById("services-menu")!;

  /** Opens or closes a disclosure: the trigger's aria-expanded and the panel's data-open, inert and aria-hidden. */
  function setPanel(trigger: HTMLElement, panel: HTMLElement, open: boolean, { hidden = true } = {}) {
    trigger.setAttribute("aria-expanded", String(open));
    panel.toggleAttribute("data-open", open);
    panel.inert = !open;
    if (hidden) panel.setAttribute("aria-hidden", String(!open));
  }
  const isOpen = (trigger: HTMLElement) => trigger.getAttribute("aria-expanded") === "true";
  const isPlainClick = (event: MouseEvent) =>
    event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;

  // A link to the current page scrolls back to the top instead of reloading it.
  function scrollToPageTop(event: MouseEvent, link: HTMLAnchorElement) {
    if (!isPlainClick(event) || event.defaultPrevented) return;
    const destination = new URL(link.href);
    if (
      destination.pathname + destination.search + destination.hash !==
      location.pathname + location.search + location.hash
    )
      return;
    event.preventDefault();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    scrollTo({ top: 0, left: 0, behavior: reducedMotion ? "auto" : "smooth" });
  }

  // Site menu (below the navigation breakpoint): the header bar grows into a panel with two levels.
  function fitMenu() {
    const height = menuViews.find((view) => view.hasAttribute("data-open"))!.offsetHeight;
    menuViewport.style.height = `${height}px`;
    menu.style.height = isOpen(openButton) ? `${height + menuFoot.offsetHeight}px` : "0px";
  }
  function showMenuView(target: HTMLElement) {
    for (const view of menuViews) {
      view.toggleAttribute("data-open", view === target);
      view.inert = view !== target;
    }
    menu.scrollTop = 0;
    fitMenu();
  }
  function setMenu(open: boolean, { restoreFocus = false } = {}) {
    setPanel(openButton, menu, open);
    openButton.setAttribute("aria-label", (open ? openButton.dataset.labelClose : openButton.dataset.labelOpen) ?? "");
    mobileNav.toggleAttribute("data-open", open);
    menuScrim.toggleAttribute("data-open", open);
    document.body.style.overflow = open ? "hidden" : "";
    for (const element of menuBackground) element.inert = open;
    showMenuView(menuRoot);
    if (restoreFocus) openButton.focus();
  }
  // The element that opened the current second level. Focus returns to it.
  function closeMenuArea() {
    const area = menuViews.find((view) => view.hasAttribute("data-open"))!;
    showMenuView(menuRoot);
    menu.querySelector<HTMLElement>(`[aria-controls="${area.id}"]`)?.focus({ preventScroll: true });
  }
  openButton.addEventListener("click", () => setMenu(!isOpen(openButton)));
  menuScrim.addEventListener("click", () => setMenu(false));
  for (const button of menu.querySelectorAll<HTMLButtonElement>("[data-menu-area]")) {
    button.addEventListener("click", () => {
      const area = document.getElementById(button.getAttribute("aria-controls")!)!;
      showMenuView(area);
      area.querySelector<HTMLElement>("[data-menu-back]")?.focus({ preventScroll: true });
    });
  }
  for (const button of menu.querySelectorAll<HTMLButtonElement>("[data-menu-back]")) {
    button.addEventListener("click", closeMenuArea);
  }
  // The capture phase unlocks page scrolling before a link to the current page scrolls back to the top.
  mobileNav.addEventListener(
    "click",
    (event) => {
      if ((event.target as Element).closest("a")) setMenu(false);
    },
    true,
  );
  for (const link of menu.querySelectorAll<HTMLAnchorElement>("[data-menu-locale]")) {
    const locale = link.dataset.menuLocale ?? "";
    if (!hasLocale(locale)) continue;
    // The error page can be served at any missing URL; switching language keeps that URL.
    link.href = alternatePath(location.pathname, locale) + location.search + location.hash;
    link.addEventListener("click", (event) => {
      if (isPlainClick(event)) rememberLocale(locale);
      scrollToPageTop(event, link);
    });
  }
  addEventListener("resize", () => {
    if (isOpen(openButton)) fitMenu();
  });
  matchMedia("(min-width: 900px)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });

  // Services dropdown: opens on mouse hover, click and ArrowDown.
  let servicesOpenedByHover = false;
  let closeServicesTimer: number | undefined;
  const setServices = (open: boolean) => {
    window.clearTimeout(closeServicesTimer);
    setPanel(servicesButton, servicesPanel, open);
  };
  services.addEventListener("pointerenter", (event) => {
    if (event.pointerType !== "mouse") return;
    servicesOpenedByHover = !isOpen(servicesButton);
    setServices(true);
  });
  services.addEventListener("pointerleave", () => {
    closeServicesTimer = window.setTimeout(() => setServices(false), 120);
  });
  services.addEventListener("focusout", (event) => {
    if (!services.contains(event.relatedTarget as Node | null)) setServices(false);
  });
  servicesButton.addEventListener("click", () => {
    const keepOpen = servicesOpenedByHover;
    servicesOpenedByHover = false;
    setServices(keepOpen || !isOpen(servicesButton));
  });
  servicesButton.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown") return;
    event.preventDefault();
    setServices(true);
    window.setTimeout(() => servicesPanel.querySelector<HTMLAnchorElement>("a[href]")?.focus(), 0);
  });
  for (const link of servicesPanel.querySelectorAll("a")) link.addEventListener("click", () => setServices(false));
  document.addEventListener("pointerdown", (event) => {
    if (isOpen(servicesButton) && !services.contains(event.target as Node)) setServices(false);
  });

  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-scroll-top]")) {
    link.addEventListener("click", (event) => scrollToPageTop(event, link));
  }

  // The header hides after 60px of scrolling down. It returns on any upward scroll or after a 1s pause.
  // It stays visible while one of its menus is open or a keyboard user has focus inside it.
  let lastScrollY = scrollY;
  let scrolledDown = 0;
  let scrollPauseTimer: number | undefined;
  const showHeader = () => {
    scrolledDown = 0;
    header.removeAttribute("data-scrolling");
  };
  addEventListener(
    "scroll",
    () => {
      const delta = scrollY - lastScrollY;
      lastScrollY = scrollY;
      window.clearTimeout(scrollPauseTimer);
      if (delta < 0) {
        showHeader();
        return;
      }
      scrolledDown += delta;
      if (scrolledDown >= 60 && !header.querySelector('[aria-expanded="true"], :focus-visible'))
        header.toggleAttribute("data-scrolling", true);
      scrollPauseTimer = window.setTimeout(showHeader, 1000);
    },
    { passive: true },
  );
  header.addEventListener("focusin", showHeader);

  // Escape closes the innermost open layer; Tab stays inside the open site menu.
  document.addEventListener("keydown", (event) => {
    const menuOpen = isOpen(openButton);
    if (event.key === "Escape") {
      if (menuOpen && !menuRoot.hasAttribute("data-open")) {
        closeMenuArea();
      } else if (isOpen(servicesButton)) {
        setServices(false);
        servicesButton.focus();
      } else if (menuOpen) {
        setMenu(false, { restoreFocus: true });
      }
      return;
    }
    if (!menuOpen || event.key !== "Tab") return;
    const focusables = [
      ...mobileNav.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'),
    ].filter((element) => !element.closest("[inert]"));
    const first = focusables[0];
    const last = focusables.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // Language menus: a hovered or focused language previews its code in the button.
  for (const root of document.querySelectorAll<HTMLElement>("[data-language-menu]")) {
    const button = root.querySelector<HTMLButtonElement>("button")!;
    const panel = root.querySelector<HTMLElement>("[id]")!;
    const code = root.querySelector<HTMLElement>("[data-language-code]")!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-locale-link]")];
    const current = root.dataset.locale!;
    let openedByHover = false;

    function highlight(locale: string | null) {
      for (const link of links) {
        link.toggleAttribute("data-highlighted", link.dataset.localeLink === (locale ?? current));
      }
      code.querySelector("[data-preview]")?.remove();
      const previewing = locale !== null && locale !== current;
      button.toggleAttribute("data-previewing", previewing);
      if (!previewing) return;
      // A new element replays the entrance animation for each previewed language.
      const preview = document.createElement("span");
      preview.className = "header-language__code-preview col-start-1 row-start-1";
      preview.dataset.preview = "";
      preview.textContent = links.find((link) => link.dataset.localeLink === locale)?.dataset.shortLabel ?? "";
      code.appendChild(preview);
    }
    function setOpen(open: boolean) {
      setPanel(button, panel, open);
      if (!open) highlight(null);
    }

    root.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      openedByHover = !isOpen(button);
      setPanel(button, panel, true);
    });
    root.addEventListener("pointerleave", () => setOpen(false));
    root.addEventListener("focusout", (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    root.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen(button)) return;
      event.preventDefault();
      event.stopPropagation();
      setOpen(false);
      button.focus();
    });
    button.addEventListener("click", () => {
      const keepOpen = openedByHover;
      openedByHover = false;
      setOpen(keepOpen || !isOpen(button));
    });
    button.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      event.preventDefault();
      setPanel(button, panel, true);
      window.setTimeout(() => links[0]?.focus(), 0);
    });
    for (const link of links) {
      const locale = link.dataset.localeLink ?? "";
      if (!hasLocale(locale)) continue;
      // The error page can be served at any missing URL; switching language keeps that URL.
      // The query and fragment carry context such as the service a contact link preselected.
      link.href = alternatePath(location.pathname, locale) + location.search + location.hash;
      link.addEventListener("pointerenter", () => highlight(locale));
      link.addEventListener("pointerleave", () => highlight(null));
      link.addEventListener("focus", () => highlight(locale));
      link.addEventListener("blur", () => highlight(null));
      link.addEventListener("click", (event) => {
        if (isPlainClick(event)) rememberLocale(locale);
        scrollToPageTop(event, link);
        setOpen(false);
      });
    }
  }
</script>
