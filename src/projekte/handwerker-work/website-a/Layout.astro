---
import DraftTools from "@/projekte/handwerker-work/shared/DraftTools.astro";
import { draftSchema } from "../shared/schema";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Lightbox from "./Lightbox.astro";
import { assetBase, base, company, sections } from "./data";
import "./theme.css";

interface Props {
  title: string;
  description: string;
  /** Page path within this website, used for canonical and og:url. */
  livePath: string;
  schema?: Record<string, unknown>[];
  current?: string;
  actionBar?: boolean;
  /** Heading of the closing contact section. */
  ctaTitle?: string;
  vorhaben?: string;
}

const { title, description, livePath, schema = [], current, actionBar = true, ctaTitle, vorhaben } = Astro.props;
const ogImage = new URL(`${assetBase}/img/og-handwerker-work.jpg`, Astro.site).href;
const canonical = new URL(`${base}${livePath.replace(/\/$/, "")}`, Astro.site).href;
const fonts = `${base}/fonts`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={`${fonts}/dm-sans-latin-opsz-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={`${fonts}/jetbrains-mono-latin-400-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline>
      @font-face {
        font-family: "DM Sans";
        src: url(/projekte/handwerker-work/website-a/fonts/dm-sans-latin-opsz-normal.woff2) format("woff2");
        font-weight: 100 1000;
        font-display: swap;
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "DM Sans";
        src: url(/projekte/handwerker-work/website-a/fonts/dm-sans-latin-ext-opsz-normal.woff2) format("woff2");
        font-weight: 100 1000;
        font-display: swap;
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20AB, U+20AD-20C0,
          U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "DM Sans Fallback";
        src: local("Arial"), local("Helvetica Neue"), local("Helvetica");
        size-adjust: 101%;
        ascent-override: 92%;
        descent-override: 29%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url(/projekte/handwerker-work/website-a/fonts/jetbrains-mono-latin-400-normal.woff2) format("woff2");
        font-weight: 400;
        font-display: swap;
      }
    </style>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" href={`${assetBase}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {schema.length > 0 && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": draftSchema(schema, base, Astro.site) })}
      />
    )}
  </head>
  <body class:list={{ "has-action-bar": actionBar }}>
    <a class="skip" href="#main">
      Zum Inhalt springen
    </a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer title={ctaTitle} vorhaben={vorhaben} />
    <Lightbox />

    {actionBar && (
      <nav class="action-bar" aria-label="Schnellkontakt">
        <a href={company.phone.href}>Anrufen</a>
        <a href={company.whatsapp.href}>WhatsApp</a>
        <a class="primary" href={sections.kontakt}>
          Anfrage
        </a>
      </nav>
    )}

    <DraftTools version="v1" />

    <script>
      import "./client";
    </script>
  </body>
</html>

<style is:global>
  .action-bar {
    display: none;
  }
  @media (max-width: 760px) {
    .action-bar {
      position: fixed;
      inset: auto 8px calc(8px + env(safe-area-inset-bottom));
      z-index: 45;
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
      background: rgb(11 11 12 / 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition:
        transform 0.6s var(--ease),
        opacity 0.4s;
    }
    .action-bar a {
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      border-radius: 999px;
      color: var(--on-night);
      font-size: 0.88rem;
      font-weight: 500;
      text-decoration: none;
    }
    .action-bar a.primary {
      background: var(--white);
      color: var(--ink);
    }
    .action-bar.hidden {
      transform: translateY(140%);
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
