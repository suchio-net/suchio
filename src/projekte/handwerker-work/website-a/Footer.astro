---
// Black closing section on every page: contact call, the business facts and
// an oversized wordmark that rises in from below.
import Note from "@/projekte/handwerker-work/shared/Note.astro";
import Split from "./Split.astro";
import { company, places, serviceHref, services, tfm } from "./data";

interface Props {
  title?: string;
  vorhaben?: string;
}
const { title = "Projekt besprechen.", vorhaben } = Astro.props;
const href = `mailto:${company.email}?subject=${encodeURIComponent(vorhaben ? `Anfrage: ${vorhaben}` : "Anfrage zur kostenlosen Besichtigung")}`;
---

<footer class="site-footer dark" data-dark>
  <section class="wrap cta" id="kontakt" aria-labelledby="cta-title">
    <p class="index mono">Kontakt</p>
    <Split as="h2" id="cta-title" text={title} class="cta-title" />
    <div class="cta-row" data-reveal>
      <a class="phone" href={company.phone.href}>
        <span class="mono mute">Telefon</span>
        {company.phone.display}
      </a>
      <div class="cta-side">
        <p class="mute">Besichtigung und Angebot sind kostenlos und unverbindlich.</p>
        <div class="actions">
          <a class="btn" href={href}>
            Anfrage per E-Mail<span class="arrow" aria-hidden="true"></span>
          </a>
          <a class="btn btn-line" href={company.whatsapp.href}>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap grid">
    <div class="col">
      <p class="mono mute">Adresse</p>
      <address>
        {company.street}
        <br />
        {company.postalCode} {company.city}
      </address>
      <p class="mono mute coords">
        {company.geo.lat.toFixed(4)}° N · {company.geo.lng.toFixed(4)}° E
      </p>
    </div>
    <div class="col rel">
      <p class="mono mute">Erreichbar</p>
      <dl class="hours">
        {company.hours.map((slot) => (
          <div>
            <dt>{slot.short}</dt>
            <dd>
              {slot.opens}–{slot.closes}
            </dd>
          </div>
        ))}
        <div>
          <dt>So</dt>
          <dd>geschlossen</dd>
        </div>
      </dl>
      <p>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>
      <Note n={9} style="left:0;bottom:calc(100% + 12px)">
        Eine Quelle für alle Öffnungszeiten: Footer, Google-Profil und strukturierte Daten. Heute nennt Ihr Code täglich
        9–17 Uhr, der Footer Mo–Sa.
      </Note>
    </div>
    <div class="col">
      <p class="mono mute">Leistungen</p>
      <ul class="links">
        {services.map((service) => (
          <li>
            <a href={serviceHref(service.slug)}>{service.name}</a>
          </li>
        ))}
        <li>
          <a href={tfm.href}>{tfm.name}</a>
        </li>
      </ul>
    </div>
    <div class="col">
      <p class="mono mute">Einsatzgebiet</p>
      <p class="area">{places.map((place) => place.name).join(" · ")}</p>
    </div>
  </div>

  <div class="wrap bottom mono">
    <span>© 2026 {company.name}</span>
    <a href="https://handwerker.work/impressum/" rel="noopener">
      Impressum
    </a>
    <a href="https://handwerker.work/datenschutzerklaerung-2/" rel="noopener">
      Datenschutz
    </a>
  </div>
  <p class="mark" aria-hidden="true" data-mark>
    <span>Handwerker</span>
    <span>.work</span>
  </p>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    padding-top: clamp(96px, 14vw, 200px);
  }
  .cta {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .cta :global(.cta-title) {
    font-size: clamp(2.8rem, 1.2rem + 7vw, 8.5rem);
    letter-spacing: -0.065em;
    line-height: 0.92;
  }
  .cta-row {
    display: grid;
    gap: 40px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .cta-row {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .phone {
    display: grid;
    gap: 10px;
    justify-self: start;
    font-size: clamp(1.8rem, 1rem + 3vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 10px;
    transition: background-size 0.8s var(--ease);
  }
  .phone:hover {
    background-size: 100% 1px;
  }
  .cta-side {
    display: grid;
    gap: 20px;
  }

  .grid {
    display: grid;
    gap: 40px 32px;
    padding-block: 48px;
    border-top: 1px solid var(--line-night);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .col {
    display: grid;
    gap: 14px;
    align-content: start;
    font-size: 0.92rem;
    color: var(--on-night);
  }
  .col a {
    color: inherit;
    text-decoration: none;
  }
  .col a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  address {
    font-style: normal;
  }
  .coords {
    font-size: 0.66rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }
  .hours {
    display: grid;
    gap: 4px;
    max-width: 220px;
  }
  .hours div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .hours dt {
    color: var(--mute-night);
  }
  .hours dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .area {
    line-height: 1.75;
    color: var(--mute-night);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    padding-block: 12px;
    border-top: 1px solid var(--line-night);
    color: var(--mute-night);
  }
  .bottom span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
  }
  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }
  .bottom a:hover {
    color: var(--on-night);
  }
  .mark {
    display: flex;
    justify-content: center;
    margin: 0 auto -0.2em;
    padding-inline: 1vw;
    max-width: none;
    font-size: 15.6vw;
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.85;
    white-space: nowrap;
    color: var(--on-night);
    user-select: none;
  }
  .mark span + span {
    color: #2a2a2d;
  }
  :global(html.js) .mark:not(:global(.in)) {
    transform: translateY(40%);
    opacity: 0;
  }
  :global(html.js) .mark {
    transition:
      transform 1.6s var(--ease),
      opacity 1.2s var(--ease);
  }
  @media (max-width: 760px) {
    :global(.has-action-bar) .site-footer {
      padding-bottom: calc(56px + env(safe-area-inset-bottom));
    }
  }
</style>
