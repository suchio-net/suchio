---
// Home stage: the hero and the six layer steps share one pinned three.js model (drive/scene.ts),
// like the bathroom of the Brenneck example. The hero shows the finished drive in its garden;
// scrolling into the steps lifts the layers off and lowers each one in again with its note.
// Copy stays HTML, the canvas is decoration and loads after the page.
import Photo from "../shared/Photo.astro";
import { company, ratings } from "../shared/content";
import { sections } from "./routes";

const steps = [
  { name: "Untergrund", text: "Wir heben aus, verdichten den Boden und legen das Gefälle an, damit Wasser abläuft." },
  {
    name: "Frostschutzschicht",
    text: "Grobes Material, lagenweise verdichtet. Es leitet Wasser ab und schützt die Fläche vor Frostschäden.",
  },
  { name: "Tragschicht", text: "Schotter, verdichtet und eben abgezogen. Er trägt das Gewicht von Auto und Anhänger." },
  {
    name: "Bettung aus Splitt",
    text: "Eine dünne Lage Splitt, genau auf Höhe abgezogen. Darin liegen die Steine fest.",
  },
  { name: "Pflaster", text: "Naturstein, Beton oder Verbundpflaster, im Verband verlegt und am Rand eingefasst." },
  { name: "Fugen", text: "Fugensand einkehren und abrütteln. Dann ist die Fläche fertig und belastbar." },
];
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(steps.length);
---

<section class="stage" aria-labelledby="hero-title" data-stage>
  <div class="stage-sticky" aria-hidden="true">
    <canvas class="stage-canvas" data-stage-canvas></canvas>
    <div class="labels">
      {steps.map((step, index) => (
        <span class="label mono" data-stage-label>
          <i></i>
          <b></b>
          <span>
            {pad(index + 1)} {step.name}
          </span>
        </span>
      ))}
    </div>
    <div class="fallback">
      <Photo name="einfahrt-haus" alt="" label={false} sizes="(min-width: 960px) 55vw, 100vw" />
    </div>
  </div>

  <div class="stage-content">
    <div class="hero wrap" data-hero>
      <div class="hero-copy" data-copy>
        <h1 id="hero-title">Pflaster, Terrassen und Außenanlagen in München</h1>
        <p class="lead mute">
          Einfahrten, Wege, Terrassen und Zäune, vom Unterbau bis zum letzten Stein. Dazu Innenausbau mit Boden,
          Fliesen, Bad und Küche.
        </p>
        <div class="actions">
          <a class="btn" href={sections.kontakt}>
            Projekt anfragen
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="btn btn-line" href={company.mobile.href}>
            {company.mobile.display}
          </a>
        </div>
        <ul class="ratings mono">
          {[ratings.google, ratings.myhammer].map((rating) => (
            <li>
              <a href={rating.href} rel="noopener">
                <b>{rating.value}</b>
                <span class="stars" aria-hidden="true">
                  ★★★★★
                </span>
                {rating.platform}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="layers wrap" aria-labelledby="layers-title">
      <h2 id="layers-title" class="sr-only">
        Aufbau einer Einfahrt in {steps.length} Schichten
      </h2>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="step" data-step>
            <div class="step-card" data-copy>
              <p class="mono mute">
                {pad(index + 1)} / {total}
              </p>
              <h3>{step.name}</h3>
              <p class="step-text mute">{step.text}</p>
              {index === steps.length - 1 && (
                <a class="link" href={sections.kontakt}>
                  Einfahrt anfragen
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="stage-track" aria-hidden="true" data-track></div>
</section>

<style>
  .stage {
    position: relative;
  }
  /* The model stays pinned below the header while the hero and the steps scroll over it. */
  .stage-sticky {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    overflow: hidden;
  }
  .stage-sticky::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(17 18 19 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(17 18 19 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center;
    mask-image: radial-gradient(ellipse 55% 60% at 70% 50%, #000 10%, transparent 75%);
  }
  .stage-canvas {
    position: relative;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .stage:global(.ready) .stage-canvas {
    opacity: 1;
  }
  .fallback {
    display: none;
  }
  .stage:global(.no-webgl) .fallback {
    position: absolute;
    display: block;
    inset: 10% var(--gutter) 14% 48%;
  }
  .fallback :global(.jh-photo) {
    height: 100%;
  }

  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .label {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    height: 0;
    white-space: nowrap;
    color: var(--ink);
    visibility: hidden;
    will-change: transform, opacity;
  }
  .label i {
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--white);
    flex: none;
  }
  .label b {
    width: var(--len, 34px);
    height: 1px;
    background: var(--ink);
    opacity: 0.6;
  }
  .label span {
    padding: 4px 8px;
    margin-left: 6px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.66rem;
  }
  .label:global(.flip) {
    flex-direction: row-reverse;
  }
  .label:global(.flip) i {
    margin: 0 -3.5px 0 0;
  }
  .label:global(.flip) span {
    margin: 0 6px 0 0;
  }
  @media (max-width: 600px) {
    .label span {
      padding: 3px 6px;
      font-size: 0.6rem;
    }
  }

  .stage-content {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--header-h) - 100svh);
    pointer-events: none;
  }
  .stage-content :is(a, button, h1, h2, h3, p) {
    pointer-events: auto;
  }

  .hero {
    display: grid;
    min-height: calc(100svh - var(--header-h));
  }
  .hero-copy {
    display: grid;
    gap: 22px;
    align-content: center;
    padding-block: clamp(24px, 5vh, 64px);
  }
  @media (min-width: 960px) {
    .hero-copy {
      max-width: min(600px, 44vw);
    }
  }
  h1 {
    max-width: 13ch;
  }
  .lead {
    max-width: 40ch;
    font-size: 1.05rem;
  }
  .ratings {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: -8px;
  }
  .ratings a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    color: var(--mute);
    text-decoration: none;
  }
  .ratings b {
    color: var(--ink);
    font-weight: 400;
  }
  .stars {
    color: var(--ink);
    letter-spacing: 2px;
  }
  .ratings a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Wide screens: one screen per layer, the card left of the model. */
  .step {
    display: grid;
    align-items: center;
    min-height: 92svh;
  }
  .step-card {
    display: grid;
    gap: 14px;
    max-width: min(420px, 36vw);
  }
  .step h3 {
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .step-text {
    max-width: 34ch;
    font-size: 1.05rem;
  }
  .step-card .link {
    justify-self: start;
  }
  .stage-track {
    display: none;
  }

  /* Phones and portrait tablets, like the Brenneck example: one pinned screen. The copy sits at
     the top, the model below it. Scrolling swaps the copy in place (hero, then each layer) while
     the model stays where it is; .stage-track provides the scroll distance, 55svh per state. */
  @media (max-width: 959px) and (orientation: portrait) {
    .stage-sticky::before {
      mask-image: radial-gradient(ellipse 75% 32% at 50% 70%, #000 10%, transparent 75%);
    }
    .stage:global(.no-webgl) .fallback {
      inset: 52% var(--gutter) 96px;
    }
    .stage-content {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      overflow: hidden;
    }
    .stage-track {
      display: block;
      height: calc(6.5 * 55svh);
    }
    .hero,
    .step {
      position: absolute;
      inset: 0;
      padding-top: 20px;
      transition:
        opacity 0.6s var(--ease),
        transform 0.8s var(--ease),
        visibility 0s;
    }
    .hero:not(:global(.on)),
    .step:not(:global(.on)) {
      opacity: 0;
      transform: translateY(-14px);
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease),
        transform 0.5s var(--ease),
        visibility 0s 0.5s;
    }
    :global(html:not(.js)) .step {
      display: none;
    }
    :global(html:not(.js)) .hero {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .hero {
      display: block;
      min-height: 0;
      padding-top: clamp(40px, 7svh, 64px);
    }
    .hero-copy {
      gap: 14px;
      padding: 0;
    }
    /* The fixed action bar carries the call and the request on phones. */
    .ratings,
    .actions {
      display: none;
    }
    h1 {
      font-size: clamp(2.1rem, 9.2vw, 3.6rem);
    }
    .lead {
      font-size: 0.95rem;
    }
    .actions .btn {
      flex: 0 1 auto;
    }
    .layers {
      position: static;
      padding: 0;
    }
    .steps {
      display: block;
    }
    .step {
      display: block;
      min-height: 0;
      padding-inline: var(--gutter);
    }
    .step-card {
      gap: 12px;
      max-width: none;
    }
    .step h3 {
      font-size: clamp(2.4rem, 11vw, 4rem);
    }
    .step-text {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  import type { DriveScene, Region } from "./drive/scene";

  const stage = document.querySelector<HTMLElement>("[data-stage]");
  const canvas = stage?.querySelector<HTMLCanvasElement>("[data-stage-canvas]");
  if (stage && canvas) {
    const sticky = canvas.parentElement!;
    const labels = [...stage.querySelectorAll<HTMLElement>("[data-stage-label]")];
    const hero = stage.querySelector<HTMLElement>("[data-hero]")!;
    const panels = [hero, ...stage.querySelectorAll<HTMLElement>("[data-step]")];
    const copies = [...stage.querySelectorAll<HTMLElement>("[data-copy]")];
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const track = stage.querySelector<HTMLElement>("[data-track]")!;
    const steps = panels.slice(1);
    const split = matchMedia("(max-width: 959px) and (orientation: portrait)");
    const action = document.querySelector<HTMLElement>(".action-bar");

    // Continuous state at the current scroll: -1 hero, 0..5 the steps. On wide screens a panel is
    // in its state when its centre crosses the middle of the pinned area; on phones the screen is
    // pinned and every 55svh along the track is one state.
    const progress = () => {
      if (split.matches) {
        const unit = track.offsetHeight / 6.5;
        const moved = sticky.getBoundingClientRect().top - stage.getBoundingClientRect().top;
        return Math.min(steps.length, moved / unit) - 1;
      }
      const box = sticky.getBoundingClientRect();
      const middle = box.top + box.height / 2;
      const centres = panels.map((panel) => {
        const r = panel.getBoundingClientRect();
        return r.top + r.height / 2;
      });
      if (middle <= centres[0]) return -1;
      for (let i = 1; i < centres.length; i++)
        if (middle <= centres[i]) return i - 2 + (middle - centres[i - 1]) / (centres[i] - centres[i - 1]);
      return panels.length - 2;
    };

    // On phones only the panel of the current state shows.
    let current = -2;
    const showPanel = (p: number) => {
      const active = p < -0.5 ? -1 : Math.min(steps.length - 1, Math.round(p));
      if (active === current) return;
      current = active;
      panels.forEach((panel, i) => panel.classList.toggle("on", i === active + 1));
    };

    // The model fills the space the copy leaves free: right of it on wide screens; on phones
    // between the tallest copy panel and the action bar, so it never moves between states.
    const region = (): Region => {
      const w = sticky.clientWidth,
        h = sticky.clientHeight;
      if (!split.matches) return { left: w * 0.46, right: w - 24, top: 24, bottom: h - 24 };
      const top = sticky.getBoundingClientRect().top;
      const text = Math.max(...copies.map((copy) => copy.getBoundingClientRect().bottom - top));
      // The action bar is fixed, so measure it against the pinned position of the screen. Measured
      // against the moving top it would push the floor below the screen when the stage scrolls out.
      const pinned = parseFloat(getComputedStyle(sticky).top) || 0;
      const floor =
        action && getComputedStyle(action).display !== "none"
          ? Math.min(h, action.getBoundingClientRect().top - pinned)
          : h;
      return { left: 8, right: w - 8, top: text + 16, bottom: floor - 16 };
    };

    let scene: DriveScene | undefined;
    const loop = () => {
      const p = progress();
      showPanel(p);
      if (scene) {
        scene.setRegion(region());
        scene.setProgress(p);
        scene.tick();
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
    import("./drive/scene")
      .then(({ createDrive }) => {
        try {
          scene = createDrive({ canvas, labels, reduceMotion });
        } catch {
          stage.classList.add("no-webgl");
          return;
        }
        scene.ready.then(() => stage.classList.add("ready"));
        if (matchMedia("(hover: hover) and (pointer: fine)").matches)
          addEventListener(
            "pointermove",
            (event: PointerEvent) =>
              scene?.setPointer((event.clientX / innerWidth) * 2 - 1, (event.clientY / innerHeight) * 2 - 1),
            { passive: true },
          );
      })
      .catch(() => stage.classList.add("no-webgl"));
  }
</script>
<noscript>
  <style is:inline>
    [data-stage] .fallback {
      position: absolute;
      display: block !important;
      inset: 10% 4vw 14% 48%;
    }
  </style>
</noscript>
