---
import DraftBar from "../shared/DraftBar.astro";
import { assetBase, company } from "../shared/content";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { base, sections } from "./routes";
import "./theme.css";
import "../shared/draft.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fonts = `${assetBase}/fonts`;
const canonical = new URL(base, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${assetBase}/favicon.png`} type="image/png" />
    <link rel="preload" href={`${fonts}/dm-sans-latin-opsz-normal.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: "DM Sans";
        src: url(/projekte/johannes-handwerk/fonts/dm-sans-latin-opsz-normal.woff2) format("woff2");
        font-weight: 100 1000;
        font-display: swap;
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
          U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "DM Sans";
        src: url(/projekte/johannes-handwerk/fonts/dm-sans-latin-ext-opsz-normal.woff2) format("woff2");
        font-weight: 100 1000;
        font-display: swap;
        unicode-range:
          U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1E00-1E9F, U+20A0-20AB, U+20AD-20C0,
          U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "DM Sans Fallback";
        src: local("Arial"), local("Helvetica Neue"), local("Helvetica");
        size-adjust: 101%;
        ascent-override: 92%;
        descent-override: 29%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url(/projekte/johannes-handwerk/fonts/jetbrains-mono-latin-400-normal.woff2) format("woff2");
        font-weight: 400;
        font-display: swap;
      }
    </style>
  </head>
  <body class="has-action-bar">
    <a class="skip" href="#main">
      Zum Inhalt springen
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <nav class="action-bar" aria-label="Schnellkontakt">
      <a href={company.mobile.href}>Anrufen</a>
      <a class="primary" href={sections.kontakt}>
        Anfrage
      </a>
    </nav>

    <DraftBar version="a" />

    <script>
      import "./client";
    </script>
  </body>
</html>

<style is:global>
  .action-bar {
    display: none;
  }
  @media (max-width: 760px) {
    .action-bar {
      position: fixed;
      inset: auto 8px calc(8px + env(safe-area-inset-bottom));
      z-index: 45;
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
      background: rgb(17 18 19 / 0.92);
      transition:
        transform 0.6s var(--ease),
        opacity 0.4s;
    }
    .action-bar a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      border-radius: 999px;
      color: var(--on-night);
      font-size: 0.92rem;
      font-weight: 500;
      text-decoration: none;
    }
    .action-bar a.primary {
      background: var(--white);
      color: var(--ink);
    }
    .action-bar.hidden {
      transform: translateY(140%);
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
