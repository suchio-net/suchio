---
import Layout from "./Layout.astro";
import Stage from "./Stage.astro";
import Photo from "../shared/Photo.astro";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import {
  company,
  exampleProjects,
  figures,
  googleReviews,
  myhammerReviews,
  places,
  process,
  ratings,
  serviceGroups,
} from "../shared/content";
import { faqs } from "../shared/faqs";
import { sections } from "./routes";

const title = "Pflaster, Terrassen und Außenanlagen in München | Johannes-Handwerk";
const description =
  "Einfahrten, Wege, Terrassen und Zäune in München und Umgebung, vom Unterbau bis zum letzten Stein. Dazu Boden, Fliesen, Bad und Küche. Festpreis-Angebot nach dem Vor-Ort-Termin.";
const facts = [
  ...figures,
  { value: ratings.google.value, label: `Google-Bewertung aus ${ratings.google.count} Rezensionen` },
];
const [focus, ...more] = serviceGroups;
const pad = (n: number) => String(n).padStart(2, "0");
const reviews = [...googleReviews, ...myhammerReviews];
// Each half of the ticker holds the places four times, so it is wider than any screen and the loop never shows a gap.
const tickerPlaces = Array.from({ length: 4 }, () => places).flat();
// One icon per sub-service, so the lists read without rules between the lines.
const itemIcons: Record<string, IconName> = {
  "Flächen, Wege und Innenhöfe pflastern": "grid-2x2",
  "Einfahrten und Stellplätze": "car",
  Terrassen: "sun",
  "Zäune und Sichtschutz": "fence",
  "Fundamente aller Art": "brick-wall",
  "Terrassen-Überdachungen": "umbrella",
  "Rollrasen und Ansaat": "sprout",
  "Gartenhäuser aufbauen": "house",
  "Parkett und Laminat verlegen": "layers",
  "Teppich, PVC und Linoleum": "layers-2",
  "Wand- und Bodenfliesen": "grid-3x3",
  "Fugen erneuern": "brush",
  "Bad- und Küchensanierung": "bath",
  Trockenwandsanierung: "panels-top-left",
  "Türen einbauen und austauschen": "door-open",
  "Streicharbeiten und Wandanstrich": "paint-roller",
  Tapezierarbeiten: "wallpaper",
  "Vertäfelung und Wandgestaltung": "columns-3",
  "Kleine und große Renovierungen": "hammer",
  Instandsetzungen: "wrench",
  "Abrissarbeiten und Entkernung": "pickaxe",
  "Abtransport und Entrümpelung": "truck",
  "Haushalts- und Geschäftsauflösung": "package-open",
  "Erdaushub und Bauschutt entsorgen": "shovel",
  "Hecken und Sträucher entfernen": "scissors",
};
---

<Layout title={title} description={description}>
  <Stage />

  <section class="facts wrap" aria-labelledby="facts-title">
    <h2 id="facts-title" class="sr-only">
      Auf einen Blick
    </h2>
    <dl class="facts-grid">
      {facts.map((fact) => (
        <div class="fact">
          <dt class="mono mute">{fact.label}</dt>
          <dd class="fact-value" data-count>
            {fact.value}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="ticker mono">
    <p class="sr-only">Einsatzorte: {places.join(", ")} und Umgebung</p>
    <div class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <span>
          {tickerPlaces.map((place) => (
            <Fragment>
              {place}
              <i></i>
            </Fragment>
          ))}
        </span>
      ))}
    </div>
  </div>

  <section class="services wrap" id="leistungen" aria-labelledby="services-title">
    <h2 id="services-title">
      Schwerpunkt Außenanlagen.
      <br />
      Dazu Innenausbau.
    </h2>

    <article class="focus" aria-labelledby="focus-title">
      <div class="focus-copy">
        <h3 id="focus-title">{focus.name}</h3>
        <p class="mute">{focus.summary}</p>
        <ul class="items">
          {focus.items.map((item) => (
            <li>
              <Icon name={itemIcons[item] ?? "hammer"} size={18} />
              {item}
            </li>
          ))}
        </ul>
        <a class="link" href={sections.kontakt}>
          Außenanlage anfragen
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <Photo name="einfahrt-garage" class="focus-photo" sizes="(min-width: 960px) 50vw, 100vw" />
    </article>

    <ol class="more">
      {more.map((group) => (
        <li>
          <div>
            <h3>{group.name}</h3>
            <p class="mute">{group.summary}</p>
          </div>
          <ul class="items">
            {group.items.map((item) => (
              <li>
                <Icon name={itemIcons[item] ?? "hammer"} size={18} />
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="projects" id="projekte" aria-labelledby="projects-title" data-carousel>
    <div class="wrap">
      <div class="projects-head">
        <h2 id="projects-title">Projekte aus München und Umgebung.</h2>
        <p class="jh-note">
          Beispiel: Leistung und Ort stammen aus Ihren Kundenbewertungen. Fotos, Fläche und Material ergänzen wir mit
          Ihren Projekten.
        </p>
      </div>
      <div class="slides" aria-roledescription="Karussell" aria-label="Projekte">
        {exampleProjects.map((item, index) => (
          <figure
            class:list={["slide", { on: index === 0 }]}
            aria-roledescription="Folie"
            aria-label={`${index + 1} von ${exampleProjects.length}`}
            aria-hidden={index === 0 ? undefined : "true"}
            data-slide
          >
            <Photo name={item.photo} class="slide-photo" sizes="(min-width: 960px) 58vw, 100vw" />
            <figcaption class="slide-body">
              <h3>{item.title}</h3>
              <dl class="slide-facts">
                <div>
                  <dt class="mono mute">Ort</dt>
                  <dd>{item.place ?? <span class="jh-field">Ihre Angabe</span>}</dd>
                </div>
                <div>
                  <dt class="mono mute">Fläche</dt>
                  <dd>
                    <span class="jh-field">m² eintragen</span>
                  </dd>
                </div>
                <div>
                  <dt class="mono mute">Material</dt>
                  <dd>
                    <span class="jh-field">Ihre Angabe</span>
                  </dd>
                </div>
              </dl>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="controls">
        <span class="progress" aria-hidden="true">
          <i data-progress></i>
        </span>
        <span class="count mono" aria-hidden="true">
          <span data-current>01</span> / {pad(exampleProjects.length)}
        </span>
        <button type="button" class="nav" data-step="-1">
          <span aria-hidden="true">←</span>
          <span class="sr-only">Vorheriges Projekt</span>
        </button>
        <button type="button" class="nav" data-step="1">
          <span aria-hidden="true">→</span>
          <span class="sr-only">Nächstes Projekt</span>
        </button>
      </div>
    </div>
  </section>

  <section class="process wrap" id="ablauf" aria-labelledby="process-title">
    <h2 id="process-title">Vier Schritte bis zum fertigen Projekt.</h2>
    <ol class="process-grid">
      {process.map((step, index) => (
        <li class="process-step">
          <span class="mono mute">{pad(index + 1)}</span>
          <h3>{step.title}</h3>
          <p class="mute">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="reviews" id="bewertungen" aria-labelledby="reviews-title" data-carousel>
    <div class="wrap">
      <div class="reviews-top">
        <h2 id="reviews-title">Was Kunden über uns schreiben.</h2>
        <div class="scores">
          <ul class="platforms">
            {[ratings.google, ratings.myhammer].map((rating) => (
              <li>
                <a class="score" href={rating.href} rel="noopener">
                  <span class="score-value" data-count>
                    {rating.value}
                  </span>
                  <span class="score-meta mono">
                    <span aria-hidden="true">★★★★★</span>
                    <span>
                      {rating.platform}, {rating.count} {rating.unit}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mono mute as-of">{ratings.asOf}</p>
        </div>
      </div>
      <div class="slides quotes" aria-roledescription="Karussell" aria-label="Bewertungen">
        {reviews.map((review, index) => (
          <figure
            class:list={["slide", "quote", { on: index === 0 }]}
            aria-roledescription="Folie"
            aria-label={`${index + 1} von ${reviews.length}`}
            aria-hidden={index === 0 ? undefined : "true"}
            data-slide
          >
            <blockquote>
              <p>{review.quote}</p>
            </blockquote>
            <figcaption class="mono">
              {review.name && <span>{[review.name, review.place].filter(Boolean).join(", ")}</span>}
              {review.service && <span>{review.service}</span>}
              <span>{review.platform}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="controls">
        <span class="progress" aria-hidden="true">
          <i data-progress></i>
        </span>
        <span class="count mono" aria-hidden="true">
          <span data-current>01</span> / {pad(reviews.length)}
        </span>
        <button type="button" class="nav" data-step="-1">
          <span aria-hidden="true">←</span>
          <span class="sr-only">Vorherige Bewertung</span>
        </button>
        <button type="button" class="nav" data-step="1">
          <span aria-hidden="true">→</span>
          <span class="sr-only">Nächste Bewertung</span>
        </button>
      </div>
    </div>
  </section>

  <section class="faq-section wrap" aria-labelledby="faq-title">
    <div class="faq-head">
      <h2 id="faq-title">Häufige Fragen.</h2>
      <p class="mute">
        Noch etwas offen?{" "}
        <a class="link" href={company.mobile.href}>
          {company.mobile.display}
        </a>
      </p>
    </div>
    <div class="faq">
      {faqs.home.map((faq) => (
        <details name="faq-home">
          <summary>{faq.q}</summary>
          <p class="answer">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .facts {
    display: grid;
    gap: 24px;
    padding-block: clamp(56px, 7vw, 104px) clamp(48px, 6vw, 80px);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  @media (min-width: 960px) {
    .facts-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 12px;
  }
  .fact-value {
    font-size: clamp(3rem, 1.8rem + 4.4vw, 6.4rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.065em;
    font-variant-numeric: tabular-nums;
  }
  .fact dt {
    max-width: 22ch;
  }

  .ticker {
    overflow: hidden;
    padding-block: 18px;
    border-block: 1px solid var(--line);
    color: var(--mute);
    white-space: nowrap;
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 200s linear infinite;
  }
  .ticker span {
    display: flex;
    align-items: center;
  }
  .ticker i {
    width: 4px;
    height: 4px;
    margin-inline: 28px;
    background: var(--red);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }

  .services {
    padding-block: clamp(88px, 11vw, 168px) clamp(48px, 6vw, 96px);
  }
  .focus {
    display: grid;
    gap: 32px 56px;
    margin-top: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 960px) {
    .focus {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
  .focus-copy {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .focus h3 {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  :global(.focus-photo) {
    aspect-ratio: 4 / 3;
  }
  .items {
    display: grid;
    gap: 0 28px;
  }
  .focus .items {
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .items li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 8px;
  }
  .items :global(.icon) {
    flex: none;
    width: 34px;
    height: 34px;
    padding: 8px;
    border-radius: 50%;
    background: var(--mist);
    color: var(--ink);
  }
  .more {
    display: grid;
    margin-top: clamp(48px, 6vw, 88px);
  }
  .more > li {
    display: grid;
    gap: 16px 40px;
    padding-block: 28px 32px;
  }
  @media (min-width: 960px) {
    .more > li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .more h3 {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    letter-spacing: -0.04em;
    margin-bottom: 8px;
  }
  .more .items {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  /* Projects: one at a time, like the reviews of the Brenneck example. A progress line runs
     under the slide and moves on when it is full; hover, focus or leaving the screen pause it. */
  .projects {
    padding-block: clamp(72px, 9vw, 140px);
    background: var(--mist);
  }
  .projects .wrap {
    display: grid;
    gap: clamp(28px, 3.5vw, 48px);
  }
  .projects-head {
    display: grid;
    gap: 20px;
  }
  .projects-head h2 {
    max-width: 16ch;
  }
  .slides {
    display: grid;
  }
  .slide {
    grid-area: 1 / 1;
    display: grid;
    gap: 24px 56px;
    align-items: end;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s var(--ease),
      visibility 0s 0.6s;
  }
  @media (min-width: 960px) {
    .slide {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }
  .slide:global(.on) {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.9s var(--ease) 0.15s;
  }
  .slide :global(.slide-photo) {
    aspect-ratio: 16 / 10;
  }
  .slide :global(.slide-photo img) {
    transform: scale(1.06);
    transition: transform 1.6s var(--ease);
  }
  .slide:global(.on) :global(.slide-photo img) {
    transform: none;
  }
  .slide-body {
    display: grid;
    gap: 20px;
    transform: translateY(24px);
    filter: blur(8px);
    transition:
      transform 0.9s var(--ease),
      filter 0.6s var(--ease);
  }
  .slide:global(.on) .slide-body {
    transform: none;
    filter: none;
    transition:
      transform 1.1s var(--ease) 0.2s,
      filter 0.9s var(--ease) 0.2s;
  }
  .slide h3 {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .slide-facts {
    display: grid;
    gap: 10px;
  }
  .slide-facts div {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: baseline;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide-body,
    .slide :global(.slide-photo img) {
      transform: none;
      filter: none;
    }
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    align-items: center;
    gap: 12px 20px;
  }
  .progress {
    height: 1px;
    background: var(--line-2);
    overflow: hidden;
  }
  .progress i {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(0);
  }
  [data-carousel]:global(.playing) .progress i {
    animation: fill 7s linear forwards;
  }
  [data-carousel]:global(.paused) .progress i {
    animation-play-state: paused;
  }
  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }
  .count {
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }
  .count span {
    color: var(--ink);
  }
  .nav {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    font-family: var(--mono);
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s;
  }
  .nav:hover {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  .process {
    display: grid;
    gap: 24px;
    padding-block: clamp(88px, 11vw, 168px) clamp(64px, 8vw, 112px);
  }
  .process h2 {
    max-width: 14ch;
    margin-bottom: clamp(16px, 3vw, 40px);
  }
  .process-grid {
    display: grid;
    gap: 40px 32px;
  }
  @media (min-width: 700px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .process-step {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .process-step h3 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
    letter-spacing: -0.045em;
  }
  .process-step p {
    max-width: 30ch;
  }

  /* Reviews: one large quote at a time, like the Brenneck example. They share the carousel
     script and controls with the projects. */
  .reviews {
    padding-block: clamp(72px, 9vw, 140px);
  }
  .reviews .wrap {
    display: grid;
    gap: clamp(32px, 4vw, 56px);
  }
  .reviews-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px 40px;
  }
  .reviews h2 {
    max-width: 14ch;
  }
  .scores {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 960px) {
    .scores {
      justify-items: end;
    }
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
  }
  .score {
    display: flex;
    align-items: end;
    gap: 14px;
    text-decoration: none;
  }
  .score-value {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
  }
  .score-meta {
    display: grid;
    gap: 4px;
    color: var(--mute);
  }
  .score-meta span:first-child {
    color: var(--ink);
    letter-spacing: 3px;
  }
  .score:hover .score-meta span:last-child {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .quote {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    align-content: start;
    gap: 24px;
    transform: translateY(24px);
    filter: blur(8px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.9s var(--ease),
      filter 0.6s var(--ease),
      visibility 0s 0.6s;
  }
  .quote:global(.on) {
    transform: none;
    filter: none;
    transition:
      opacity 0.9s var(--ease) 0.15s,
      transform 1.1s var(--ease) 0.15s,
      filter 0.9s var(--ease) 0.15s;
  }
  .quote blockquote {
    margin: 0;
  }
  .quote p {
    max-width: 30ch;
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.3rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }
  .quote p::before {
    content: "„";
  }
  .quote p::after {
    content: "“";
  }
  .quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: var(--mute);
  }
  .quote figcaption span:first-child {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .quote {
      transform: none;
      filter: none;
    }
  }

  .faq-section {
    display: grid;
    gap: 40px 64px;
    padding-block: clamp(64px, 8vw, 120px) clamp(88px, 11vw, 150px);
  }
  @media (min-width: 960px) {
    .faq-section {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
  .faq-head {
    display: grid;
    gap: 20px;
  }
  .faq-head h2 {
    margin-top: 0;
  }
</style>

<script>
  // Carousels for the projects and the reviews: autoplay with a progress line, arrows and swipes.
  // Without script the first slide shows.
  const autoplay = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const bar = root.querySelector<HTMLElement>("[data-progress]")!;
    const current = root.querySelector<HTMLElement>("[data-current]")!;
    let index = 0,
      inView = false,
      held = false;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("on", i === index);
        if (i === index) slide.removeAttribute("aria-hidden");
        else slide.setAttribute("aria-hidden", "true");
      });
      current.textContent = String(index + 1).padStart(2, "0");
      // Restart the progress line.
      root.classList.remove("playing");
      void bar.offsetWidth;
      if (autoplay) root.classList.add("playing");
    };
    const syncPause = () => root.classList.toggle("paused", held || !inView);
    const hold = (value: boolean) => {
      held = value;
      syncPause();
    };

    root
      .querySelectorAll<HTMLButtonElement>("[data-step]")
      .forEach((button) => button.addEventListener("click", () => show(index + Number(button.dataset.step))));
    if (autoplay) {
      bar.addEventListener("animationend", () => show(index + 1));
      root.addEventListener("pointerenter", () => hold(true));
      root.addEventListener("pointerleave", () => hold(false));
      root.addEventListener("focusin", () => hold(true));
      root.addEventListener("focusout", (event) => {
        if (!root.contains(event.relatedTarget as Node)) hold(false);
      });
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          syncPause();
        },
        { threshold: 0.3 },
      ).observe(root);
      syncPause();
      root.classList.add("playing");
    }

    let startX = 0;
    const stage = root.querySelector<HTMLElement>(".slides")!;
    stage.addEventListener(
      "touchstart",
      (event) => {
        startX = event.touches[0].clientX;
      },
      { passive: true },
    );
    stage.addEventListener("touchend", (event) => {
      const delta = event.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 50) show(index + (delta < 0 ? 1 : -1));
    });
  }
</script>
