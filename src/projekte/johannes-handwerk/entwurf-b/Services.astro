---
import Layout from "./Layout.astro";
import Icon from "./Icon.astro";
import PageHead from "./PageHead.astro";
import ContactBand from "./ContactBand.astro";
import Photo from "../shared/Photo.astro";
import { serviceGroups } from "../shared/content";
import { base, otherKeys, requestHref, services } from "./data";

const others = serviceGroups.filter((group) => otherKeys.includes(group.key));
---

<Layout
  title="Leistungen | Johannes-Handwerk München"
  description="Pflaster, Terrassen, Einfahrten, Zäune, Boden und Innenausbau, Malerarbeiten, Abriss und Entsorgung in München und Umgebung."
  path="/leistungen"
  current="leistungen"
>
  <PageHead
    title="Unsere Leistungen"
    intro="Schwerpunkt sind Außenanlagen: Pflaster, Einfahrten, Terrassen und Zäune. Innen verlegen wir Böden und Fliesen und sanieren Bäder und Küchen."
    crumbs={[{ label: "Leistungen" }]}
  />

  <section class="band" aria-label="Leistungen mit eigener Seite">
    <ul class="wrap service-list">
      {services.map((service) => (
        <li>
          <Photo name={service.image} sizes="(min-width: 960px) 40vw, 100vw" class="tile" />
          <div class="service-text">
            <h2>{service.name}</h2>
            <p>{service.intro}</p>
            <ul class="items">
              {service.scope
                .flatMap((group) => group.items)
                .slice(0, 6)
                .map((item) => (
                  <li>{item}</li>
                ))}
            </ul>
            <div class="actions">
              <a class="btn btn-line" href={`${base}/leistungen/${service.slug}`}>
                Mehr zu {service.name}
                <Icon name="arrow-right" />
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="band band-grout" aria-label="Weitere Leistungen">
    <div class="wrap other-grid">
      {others.map((group) => (
        <article id={group.key}>
          <h2>{group.name}</h2>
          <p>{group.summary}</p>
          <ul class="items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="text-link" href={requestHref()}>
            Anfrage stellen
          </a>
        </article>
      ))}
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .service-list {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }
  .service-list > li {
    display: grid;
    gap: 24px 56px;
    align-items: center;
  }
  .service-list :global(.tile) {
    aspect-ratio: 3 / 2;
  }
  .service-text {
    display: grid;
    gap: 18px;
  }
  .service-text h2,
  .other-grid h2 {
    font-size: var(--step-3);
  }
  @media (min-width: 960px) {
    .service-list > li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .service-list > li:nth-child(even) :global(.tile) {
      order: 2;
    }
  }
  .other-grid {
    display: grid;
    gap: var(--joint);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }
  .other-grid article {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: clamp(24px, 3vw, 40px);
    background: var(--board);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .other-grid .text-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
