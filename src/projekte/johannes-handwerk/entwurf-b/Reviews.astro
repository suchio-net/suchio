---
import Icon from "./Icon.astro";
import PlatformLogo from "./PlatformLogo.astro";
import { googleReviews, myhammerReviews, ratings } from "../shared/content";

const platforms = [ratings.google, ratings.myhammer];
const reviews = [...myhammerReviews, ...googleReviews];
---

<section class="band band-grout" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="reviews-head">
      <h2 class="section-title" id="reviews-title">
        Das sagen unsere Kunden
      </h2>
      <div class="platforms">
        {platforms.map((platform) => (
          <a class="platform" href={platform.href} rel="noopener">
            <PlatformLogo platform={platform.platform} />
            <span class="platform-score">
              <span class="platform-value">
                <Icon name="star" size={22} />
                {platform.value}
              </span>
              <span class="soft">
                {platform.count} {platform.unit}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <ul class="quotes" data-quotes>
      {reviews.map((review) => (
        <li>
          <blockquote>
            <p>„{review.quote}“</p>
          </blockquote>
          <p class="who soft">
            <PlatformLogo platform={review.platform} mark />
            <span>
              {[review.name, review.place, review.service].filter(Boolean).join(" · ") ||
                `${review.platform}-Rezension`}
            </span>
          </p>
        </li>
      ))}
    </ul>
    <div class="swipe-meta" aria-hidden="true">
      <span class="swipe-bar">
        <i data-swipe-bar></i>
      </span>
      <span class="soft">
        <span data-swipe-current>1</span> / {reviews.length}
      </span>
    </div>
  </div>
</section>

<script>
  // Phones: the progress bar under the swipe row follows the scroll position.
  for (const list of document.querySelectorAll<HTMLElement>("[data-quotes]")) {
    const meta = list.nextElementSibling as HTMLElement;
    const bar = meta.querySelector<HTMLElement>("[data-swipe-bar]")!;
    const current = meta.querySelector<HTMLElement>("[data-swipe-current]")!;
    const count = list.children.length;
    const update = () => {
      const max = list.scrollWidth - list.clientWidth;
      const ratio = max > 0 ? list.scrollLeft / max : 0;
      bar.style.transform = `scaleX(${(1 + ratio * (count - 1)) / count})`;
      current.textContent = String(Math.round(ratio * (count - 1)) + 1);
    };
    list.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>

<style>
  .reviews-head {
    display: grid;
    gap: 12px;
    margin-bottom: var(--joint);
  }
  .reviews-head .section-title {
    margin-bottom: 0;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--joint);
    align-content: end;
  }
  /* One box per platform, together as wide as the review grid: logo left, score right. */
  .platform {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 20px 24px;
    background: var(--board);
    text-decoration: none;
  }
  .platform-score {
    display: grid;
    justify-items: end;
    gap: 2px;
  }
  .platform:hover .platform-score .soft {
    text-decoration: underline;
  }
  .platform-value {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
  }
  .platform-value :global(.icon) {
    color: var(--red);
    fill: var(--red);
  }
  .reviews-head .section-title {
    margin-bottom: 12px;
  }
  @media (max-width: 600px) {
    .platform {
      padding: 16px;
    }
    .platform-score {
      justify-items: start;
    }
  }
  /* A regular grid: the cards in one row share a height and the names sit on one line. */
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--joint);
  }
  .quotes li {
    display: grid;
    align-content: space-between;
    gap: 14px;
    padding: 24px;
    background: var(--board);
  }
  blockquote p {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
  }
  .who :global(.platform-logo) {
    flex: none;
  }
  .swipe-meta {
    display: none;
  }
  /* Phones: one card at a time in a swipe row, the next card peeks in at the edge. */
  @media (max-width: 700px) {
    .quotes {
      display: flex;
      gap: 12px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .quotes::-webkit-scrollbar {
      display: none;
    }
    .quotes li {
      flex: 0 0 86%;
      scroll-snap-align: start;
    }
    .swipe-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 20px;
      font-size: 0.95rem;
    }
    .swipe-bar {
      flex: 1;
      height: 2px;
      background: var(--grout-line);
    }
    .swipe-bar i {
      display: block;
      height: 100%;
      background: var(--red);
      transform-origin: left;
      transition: transform 0.2s ease-out;
    }
    /* Cards off to the side sit slightly smaller and lighter. */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .quotes li {
          animation: card-focus linear both;
          animation-timeline: view(inline);
        }
        @keyframes card-focus {
          0%,
          100% {
            opacity: 0.55;
            transform: scale(0.94);
          }
          35%,
          65% {
            opacity: 1;
            transform: none;
          }
        }
      }
    }
  }
</style>
