---
import Logo from "../shared/Logo.astro";
import { company, places, serviceGroups } from "../shared/content";
import { base, nav, services } from "./data";
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="col brand-col">
      <Logo height={56} />
      <address>
        {company.street}
        <br />
        {company.postalCode} {company.city}
      </address>
    </div>
    <div class="col">
      <h2>Kontakt</h2>
      <ul>
        <li>
          <a href={company.mobile.href}>{company.mobile.display}</a>
        </li>
        <li>
          <a href={company.landline.href}>{company.landline.display}</a>
        </li>
        <li>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
      </ul>
    </div>
    <div class="col">
      <h2>Leistungen</h2>
      <ul>
        {services.map((service) => (
          <li>
            <a href={`${base}/leistungen/${service.slug}`}>{service.name}</a>
          </li>
        ))}
        {serviceGroups.slice(2).map((group) => (
          <li>
            <a href={`${base}/leistungen#${group.key}`}>{group.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="col">
      <h2>Einsatzgebiet</h2>
      <p>
        {company.area}, zum Beispiel {places.slice(2).join(", ")}
      </p>
      <ul>
        {nav.slice(1).map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap bottom">
    <span>
      © 2026 {company.name} · {company.owner}
    </span>
    <a href={company.imprint} rel="noopener">
      Impressum
    </a>
    <a href={company.privacy} rel="noopener">
      Datenschutz
    </a>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(48px, 6vw, 72px);
    background: var(--grout);
    border-top: 1px solid var(--grout-line);
  }
  .grid {
    display: grid;
    gap: 36px 40px;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    padding-bottom: 40px;
  }
  .col {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .brand-col {
    gap: 20px;
  }
  h2 {
    font-family: var(--text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  address {
    font-style: normal;
  }
  .col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    text-decoration: none;
  }
  .col a:hover {
    color: var(--red);
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    padding-block: 12px;
    border-top: 1px solid var(--grout-line);
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .bottom span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
  }
  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .bottom a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
