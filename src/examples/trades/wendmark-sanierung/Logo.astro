---
// Roof-and-W mark of the fictional Wendmark Sanierung and its upper-case wordmark.
interface Props {
  class?: string;
  tone?: "dark" | "light";
}
const { class: className, tone = "dark" } = Astro.props;
---

<span class:list={["logo", `logo-${tone}`, className]}>
  <svg viewBox="0 0 64 64" width="38" height="38" aria-hidden="true" focusable="false">
    <path d="M6 28 32 8l26 20" fill="none" stroke="var(--logo-accent)" stroke-width="5.5" stroke-linejoin="miter" />
    <path
      d="M12 33l8 22 12-17 12 17 8-22"
      fill="none"
      stroke="var(--logo-wall)"
      stroke-width="5.5"
      stroke-linejoin="miter"
    />
  </svg>
  <span class="logo-word">
    Wendmark<span class="logo-accent"> Sanierung</span>
  </span>
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    --logo-wall: #252c33;
    --logo-accent: #0f6b5c;
    color: var(--slate);
  }
  .logo-light {
    --logo-wall: #e9edee;
    --logo-accent: #7fd1bf;
    color: #fff;
  }
  .logo svg {
    flex: none;
  }
  .logo-word {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1;
  }
  .logo-accent {
    color: var(--logo-accent);
  }
  /* The two-word wordmark is wider than the old one; on phones it has to share the bar with call and menu. */
  @media (max-width: 440px) {
    .logo {
      gap: 8px;
    }
    .logo svg {
      width: 32px;
      height: 32px;
    }
    .logo-word {
      font-size: 1.15rem;
    }
  }
</style>
