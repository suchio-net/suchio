---
import Layout from "@/examples/trades/wendmark-sanierung/Layout.astro";
import Zoom from "@/examples/trades/wendmark-sanierung/Zoom.astro";
import PageHead from "@/examples/trades/wendmark-sanierung/PageHead.astro";
import ContactBand from "@/examples/trades/wendmark-sanierung/ContactBand.astro";
import { company, references, referenceTopics } from "@/examples/trades/wendmark-sanierung/data";
import { image } from "@/examples/trades/shared/images";

const title = `Referenzen: Bäder, Fliesen und Renovierungen | ${company.name}`;
const description = "Fotos von Bädern, Fliesen, Baustellen und Renovierungen.";
const items = references.map((item) => ({ ...item, portrait: image(item.name).height > image(item.name).width }));
---

<Layout title={title} description={description} current="referenzen">
  <PageHead
    crumbs={[{ name: "Referenzen" }]}
    title="Referenzen"
    intro={[
      "Fertige Bäder, Fliesenarbeiten und Einblicke von der Baustelle.",
      "Im Konzept stehen hier lizenzierte Beispielfotos. Auf einer echten Website zeigen wir Ihre eigenen Projekte.",
    ]}
  />

  <section class="band" aria-label="Projektfotos">
    <div class="wrap">
      <div class="filters rel" role="group" aria-label="Fotos filtern" data-filters>
        <button type="button" aria-pressed="true" data-topic="alle">
          Alle <span>{items.length}</span>
        </button>
        {referenceTopics.map((topic) => (
          <button type="button" aria-pressed="false" data-topic={topic.key}>
            {topic.label} <span>{items.filter((item) => item.topic === topic.key).length}</span>
          </button>
        ))}
      </div>
      <ul class="tiles grid" data-grid>
        {items.map((item) => (
          <li class:list={["tile", { tall: item.portrait }]} data-item={item.topic}>
            <Zoom name={item.name} alt={item.alt} group="referenzen" sizes="(min-width: 960px) 25vw, 50vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .filters button {
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--grout-line);
    border-radius: 2px;
    background: var(--board);
    font-weight: 700;
    cursor: pointer;
  }
  .filters button span {
    margin-left: 4px;
    color: var(--slate-soft);
    font-weight: 400;
  }
  .filters button:hover {
    border-color: var(--slate-soft);
  }
  .filters button[aria-pressed="true"] {
    border-color: var(--slate);
    background: var(--slate);
    color: #fff;
  }
  .filters button[aria-pressed="true"] span {
    color: var(--slate-on-dark);
  }
  .grid {
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 180px;
    grid-auto-flow: dense;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 220px;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 240px;
    }
  }
  .grid .tall {
    grid-row: span 2;
  }
  .grid [hidden] {
    display: none;
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>("[data-filters]");
  const grid = document.querySelector<HTMLElement>("[data-grid]");
  if (filters && grid) {
    filters.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
      button.addEventListener("click", () => {
        filters
          .querySelectorAll("button")
          .forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        const topic = button.dataset.topic;
        grid.querySelectorAll<HTMLElement>("[data-item]").forEach((item) => {
          item.hidden = topic !== "alle" && item.dataset.item !== topic;
        });
      }),
    );
  }
</script>
