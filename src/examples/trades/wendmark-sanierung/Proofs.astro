---
// Proof strip: master qualification, the example rating and the warranty. "full" adds the
// quality standards list for the services overview. The business is fictional, so the strip
// uses icons instead of real seals or platform marks.
import Icon from "./Icon.astro";
import { base, company } from "./data";

interface Props {
  full?: boolean;
}
const { full = false } = Astro.props;

const qualityStandards = [
  "Ausführung nach den geltenden DIN-Normen und VDE-Bestimmungen",
  "Gewährleistung nach VOB und BGB",
  "Betriebshaftpflicht für alle Arbeiten",
  "Markenprodukte aus dem Fachhandel",
  "Regelmäßige Schulungen im Team",
];
---

<section class:list={["proofs", { "band band-grout": full }]} aria-labelledby="proofs-title">
  <div class="wrap">
    <h2 id="proofs-title" class:list={[full ? "section-title proofs-title" : "sr-only"]}>
      {full ? "Qualität und Nachweise" : "Nachweise"}
    </h2>
    <div class="strip">
      <div class="cell">
        <span class="seal">
          <Icon name="badge-check" size={40} />
        </span>
        <div>
          <p class="cell-title">Meisterbetrieb</p>
          <p class="cell-text">In der Handwerksrolle eingetragen für {company.credentials}</p>
        </div>
      </div>
      <a class="cell rating" href={`${base}#reviews-title`}>
        <span class="seal">
          <Icon name="star" size={40} />
        </span>
        <div>
          <p class="cell-title rating-line">
            {company.rating.value} von 5
            <span class="stars" role="img" aria-label="5 von 5 Sternen">
              {Array.from({ length: 5 }, () => (
                <i />
              ))}
            </span>
          </p>
          <p class="cell-text">{company.rating.count} Bewertungen (Beispielwerte)</p>
        </div>
      </a>
      <div class="cell">
        <span class="seal">
          <Icon name="shield-check" size={40} />
        </span>
        <div>
          <p class="cell-title">Seit {company.since}</p>
          <p class="cell-text">Gewährleistung nach VOB und BGB</p>
        </div>
      </div>
    </div>
    {full && (
      <ul class="standards items">
        {qualityStandards.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .proofs:not(.band) {
    padding-block: 0 clamp(40px, 5vw, 64px);
    background: var(--grout);
  }
  .strip {
    display: grid;
    gap: var(--joint);
    background: var(--grout);
  }
  @media (min-width: 760px) {
    .strip {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  .cell {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 104px;
    padding: 18px 22px;
    background: var(--board);
    color: inherit;
    text-decoration: none;
  }
  .cell p {
    max-width: none;
  }
  .cell-title {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.05;
  }
  .cell-text {
    font-size: 0.96rem;
    line-height: 1.4;
    color: var(--slate-soft);
  }
  .seal {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--grout);
    color: var(--accent);
  }
  .rating-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
  }
  .stars i {
    width: 18px;
    height: 18px;
    background: #fbbc04;
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .rating:hover .cell-text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .proofs-title {
    max-width: none;
  }
  /* Phones: three compact rows instead of three tall boxes. */
  @media (max-width: 759px) {
    .strip .cell {
      min-height: 0;
      padding: 14px 16px;
      gap: 14px;
    }
    .strip .seal {
      width: 52px;
      height: 52px;
    }
  }
  .standards {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 12px 48px;
    margin-top: clamp(28px, 4vw, 40px);
  }
</style>
