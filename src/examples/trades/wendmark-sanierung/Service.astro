---
import Layout from "@/examples/trades/wendmark-sanierung/Layout.astro";
import Icon from "@/examples/trades/wendmark-sanierung/Icon.astro";
import Zoom from "@/examples/trades/wendmark-sanierung/Zoom.astro";
import PageHead from "@/examples/trades/wendmark-sanierung/PageHead.astro";
import Faq from "@/examples/trades/wendmark-sanierung/Faq.astro";
import ContactBand from "@/examples/trades/wendmark-sanierung/ContactBand.astro";
import CostEstimator from "@/examples/trades/wendmark-sanierung/CostEstimator.astro";
import BathPlanner from "@/examples/trades/wendmark-sanierung/BathPlanner.astro";
import { base, company, services, sources, type Service } from "@/examples/trades/wendmark-sanierung/data";

interface Props {
  service: Service;
}
const { service } = Astro.props;
const isBath = service.slug === "badsanierung";
const others = services.filter((other) => other.slug !== service.slug);
const request = `${base}/kontakt?vorhaben=${service.formValue}#anfrage`;
const faqTitles: Record<string, string> = {
  badsanierung: "Fragen zur Badsanierung",
  "sanitaer-heizung": "Fragen zu Sanitär und Heizung",
  elektro: "Fragen zur Elektroinstallation",
  fliesen: "Fragen zu Fliesenarbeiten",
  renovierung: "Fragen zur Renovierung",
};
const faqTitle = faqTitles[service.slug] ?? "Häufige Fragen";
---

<Layout
  title={`${service.title} | ${company.name}`}
  description={service.description}
  current={`leistungen/${service.slug}`}
  lcpImage={service.image}
  lcpSizes="(min-width: 960px) 44vw, 100vw"
>
  <PageHead
    crumbs={[{ name: "Leistungen", href: `${base}/leistungen` }, { name: service.name }]}
    title={service.h1}
    intro={service.intro}
    image={service.image}
    imageAlt={service.imageAlt}
  >
    <div class="actions">
      <a class="btn" href={request}>
        Kostenlose Besichtigung anfragen
      </a>
      <a class="btn btn-line" href={company.phone.href}>
        <Icon name="phone" />
        {company.phone.display}
      </a>
    </div>
  </PageHead>

  <section class="band" aria-labelledby="scope-title">
    <div class="wrap rel">
      <h2 id="scope-title" class="section-title">
        Was wir übernehmen
      </h2>
      <div class="scope">
        {service.groups.map((group) => (
          <div class="group">
            <h3>{group.title}</h3>
            <ul class="items">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {service.points && !isBath && (
    <section class="band band-grout" aria-labelledby="points-title">
      <div class="wrap rel">
        <h2 id="points-title" class="section-title">
          {service.points.title}
        </h2>
        {service.points.sequence ? (
          <ol class="sequence">
            {service.points.items.map((item, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                {item}
              </li>
            ))}
          </ol>
        ) : (
          <ul class="items points">
            {service.points.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {isBath && <CostEstimator />}
  {isBath && <BathPlanner />}
  {service.points && isBath && (
    <section class="band band-grout" aria-labelledby="points-title">
      <div class="wrap rel">
        <h2 id="points-title" class="section-title">
          {service.points.title}
        </h2>
        {service.points.sequence ? (
          <ol class="sequence">
            {service.points.items.map((item, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                {item}
              </li>
            ))}
          </ol>
        ) : (
          <ul class="items points">
            {service.points.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {service.gallery.length > 0 && (
    <section class="band" aria-label="Projektfotos">
      <div class="wrap">
        <div class:list={["tiles", "gallery", `n${service.gallery.length}`]}>
          {service.gallery.map((item) => (
            <figure class="tile">
              <Zoom name={item.name} alt={item.alt} group="galerie" sizes="(min-width: 960px) 33vw, 50vw" />
            </figure>
          ))}
        </div>
        <p class="gallery-link">
          <a class="text-link" href={`${base}/referenzen`}>
            Weitere Projektfotos
          </a>
        </p>
      </div>
    </section>
  )}

  <section class:list={["band", { "band-grout": service.gallery.length > 0 && !isBath }]} aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <h2 id="faq-title" class="section-title">
        {faqTitle}
      </h2>
      <Faq faqs={service.faqs} name={`faq-${service.slug}`} />
      {isBath && (
        <p class="sources soft">
          Quellen, Stand Oktober 2026:{" "}
          {sources.map((source, index) => (
            <>
              {index > 0 && ", "}
              <a href={source.href} rel="noopener">
                {source.label}
              </a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <section class="band band-grout others" aria-labelledby="others-title">
    <div class="wrap">
      <h2 id="others-title" class="others-title">
        Weitere Leistungen
      </h2>
      <ul class="others-list">
        {others.map((other) => (
          <li>
            <a href={`${base}/leistungen/${other.slug}`}>
              <strong>{other.name}</strong>
              <span>{other.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand vorhaben={service.formValue} />
</Layout>

<style>
  .scope {
    display: grid;
    gap: 40px 48px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .group {
    display: grid;
    gap: 14px;
    align-content: start;
    padding-top: 16px;
    border-top: 2px solid var(--slate);
  }
  .points {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px 48px;
  }
  .sequence {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 32px;
  }
  @media (min-width: 640px) {
    .sequence {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .sequence {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .sequence li {
    display: grid;
    gap: 8px;
    padding: 20px 24px 24px 0;
    border-top: 2px solid var(--slate);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .sequence span {
    font-family: var(--display);
    font-size: 3rem;
    line-height: 0.9;
    color: var(--accent);
  }
  .gallery {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery .tile {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 960px) {
    .gallery.n3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery-link {
    margin-top: 20px;
  }
  .wrap.faq-wrap {
    max-width: calc(860px + var(--gutter) * 2);
  }
  .faq-wrap .section-title {
    max-width: none;
    text-align: center;
  }
  .sources {
    margin-top: 20px;
    font-size: 0.95rem;
  }
  .sources a {
    color: inherit;
  }
  .band.others {
    padding-bottom: clamp(56px, 6vw, 88px);
  }
  .band:not(.band-grout) + .band.others {
    padding-top: clamp(56px, 6vw, 88px);
  }
  .others-title {
    font-size: var(--step-3);
    margin-bottom: 24px;
  }
  .others-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--joint);
  }
  .others-list a {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 20px;
    background: var(--board);
    text-decoration: none;
  }
  .others-list strong {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .others-list span {
    color: var(--slate-soft);
  }
  .others-list a:hover strong {
    color: var(--accent);
  }
</style>
