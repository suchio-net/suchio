---
import Layout from "@/entwurf/hw/v1/Layout.astro";
import Icon from "@/entwurf/hw/v1/Icon.astro";
import Note from "@/entwurf/hw/v1/Note.astro";
import Zoom from "@/entwurf/hw/v1/Zoom.astro";
import Faq from "@/entwurf/hw/v1/Faq.astro";
import ServiceSwitch from "@/entwurf/hw/v1/ServiceSwitch.astro";
import Steps from "@/entwurf/hw/v1/Steps.astro";
import PhotoRail from "@/entwurf/hw/v1/PhotoRail.astro";
import Reviews from "@/entwurf/hw/v1/Reviews.astro";
import ContactBand from "@/entwurf/hw/v1/ContactBand.astro";
import { base, company, faqsHome, references, services } from "@/entwurf/hw/v1/data";
import { businessNode, faqNode, webPageNode, websiteNode } from "@/entwurf/hw/v1/schema";

const title = "Renovierung, Sanierung & Badsanierung in Bad Nauheim, Wetterau & Frankfurt | Handwerker.work";
const description = "Meisterbetrieb aus Bad Nauheim: Renovierung, Sanierung und Modernisierung mit Badsanierung, Fliesen, Elektro, Sanitär und Heizung aus einer Hand. Ein fester Ansprechpartner, kostenlose Besichtigung.";
const schema = [businessNode(), websiteNode(), webPageNode("/", title, description), faqNode("/", faqsHome)];
const photo = (name: string) => references.find(item => item.name === name)!;
// One photo per trade, so the first view shows the whole range, not only bathrooms.
const heroPhotos = ["elektro-raum", "bad-doppelwaschtisch", "fliesen-verlegung"].map(photo);
const rail = ["bad-wanne-holz", "dusche-nische", "bad-mosaik", "naturstein-wand", "theke-led", "dusche-regen", "bad-eckwanne", "renovierung-raum", "bad-led"].map(photo);
const steps = [
  { title: "Vorhaben schildern", text: "Erzählen Sie uns kurz, was Sie vorhaben, am Telefon, per WhatsApp oder über das Anfrageformular. Fotos helfen beim Einschätzen." },
  { title: "Beratung vor Ort", text: "Wir sehen uns die Situation an und beraten Sie persönlich. Besichtigung und Angebot sind kostenlos." },
  { title: "Angebot und Ausführung", text: "Sie erhalten ein individuelles, transparentes Angebot. Ein fester Ansprechpartner koordiniert alle Gewerke." },
];
const half = Math.ceil(faqsHome.length / 2);
---
<Layout title={title} description={description} livePath="/" schema={schema} lcpImage="elektro-raum" lcpSizes="(min-width: 960px) 50vw, 100vw">
  <section class="hero">
    <div class="wrap">
      <h1 class="hero-title">Renovierung, Sanierung und Modernisierung aus einer Hand</h1>
      <div class="hero-row rel">
        <p class="lead soft">Meisterbetrieb in Bad Nauheim für {company.credentials}. Ein fester Ansprechpartner koordiniert alle Gewerke, in der Wetterau, in Frankfurt und im Rhein-Main-Gebiet.</p>
        <div class="hero-cta">
          <div class="actions">
            <a class="btn" href={`${base}/kontakt#anfrage`}>Kostenlose Besichtigung anfragen</a>
            <a class="btn btn-line" href={company.phone.href}><Icon name="phone" />{company.phone.display}</a>
          </div>
          <p class="rating"><a href="https://g.page/handwerker-works" rel="noopener"><strong>{company.rating.value} von 5</strong> bei {company.rating.count} Google-Bewertungen</a></p>
        </div>
        <Note n={1} style="right:0;top:-72px">Statt Werbe-Popup sieht der Besucher sofort, was Sie machen, wo und wer sein Ansprechpartner ist. Das Popup verzögert heute den Seitenaufbau mobil auf 10,2 s.</Note>
      </div>
      <div class="strip">
        {heroPhotos.map((item, index) => <figure class:list={["shot", `s${index + 1}`]}><Zoom name={item.name} alt={item.alt} group="hero" eager={index === 0} sizes={index === 0 ? "(min-width: 960px) 50vw, 100vw" : "(min-width: 960px) 25vw, 50vw"} /></figure>)}
      </div>
      <dl class="facts">
        <div><dt>Gewerke</dt><dd><ul class="trades">{services.map(service => <li><a href={`${base}/leistungen/${service.slug}`}>{service.name}</a></li>)}</ul></dd></div>
        <div><dt>Ausführung</dt><dd>Eingetragener Meisterbetrieb für {company.credentials}</dd></div>
        <div><dt>Ansprechpartner</dt><dd>{company.owner}, <a href={company.phone.href}>{company.phone.display}</a></dd></div>
        <div><dt>Einsatzgebiet</dt><dd>Bad Nauheim und die Wetterau, Frankfurt und das Rhein-Main-Gebiet</dd></div>
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="services-title">
    <div class="wrap rel">
      <div class="split-head">
        <h2 id="services-title">Leistungen</h2>
        <p class="lead soft">Einzelne Arbeiten oder das ganze Projekt. Als Generalunternehmen koordinieren wir alle Gewerke, Sie haben einen Ansprechpartner.</p>
      </div>
      <ServiceSwitch />
      <Note n={2} style="right:0;top:-56px">Eine echte Seite pro Leistung, statt vier fast gleicher Standortseiten. Das TFM-Angebot hat seinen eigenen Platz für Hausverwaltungen.</Note>
    </div>
  </section>

  <section class="band process" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="section-title">Ein Ansprechpartner für alle Gewerke</h2>
      <Steps steps={steps} />
    </div>
  </section>

  <PhotoRail id="refs-title" title="Aus unseren Projekten" items={rail} link={{ href: `${base}/referenzen`, label: "Alle Referenzen ansehen" }} />

  <Reviews />

  <section class="band" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="split-head">
        <h2 id="faq-title">Häufige Fragen</h2>
        <p class="lead soft">Noch etwas offen? Rufen Sie an: <a class="text-link" href={company.phone.href}>{company.phone.display}</a></p>
      </div>
      <div class="faq-cols">
        <Faq faqs={faqsHome.slice(0, half)} name="faq-home" />
        <Faq faqs={faqsHome.slice(half)} name="faq-home" />
      </div>
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .hero { padding-block: clamp(32px, 5vw, 80px) clamp(56px, 7vw, 104px); }
  .hero-title { max-width: 17ch; font-size: clamp(2.5rem, 1.2rem + 5vw, 6rem); }
  .hero-row { display: grid; gap: 28px 64px; margin-top: clamp(24px, 3vw, 40px); }
  @media (min-width: 960px) { .hero-row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; } }
  .hero-row .lead { max-width: 46ch; }
  .hero-cta { display: grid; gap: 14px; }
  .rating { font-size: 0.97rem; color: var(--slate-soft); }
  .rating a { text-decoration: none; }
  .rating strong { color: var(--slate); }
  .rating a:hover { text-decoration: underline; }

  .strip { display: grid; grid-template-columns: 1.7fr 1fr 1fr; gap: var(--joint); height: clamp(300px, 40vw, 560px); margin-top: clamp(36px, 4vw, 56px); }
  .shot { margin: 0; overflow: hidden; border-radius: var(--radius); background: var(--grout); }
  .s2 { margin-top: clamp(24px, 4vw, 64px); }
  .s3 { margin-bottom: clamp(24px, 4vw, 64px); }
  @media (max-width: 720px) { .strip { grid-template-columns: 1fr 1fr; grid-template-rows: 220px 150px; height: auto; } .s1 { grid-column: 1 / -1; } .s2, .s3 { margin: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .shot { animation: rise 1.2s var(--ease) both; }
    .shot :global(img) { animation: settle 1.8s var(--ease) both; }
    .s2 { animation-delay: 0.1s; } .s2 :global(img) { animation-delay: 0.1s; }
    .s3 { animation-delay: 0.2s; } .s3 :global(img) { animation-delay: 0.2s; }
  }
  @keyframes rise { from { transform: translateY(48px); } }
  @keyframes settle { from { transform: scale(1.16); } }

  .facts { display: grid; gap: 22px 40px; margin-top: clamp(36px, 4vw, 56px); }
  @media (min-width: 760px) { .facts { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .facts { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
  .facts dt { margin-bottom: 6px; font-size: 0.93rem; color: var(--slate-soft); }
  .facts dd { margin: 0; font-weight: 600; line-height: 1.45; }
  .facts a { text-decoration: underline; text-decoration-color: var(--copper); text-decoration-thickness: 1.5px; text-underline-offset: 0.25em; }
  .facts a:hover { color: var(--copper-text); }
  .trades { display: flex; flex-wrap: wrap; gap: 4px 16px; }

  .split-head { display: grid; gap: 18px 64px; margin-bottom: clamp(32px, 4.5vw, 56px); }
  @media (min-width: 960px) { .split-head { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; } }
  .process { padding-top: 0; }
  .faq-cols { display: grid; gap: 0 56px; align-items: start; }
  @media (min-width: 960px) { .faq-cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 959px) { .faq-cols > :global(.faq + .faq) { border-top: 0; } }
</style>
