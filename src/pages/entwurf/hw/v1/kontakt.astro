---
import Layout from "@/entwurf/hw/v1/Layout.astro";
import Note from "@/entwurf/hw/v1/Note.astro";
import PageHead from "@/entwurf/hw/v1/PageHead.astro";
import Icon from "@/entwurf/hw/v1/Icon.astro";
import { base, company, places } from "@/entwurf/hw/v1/data";
import { breadcrumbNode, businessNode, webPageNode, websiteNode } from "@/entwurf/hw/v1/schema";

const path = "/kontakt/";
const title = "Kontakt und Anfrage – kostenlose Besichtigung | Handwerker.work";
const description = "Kontakt zu Handwerker.work in Bad Nauheim: Telefon, WhatsApp, E-Mail und Anfrageformular mit Fotos. Kostenlose Besichtigung in der Wetterau, in Frankfurt und im Rhein-Main-Gebiet.";
const crumbs = [{ name: "Start", path: "/" }, { name: "Kontakt", path }];
const schema = [businessNode(), websiteNode(), webPageNode(path, title, description, crumbs), breadcrumbNode(path, crumbs)];

const vorhaben = [
  { value: "bad", label: "Badsanierung", hint: "Komplett oder Teilsanierung" },
  { value: "renovierung", label: "Renovierung", hint: "Böden, Wände, Trockenbau" },
  { value: "fliesen", label: "Fliesen", hint: "Bad, Küche, Wand und Boden" },
  { value: "elektro", label: "Elektro", hint: "Altbau, Licht, Smart Home" },
  { value: "sanitaer", label: "Sanitär und Heizung", hint: "Leitungen, Heizung, Fußbodenheizung" },
  { value: "gebaeude", label: "Gebäudebetreuung", hint: "Für Verwaltungen und Gewerbe" },
];
const steps = ["Vorhaben", "Details", "Ort", "Kontakt"];
---
<Layout title={title} description={description} livePath={path} schema={schema} current="kontakt" actionBar={false}>
  <PageHead crumbs={[{ name: "Kontakt" }]} title="Kontakt" intro={["Rufen Sie an, schreiben Sie uns oder schildern Sie Ihr Vorhaben über das Formular. Wir beraten Sie persönlich, Besichtigung und Angebot sind kostenlos."]}>
    <dl class="details">
      <div><dt>Adresse</dt><dd>{company.name}, {company.street}, {company.postalCode} {company.city}</dd></div>
      <div><dt>Erreichbar</dt><dd>{company.hours.map(slot => <span class="hours">{slot.days} {slot.opens}–{slot.closes} Uhr</span>)}</dd></div>
      <div><dt>Ansprechpartner</dt><dd>{company.owner}, {company.ownerRole}</dd></div>
    </dl>
    <ul class="ways" slot="aside">
      <li><a href={company.phone.href}><span class="way-ico"><Icon name="phone" size={22} /></span><span><small>Telefon</small><strong class="way-big">{company.phone.display}</strong></span></a></li>
      <li><a href={company.whatsapp.href}><span class="way-ico"><Icon name="message-circle" size={22} /></span><span><small>WhatsApp</small><strong>{company.whatsapp.display}</strong></span></a></li>
      <li><a href={`mailto:${company.email}`}><span class="way-ico"><Icon name="mail" size={22} /></span><span><small>E-Mail</small><strong>{company.email}</strong></span></a></li>
      <li><a href="#anfrage"><span class="way-ico way-form"><Icon name="list-checks" size={22} /></span><span><small>Formular</small><strong>Anfrage in vier Schritten</strong></span></a></li>
    </ul>
  </PageHead>

  <section class="band" id="anfrage" aria-labelledby="form-title">
    <div class="wrap req-grid">
      <div class="req-main">
        <h2 id="form-title" class="section-title">Anfrage stellen</h2>

        <form class="wizard rel" id="wizard" action="#" method="post" novalidate data-wizard>
          <ol class="progress" aria-hidden="true" data-progress>
            {steps.map((step, index) => <li data-index={index} class={index === 0 ? "on" : undefined}><span class="p-dot">{index + 1}</span><span class="p-label">{step}</span></li>)}
          </ol>
          <div class="p-bar" aria-hidden="true"><span data-bar /></div>
          <p class="sr-only" aria-live="polite" data-announce />

          <fieldset class="step" data-step="0" aria-describedby="vorhaben-error">
            <legend tabindex="-1"><span class="s-count">Schritt 1 von 4</span>Was haben Sie vor?</legend>
            <div class="tiles-choice">
              {vorhaben.map(item => (
                <label class="choice">
                  <input type="radio" name="vorhaben" value={item.value} required />
                  <span class="choice-body"><strong>{item.label}</strong><small>{item.hint}</small></span>
                </label>
              ))}
            </div>
            <p class="err" id="vorhaben-error" role="alert" data-error-for="vorhaben" hidden>Bitte wählen Sie Ihr Vorhaben.</p>
          </fieldset>

          <fieldset class="step" data-step="1">
            <legend tabindex="-1"><span class="s-count">Schritt 2 von 4</span>Ein paar Details</legend>

            <div class="group" data-when="bad">
              <fieldset class="sub"><legend class="q">Umfang</legend>
              <div class="chips">
                <label><input type="radio" name="umfang" value="komplett" checked /><span>Komplettsanierung</span></label>
                <label><input type="radio" name="umfang" value="teil" /><span>Teilsanierung</span></label>
                <label><input type="radio" name="umfang" value="wanne-dusche" /><span>Wanne zu Dusche</span></label>
              </div></fieldset>
              <label class="q" for="m2">Badgröße <output data-m2-out>6 m²</output></label>
              <input type="range" id="m2" name="m2" min="2" max="20" step="0.5" value="6" />
              <fieldset class="sub"><legend class="q">Ausstattung</legend>
              <div class="chips">
                <label><input type="radio" name="klasse" value="standard" /><span>Standard</span></label>
                <label><input type="radio" name="klasse" value="komfort" checked /><span>Komfort</span></label>
                <label><input type="radio" name="klasse" value="premium" /><span>Premium</span></label>
              </div></fieldset>
              <label class="check"><input type="checkbox" name="barrierefrei" value="1" /><span>Barrierefrei oder bodengleiche Dusche gewünscht</span></label>
              <input type="hidden" name="stil" value="" />
              <input type="hidden" name="variante" value="" />
            </div>

            <div class="group" data-when="renovierung">
              <fieldset class="sub"><legend class="q">Objekt</legend>
              <div class="chips">
                <label><input type="radio" name="objekt" value="wohnung" checked /><span>Wohnung</span></label>
                <label><input type="radio" name="objekt" value="haus" /><span>Haus</span></label>
              </div></fieldset>
              <fieldset class="sub"><legend class="q">Welche Arbeiten?</legend>
              <div class="chips">
                {["Böden", "Wände und Decken", "Trockenbau", "Türen", "Elektro", "Bad"].map(work => <label><input type="checkbox" name="arbeiten" value={work} /><span>{work}</span></label>)}
              </div></fieldset>
              <label class="q" for="flaeche">Wohnfläche in m², optional</label>
              <input class="input short" type="number" inputmode="numeric" id="flaeche" name="flaeche" min="10" max="1000" />
            </div>

            <div class="group" data-when="fliesen">
              <fieldset class="sub"><legend class="q">Bereich</legend>
              <div class="chips">
                {["Bad", "Küche", "Wohnräume", "Andere Fläche"].map(area => <label><input type="checkbox" name="bereich" value={area} /><span>{area}</span></label>)}
              </div></fieldset>
              <label class="q" for="fliesen-m2">Fläche in m², optional</label>
              <input class="input short" type="number" inputmode="numeric" id="fliesen-m2" name="fliesen_m2" min="1" max="2000" />
            </div>

            <div class="group" data-when="elektro">
              <fieldset class="sub"><legend class="q">Worum geht es?</legend>
              <div class="chips">
                {["Altbau-Elektrik erneuern", "Grundinstallation und FI-Schutz", "Licht und Steckdosen", "Smart Home", "Wallbox"].map(topic => <label><input type="checkbox" name="elektro" value={topic} /><span>{topic}</span></label>)}
              </div></fieldset>
            </div>

            <div class="group" data-when="sanitaer">
              <fieldset class="sub"><legend class="q">Worum geht es?</legend>
              <div class="chips">
                {["Heizung modernisieren", "Fußbodenheizung", "Leitungen erneuern", "Wartung und Reparatur"].map(topic => <label><input type="checkbox" name="sanitaer" value={topic} /><span>{topic}</span></label>)}
              </div></fieldset>
            </div>

            <div class="group" data-when="gebaeude">
              <fieldset class="sub"><legend class="q">Objektart</legend>
              <div class="chips">
                {["Wohnanlage", "Gewerbeimmobilie", "Gemischt genutzt"].map(type => <label><input type="radio" name="objektart" value={type} /><span>{type}</span></label>)}
              </div></fieldset>
              <label class="q" for="einheiten">Anzahl Einheiten, ungefähr</label>
              <input class="input short" type="number" inputmode="numeric" id="einheiten" name="einheiten" min="1" max="5000" />
              <fieldset class="sub"><legend class="q">Gewünschte Leistungen</legend>
              <div class="chips">
                {["Wartung und Inspektion", "Kleinreparaturen", "Notfallservice", "Prüfpflichten und Dokumentation"].map(topic => <label><input type="checkbox" name="tfm" value={topic} /><span>{topic}</span></label>)}
              </div></fieldset>
            </div>

            <fieldset class="sub"><legend class="q">Wann soll es losgehen?</legend>
            <div class="chips">
              {["So bald wie möglich", "In 1–3 Monaten", "In 3–6 Monaten", "Noch offen"].map((when, index) => <label><input type="radio" name="zeitraum" value={when} checked={index === 3} /><span>{when}</span></label>)}
            </div></fieldset>

            <label class="q" for="beschreibung">Beschreibung, optional</label>
            <textarea class="input" id="beschreibung" name="beschreibung" rows="3"></textarea>

            <div class="upload">
              <label class="drop" for="fotos"><strong>Fotos hinzufügen, optional</strong><small>Ein paar Handyfotos helfen uns, den Aufwand einzuschätzen.</small></label>
              <input class="sr-only" type="file" id="fotos" name="fotos" accept="image/*" multiple data-files />
              <ul class="thumbs" data-thumbs></ul>
            </div>
          </fieldset>

          <fieldset class="step" data-step="2">
            <legend tabindex="-1"><span class="s-count">Schritt 3 von 4</span>Wo ist das Objekt?</legend>
            <div class="row-fields">
              <div class="field">
                <label for="plz">Postleitzahl</label>
                <input class="input" id="plz" name="plz" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" required aria-describedby="plz-status plz-error" />
              </div>
              <div class="field grow">
                <label for="ort">Ort</label>
                <input class="input" id="ort" name="ort" autocomplete="address-level2" required aria-describedby="plz-error" />
              </div>
            </div>
            <p class="area-status" id="plz-status" data-area aria-live="polite"></p>
            <p class="err" id="plz-error" role="alert" data-error-for="plz" hidden>Bitte geben Sie eine gültige Postleitzahl und den Ort an.</p>
          </fieldset>

          <fieldset class="step" data-step="3">
            <legend tabindex="-1"><span class="s-count">Schritt 4 von 4</span>Wie erreichen wir Sie?</legend>
            <div class="field">
              <label for="name">Name</label>
              <input class="input" id="name" name="name" autocomplete="name" required aria-describedby="kontakt-error" />
            </div>
            <div class="row-fields">
              <div class="field grow">
                <label for="telefon">Telefon</label>
                <input class="input" id="telefon" name="telefon" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="kontakt-error" />
              </div>
              <div class="field grow">
                <label for="email">E-Mail</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="kontakt-error" />
              </div>
            </div>
            <p class="hint">Telefon oder E-Mail genügt.</p>
            <fieldset class="sub"><legend class="q">Rückruf am liebsten</legend>
            <div class="chips">
              {["Vormittags", "Nachmittags", "Abends", "Keine Präferenz"].map((slot, index) => <label><input type="radio" name="rueckruf" value={slot} checked={index === 3} /><span>{slot}</span></label>)}
            </div></fieldset>
            <label class="check"><input type="checkbox" name="datenschutz" required aria-describedby="kontakt-error" /><span>Ich willige ein, dass Handwerker.work meine Angaben zur Bearbeitung meiner Anfrage verarbeitet. <a class="text-link" href="https://handwerker.work/datenschutzerklaerung-2/" rel="noopener">Datenschutz</a></span></label>
            <input class="hp" type="text" name="firma_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="err" id="kontakt-error" role="alert" data-error-for="kontakt" hidden>Bitte geben Sie Ihren Namen, Ihre Telefonnummer oder E-Mail-Adresse und Ihre Einwilligung an.</p>
            <p class="hint demo">Entwurf: Beim Absenden wird nichts versendet. Sie sehen eine Vorschau der Anfrage.</p>
            <Note n={2} style="right:0;top:-40px">Kein reCAPTCHA, keine Marketing-Cookies: Spam-Schutz läuft unsichtbar über den Server. Heute verlangt Ihr Formular nach Cookie-Ablehnung eine Marketing-Freigabe.</Note>
          </fieldset>

          <script is:inline>
            (function () {
              const v = new URLSearchParams(location.search).get("vorhaben");
              const known = ["bad", "renovierung", "fliesen", "elektro", "sanitaer", "gebaeude", "badsanierung", "sanitaer-heizung"];
              const form = document.getElementById("wizard");
              const step = form.querySelector(v && known.indexOf(v) > -1 ? "[data-step=\"1\"]" : "[data-step=\"0\"]");
              step.classList.add("active");
              const map = { badsanierung: "bad", "sanitaer-heizung": "sanitaer" };
              if (v && known.indexOf(v) > -1) { const t = map[v] || v; const g = form.querySelector("[data-when=\"" + t + "\"]"); if (g) g.classList.add("show"); }
            })();
          </script>
          <div class="nav" data-nav>
            <button type="button" class="btn btn-line" data-back>Zurück</button>
            <button type="submit" class="btn" data-next><span data-next-label>Weiter</span></button>
          </div>
          <p class="saved soft" data-saved hidden>Ihre Angaben bleiben auf diesem Gerät gespeichert, bis Sie absenden.</p>
          <Note n={1} style="right:0;top:-52px">Die Anfrage bringt mit, was Sie zur Einschätzung brauchen: Leistung, Umfang, Ort, Zeitraum und Fotos. Heute fragt Ihr Formular nur Name, E-Mail und Nachricht ab.</Note>
        </form>

        <section class="done" data-done hidden aria-labelledby="done-title" tabindex="-1">
          <h2 id="done-title" data-done-title>Danke! Ihre Anfrage ist da.</h2>
          <p class="lead">Wir melden uns bei Ihnen und vereinbaren einen Termin zur kostenlosen Besichtigung.</p>
          <p class="demo">Entwurf: Es wurde nichts versendet.</p>
          <div class="mail rel">
            <p class="mail-label">So kommt Ihre Anfrage bei {company.name} an</p>
            <div class="mail-card">
              <p class="soft">Neue Anfrage über handwerker.work</p>
              <p class="mail-subject" data-mail-subject />
              <dl data-mail-fields />
            </div>
            <Note n={3} style="right:0;top:-44px">Jede Anfrage kommt vorsortiert an: Leistung, Größe, Ort, Zeitraum, Rückrufwunsch, Fotos. So rufen Sie zuerst die passenden Kunden an und sehen, welche Seite Anfragen bringt.</Note>
          </div>
          <a class="text-link" href={base}>Zur Startseite</a>
        </section>
      </div>

      <aside class="req-side" aria-label="Ihre Angaben">
        <div class="summary" data-summary hidden>
          <p class="sum-title">Ihre Angaben</p>
          <dl data-summary-list />
        </div>
        <div class="area">
          <p class="sum-title">Einsatzgebiet</p>
          <p class="soft">{places.map(place => place.name).join(", ")}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .details { display: grid; gap: 12px; }
  .details div { display: grid; grid-template-columns: 140px 1fr; gap: 12px; }
  .details dt { color: var(--slate-soft); }
  .details dd { margin: 0; font-weight: 600; display: flex; flex-wrap: wrap; gap: 0 16px; }
  @media (max-width: 560px) { .details div { grid-template-columns: 1fr; gap: 0; } }
  .ways { display: grid; gap: 10px; }
  .ways a { display: flex; align-items: center; gap: 18px; padding: 18px 22px; border-radius: var(--radius); background: var(--board); text-decoration: none; transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  .ways a:hover { transform: translateX(6px); box-shadow: var(--shadow); }
  .ways a > span:last-child { display: grid; gap: 2px; min-width: 0; }
  .ways small { font-size: 0.9rem; color: var(--slate-soft); }
  .ways strong { font-size: 1.15rem; font-weight: 620; overflow-wrap: anywhere; }
  .ways .way-big { font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.2rem); letter-spacing: -0.03em; line-height: 1.1; }
  .way-ico { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; background: var(--copper-wash); color: var(--copper-text); }
  .way-form { background: var(--grout); color: var(--slate); }
  .req-main { padding: clamp(24px, 4vw, 56px); border-radius: calc(var(--radius) * 1.4); background: var(--board); }

  .req-grid { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 1100px) { .req-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; } }
  .req-main { max-width: 820px; }
  .req-side { display: grid; gap: 28px; }
  @media (max-width: 1099px) { .summary { display: none !important; } }
  .sum-title { margin-bottom: 8px; font-weight: 700; }
  .summary dl, .mail-card dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0; }
  .summary dt, .mail-card dt { color: var(--slate-soft); }
  .summary dd, .mail-card dd { margin: 0; font-weight: 700; word-break: break-word; }
  .summary { padding-top: 12px; border-top: 1px solid var(--grout-line); }
  .area { padding-top: 12px; border-top: 1px solid var(--grout-line); }

  .wizard { padding-top: 4px; }
  .progress { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 10px; }
  .progress li { display: flex; align-items: center; gap: 8px; color: var(--slate-soft); font-weight: 700; }
  .p-dot { display: grid; place-items: center; width: 28px; height: 28px; flex: none; border: 2px solid var(--grout-line); font-size: 0.9rem; }
  .progress li.on { color: var(--slate); }
  .progress li.on .p-dot { border-color: var(--copper); background: var(--copper); color: #fff; }
  .progress li.done .p-dot { border-color: var(--slate); background: var(--slate); color: #fff; }
  @media (max-width: 560px) { .p-label { display: none; } .progress li.on .p-label { display: inline; } }
  .p-bar { height: 3px; margin-bottom: 32px; background: var(--grout); }
  .p-bar span { display: block; height: 100%; width: 25%; background: var(--copper); transition: width 0.4s ease; }
  .step { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 14px; }
  :global(.js) .step { display: none; }
  :global(.js) .step.active { display: grid; }
  :global(html:not(.js)) .step + .step { margin-top: 40px; }
  legend { padding: 0; margin-bottom: 10px; font-family: var(--display); font-size: var(--step-3); font-weight: 700; line-height: 1.05; outline: none; }
  .s-count { display: block; margin-bottom: 6px; font-family: var(--text); font-size: 1rem; color: var(--slate-soft); }
  .tiles-choice { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .choice { position: relative; cursor: pointer; }
  .choice input { position: absolute; opacity: 0; }
  .choice-body { display: grid; gap: 2px; height: 100%; padding: 16px 18px; border: 2px solid var(--grout-line); border-radius: var(--radius-sm); }
  .choice-body strong { font-size: var(--step-1); }
  .choice-body small { color: var(--slate-soft); font-size: 0.95rem; }
  .choice:hover .choice-body { border-color: var(--slate-soft); }
  .choice input:checked + .choice-body { border-color: var(--slate); box-shadow: inset 0 0 0 1.5px var(--copper); }
  .choice input:focus-visible + .choice-body { outline: 3px solid var(--copper); outline-offset: 2px; }
  .group { display: none; gap: 14px; }
  .group.show { display: grid; }
  :global(html:not(.js)) .group { display: grid; }
  .q { margin-top: 6px; font-weight: 700; display: flex; justify-content: space-between; }
  .sub { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 10px; }
  .sub > legend.q { padding: 0; margin: 6px 0 4px; font-family: var(--text); font-size: 1.0625rem; line-height: 1.4; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips label { position: relative; cursor: pointer; }
  .chips input { position: absolute; opacity: 0; }
  .chips span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border: 2px solid var(--grout-line); border-radius: 999px; }
  .chips label:hover span { border-color: var(--slate-soft); }
  .chips input:checked + span { border-color: var(--slate); box-shadow: inset 0 0 0 1.5px var(--copper); font-weight: 700; }
  .chips input:focus-visible + span { outline: 3px solid var(--copper); outline-offset: 2px; }
  input[type="range"] { width: 100%; accent-color: var(--copper); }
  .input { width: 100%; min-height: 50px; padding: 10px 14px; border: 2px solid var(--grout-line); border-radius: var(--radius-sm); background: var(--board); font-size: 1.0625rem; }
  .input:focus { outline: none; border-color: var(--slate); }
  .input[aria-invalid="true"] { border-color: #b3261e; }
  .input.short { max-width: 200px; }
  textarea.input { resize: vertical; min-height: 96px; }
  .row-fields { display: flex; flex-wrap: wrap; gap: 14px; }
  .field { display: grid; gap: 6px; }
  .field.grow { flex: 1 1 220px; }
  .field label { font-weight: 700; }
  .check { display: flex; gap: 12px; align-items: flex-start; margin-top: 6px; cursor: pointer; }
  .check input { width: 22px; height: 22px; margin-top: 2px; accent-color: var(--copper); flex: none; }
  .hint { color: var(--slate-soft); }
  .demo { padding: 10px 14px; background: var(--grout); }
  .upload { display: grid; gap: 12px; margin-top: 6px; }
  .drop { display: grid; gap: 2px; padding: 18px; border: 2px dashed var(--grout-line); cursor: pointer; }
  .drop small { color: var(--slate-soft); }
  .drop:hover, .upload:focus-within .drop { border-color: var(--slate); }
  .thumbs { display: flex; flex-wrap: wrap; gap: 8px; }
  .thumbs li { position: relative; width: 76px; height: 76px; overflow: hidden; background: var(--grout); }
  .thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .thumbs button { position: absolute; right: 4px; top: 4px; display: grid; place-items: center; width: 24px; height: 24px; border: 0; background: rgb(0 0 0 / 0.65); color: #fff; cursor: pointer; }
  .area-status { display: none; padding: 12px 14px; font-weight: 700; }
  .area-status.in { display: block; background: #e3efe6; color: #1f5c36; }
  .area-status.out { display: block; background: var(--grout); }
  .err { color: #b3261e; font-weight: 700; }
  .err[hidden], .summary[hidden], .done[hidden], [data-saved][hidden] { display: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--grout-line); }
  :global(html:not(.js)) .nav [data-back] { display: none; }
  .nav [data-back][disabled] { visibility: hidden; }
  .saved { margin-top: 12px; font-size: 0.95rem; }
  .done { display: grid; gap: 18px; justify-items: start; outline: none; }
  .done h2 { font-size: var(--step-4); }
  .mail { width: 100%; margin-top: 8px; }
  .mail-label { margin-bottom: 10px; font-weight: 700; }
  .mail-card { display: grid; gap: 6px; padding: 20px; border: 2px solid var(--slate); }
  .mail-subject { margin-bottom: 10px; font-size: var(--step-1); font-weight: 700; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-wizard]")!;
  const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>("[data-step]"));
  const back = form.querySelector<HTMLButtonElement>("[data-back]")!, nextLabel = form.querySelector<HTMLElement>("[data-next-label]")!;
  const bar = form.querySelector<HTMLElement>("[data-bar]")!, progress = Array.from(form.querySelectorAll<HTMLElement>("[data-progress] li"));
  const announce = form.querySelector<HTMLElement>("[data-announce]")!, saved = form.querySelector<HTMLElement>("[data-saved]")!;
  const summary = document.querySelector<HTMLElement>("[data-summary]")!, summaryList = document.querySelector<HTMLElement>("[data-summary-list]")!;
  const done = document.querySelector<HTMLElement>("[data-done]")!;
  const labels: Record<string, string> = { bad: "Badsanierung", renovierung: "Renovierung", fliesen: "Fliesenarbeiten", elektro: "Elektro", sanitaer: "Sanitär & Heizung", gebaeude: "Gebäudebetreuung" };
  const storageKey = "hw-anfrage";
  let current = 0;

  // Service area: postcode prefixes of the places named on the current site.
  const known: Record<string, string> = { "61231": "Bad Nauheim", "61169": "Friedberg", "35510": "Butzbach", "61239": "Ober-Mörlen", "61200": "Wölfersheim", "61191": "Rosbach vor der Höhe", "61184": "Karben", "61130": "Nidderau", "61381": "Friedrichsdorf", "61348": "Bad Homburg", "61350": "Bad Homburg", "61352": "Bad Homburg", "61440": "Oberursel", "61476": "Kronberg", "65760": "Eschborn", "63065": "Offenbach", "63067": "Offenbach", "63069": "Offenbach", "63071": "Offenbach", "63073": "Offenbach", "63075": "Offenbach", "63477": "Maintal", "63450": "Hanau", "63452": "Hanau", "63454": "Hanau", "63456": "Hanau", "63457": "Hanau" };
  const inArea = (plz: string) => /^(60|61|6592|6593|6306|6307|6345|63477|65760|35510)/.test(plz);

  const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value ?? "";
  const checked = (name: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map(input => input.value);

  const showGroups = () => {
    const type = value("vorhaben");
    form.querySelectorAll<HTMLElement>("[data-when]").forEach(group => group.classList.toggle("show", group.dataset.when === type));
  };

  const go = (index: number, focus = true) => {
    current = Math.max(0, Math.min(steps.length - 1, index));
    steps.forEach((step, i) => step.classList.toggle("active", i === current));
    progress.forEach((item, i) => { item.classList.toggle("on", i === current); item.classList.toggle("done", i < current); });
    bar.style.width = `${((current + 1) / steps.length) * 100}%`;
    back.disabled = current === 0;
    nextLabel.textContent = current === steps.length - 1 ? "Anfrage senden" : "Weiter";
    announce.textContent = `Schritt ${current + 1} von ${steps.length}: ${steps[current].querySelector("legend")!.lastChild!.textContent}`;
    if (focus) { steps[current].querySelector<HTMLElement>("legend")!.focus({ preventScroll: true }); form.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" }); }
  };

  const setError = (key: string, on: boolean, fields: HTMLElement[] = []) => {
    const el = form.querySelector<HTMLElement>(`[data-error-for="${key}"]`);
    if (el) el.hidden = !on;
    fields.forEach(field => field.setAttribute("aria-invalid", String(on)));
    return !on;
  };

  const validate = (index: number) => {
    if (index === 0) return setError("vorhaben", !value("vorhaben"));
    if (index === 2) {
      const plz = form.querySelector<HTMLInputElement>("#plz")!, ort = form.querySelector<HTMLInputElement>("#ort")!;
      const bad = !/^\d{5}$/.test(plz.value) || !ort.value.trim();
      const ok = setError("plz", bad, [plz, ort]);
      if (!ok) (/^\d{5}$/.test(plz.value) ? ort : plz).focus();
      return ok;
    }
    if (index === 3) {
      const name = form.querySelector<HTMLInputElement>("#name")!, tel = form.querySelector<HTMLInputElement>("#telefon")!, mail = form.querySelector<HTMLInputElement>("#email")!;
      const consent = form.querySelector<HTMLInputElement>('input[name="datenschutz"]')!;
      const telValue = tel.value.trim(), mailValue = mail.value.trim();
      const telOk = !telValue || telValue.replace(/\D/g, "").length >= 6;
      const mailOk = !mailValue || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mailValue);
      const invalid: HTMLInputElement[] = [];
      if (!name.value.trim()) invalid.push(name);
      if (!telOk) invalid.push(tel);
      if (!mailOk) invalid.push(mail);
      if (!telValue && !mailValue) invalid.push(tel, mail);
      if (!consent.checked) invalid.push(consent);
      [name, tel, mail, consent].forEach(field => field.setAttribute("aria-invalid", String(invalid.includes(field))));
      const message = form.querySelector<HTMLElement>('[data-error-for="kontakt"]')!;
      const problems = [!name.value.trim() && "Ihren Namen", !telOk && "eine gültige Telefonnummer", !mailOk && "eine gültige E-Mail-Adresse", !telValue && !mailValue && "Telefon oder E-Mail", !consent.checked && "Ihre Einwilligung"].filter(Boolean);
      message.textContent = `Bitte ergänzen Sie ${problems.join(", ").replace(/, ([^,]*)$/, " und $1")}.`;
      setError("kontakt", invalid.length > 0);
      invalid[0]?.focus();
      return invalid.length === 0;
    }
    return true;
  };

  const describe = () => {
    const type = value("vorhaben");
    const rows: [string, string][] = [];
    if (type) rows.push(["Vorhaben", labels[type]]);
    if (type === "bad") {
      const umfang = { komplett: "Komplettsanierung", teil: "Teilsanierung", "wanne-dusche": "Wanne zu Dusche" }[value("umfang")] ?? "";
      rows.push(["Umfang", umfang], ["Größe", `${value("m2").replace(".", ",")} m²`], ["Ausstattung", value("klasse").replace(/^./, c => c.toUpperCase())]);
      if (checked("barrierefrei").length) rows.push(["Wunsch", "Barrierefrei / bodengleich"]);
      const stil = ({ hell: "Hell & Eiche", anthrazit: "Anthrazit & Messing", salbei: "Salbei & Weiß" } as Record<string, string>)[value("stil")];
      if (stil) rows.push(["3D-Vorschau", `${stil}, ${value("variante") === "dusche" ? "Bodengleiche Dusche" : "Badewanne"}`]);
    }
    if (type === "renovierung") { rows.push(["Objekt", value("objekt") === "haus" ? "Haus" : "Wohnung"]); if (checked("arbeiten").length) rows.push(["Arbeiten", checked("arbeiten").join(", ")]); if (value("flaeche")) rows.push(["Fläche", `${value("flaeche")} m²`]); }
    if (type === "fliesen") { if (checked("bereich").length) rows.push(["Bereich", checked("bereich").join(", ")]); if (value("fliesen_m2")) rows.push(["Fläche", `${value("fliesen_m2")} m²`]); }
    if (type === "elektro" && checked("elektro").length) rows.push(["Themen", checked("elektro").join(", ")]);
    if (type === "sanitaer" && checked("sanitaer").length) rows.push(["Themen", checked("sanitaer").join(", ")]);
    if (type === "gebaeude") { if (value("objektart")) rows.push(["Objekt", value("objektart")]); if (value("einheiten")) rows.push(["Einheiten", value("einheiten")]); if (checked("tfm").length) rows.push(["Leistungen", checked("tfm").join(", ")]); }
    if (type) rows.push(["Start", value("zeitraum")]);
    const plz = value("plz"), ort = value("ort");
    if (plz || ort) rows.push(["Ort", `${plz} ${ort}`.trim() + (plz.length === 5 ? (inArea(plz) ? ", im Einsatzgebiet" : ", außerhalb des Kerngebiets") : "")]);
    if (files.length) rows.push(["Fotos", `${files.length} angehängt`]);
    return rows;
  };
  const renderList = (target: HTMLElement, rows: [string, string][]) => {
    target.replaceChildren(...rows.flatMap(([term, detail]) => { const dt = document.createElement("dt"), dd = document.createElement("dd"); dt.textContent = term; dd.textContent = detail; return [dt, dd]; }));
  };
  const refresh = () => {
    showGroups();
    const out = form.querySelector<HTMLElement>("[data-m2-out]");
    if (out) out.textContent = `${value("m2").replace(".", ",")} m²`;
    const rows = describe();
    summary.hidden = rows.length === 0;
    renderList(summaryList, rows);
  };

  // Photos: local previews only.
  let files: File[] = [];
  const fileInput = form.querySelector<HTMLInputElement>("[data-files]")!, thumbs = form.querySelector<HTMLElement>("[data-thumbs]")!;
  const renderThumbs = () => {
    thumbs.replaceChildren(...files.map((file, index) => {
      const li = document.createElement("li"), img = document.createElement("img"), remove = document.createElement("button");
      img.src = URL.createObjectURL(file); img.alt = file.name; img.onload = () => URL.revokeObjectURL(img.src);
      remove.type = "button"; remove.textContent = "×"; remove.setAttribute("aria-label", `${file.name} entfernen`);
      remove.addEventListener("click", () => { files.splice(index, 1); renderThumbs(); refresh(); });
      li.appendChild(img);
      li.appendChild(remove);
      return li;
    }));
  };
  fileInput.addEventListener("change", () => { files = [...files, ...Array.from(fileInput.files ?? [])].slice(0, 8); fileInput.value = ""; renderThumbs(); refresh(); });

  // Postcode check and city autofill.
  const plzInput = form.querySelector<HTMLInputElement>("#plz")!, ortInput = form.querySelector<HTMLInputElement>("#ort")!, area = form.querySelector<HTMLElement>("[data-area]")!;
  let autoCity = "";
  plzInput.addEventListener("input", () => {
    plzInput.value = plzInput.value.replace(/\D/g, "").slice(0, 5);
    const plz = plzInput.value;
    area.className = "area-status";
    if (plz.length === 5) {
      if (known[plz] && (!ortInput.value || ortInput.value === autoCity)) { ortInput.value = known[plz]; autoCity = known[plz]; }
      else if (!known[plz] && autoCity && ortInput.value === autoCity) { ortInput.value = ""; autoCity = ""; }
      if (inArea(plz)) { area.classList.add("in"); area.textContent = "✓ Liegt in unserem Einsatzgebiet. Die Besichtigung ist kostenlos."; }
      else { area.classList.add("out"); area.textContent = "Ihr Ort liegt außerhalb unseres Kerngebiets. Senden Sie die Anfrage trotzdem; wir prüfen, ob wir helfen können."; }
    } else area.textContent = "";
  });

  // Draft persistence (without photos).
  const save = () => {
    const data: Record<string, string[]> = {};
    new FormData(form).forEach((v, k) => { if (typeof v === "string" && k !== "firma_website") (data[k] ??= []).push(v); });
    try { sessionStorage.setItem(storageKey, JSON.stringify(data)); saved.hidden = false; } catch { /* storage unavailable */ }
  };
  const restore = (data: Record<string, string[]>) => {
    for (const [name, values] of Object.entries(data)) {
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`).forEach(field => {
        if (field instanceof HTMLInputElement && (field.type === "radio" || field.type === "checkbox")) field.checked = values.includes(field.value);
        else field.value = values[0] ?? "";
      });
    }
  };

  let draft: Record<string, string[]> | undefined;
  try { draft = JSON.parse(sessionStorage.getItem(storageKey) ?? "null") ?? undefined; } catch { draft = undefined; }
  if (draft) restore(draft);
  const params = new URLSearchParams(location.search);
  const fromUrl: Record<string, string[]> = {};
  for (const key of ["vorhaben", "umfang", "klasse", "m2", "stil", "variante"]) { const v = params.get(key); if (v) fromUrl[key] = [v]; }
  if (params.has("umfang") || params.has("stil")) fromUrl.barrierefrei = params.get("barrierefrei") ? ["1"] : [];
  if (params.has("umfang") && !params.has("stil")) { fromUrl.stil = [""]; fromUrl.variante = [""]; }
  const legacy: Record<string, string> = { badsanierung: "bad", "sanitaer-heizung": "sanitaer" };
  if (fromUrl.vorhaben) fromUrl.vorhaben = [legacy[fromUrl.vorhaben[0]] ?? fromUrl.vorhaben[0]];
  restore(fromUrl);
  plzInput.dispatchEvent(new Event("input"));
  refresh();
  go(fromUrl.vorhaben && value("vorhaben") ? 1 : 0, false);

  let pointerPick = false;
  form.querySelectorAll(".choice").forEach(tile => tile.addEventListener("pointerdown", () => { pointerPick = true; }));
  form.addEventListener("keydown", () => { pointerPick = false; });
  form.addEventListener("change", event => {
    refresh(); save();
    if ((event.target as HTMLInputElement).name === "vorhaben" && current === 0) {
      setError("vorhaben", false);
      if (pointerPick) setTimeout(() => go(1), 220);
      pointerPick = false;
    }
  });
  form.addEventListener("input", () => { refresh(); save(); });
  back.addEventListener("click", () => go(current - 1));
  form.addEventListener("submit", event => {
    event.preventDefault();
    if (!validate(current)) return;
    if (current < steps.length - 1) return go(current + 1);
    if (value("firma_website")) return;
    const rows = describe();
    const contact: [string, string][] = [["Name", value("name")]];
    if (value("telefon")) contact.push(["Telefon", value("telefon")]);
    if (value("email")) contact.push(["E-Mail", value("email")]);
    contact.push(["Rückruf", value("rueckruf")]);
    if (value("beschreibung")) contact.push(["Nachricht", value("beschreibung")]);
    renderList(document.querySelector<HTMLElement>("[data-mail-fields]")!, [...rows, ...contact]);
    const type = value("vorhaben");
    const subjectBits = [labels[type], type === "bad" ? `${value("m2").replace(".", ",")} m²` : "", `${value("plz")} ${value("ort")}`.trim()].filter(Boolean);
    document.querySelector<HTMLElement>("[data-mail-subject]")!.textContent = `Anfrage: ${subjectBits.join(", ")}`;
    const first = value("name").trim().split(/\s+/)[0];
    document.querySelector<HTMLElement>("[data-done-title]")!.textContent = first ? `Danke, ${first}! Ihre Anfrage ist da.` : "Danke! Ihre Anfrage ist da.";
    try { sessionStorage.removeItem(storageKey); } catch { /* storage unavailable */ }
    form.hidden = true;
    summary.hidden = true;
    done.hidden = false;
    done.focus();
    done.scrollIntoView({ block: "start" });
  });
</script>
