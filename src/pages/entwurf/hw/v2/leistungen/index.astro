---
import Layout from "@/entwurf/hw/v2/Layout.astro";
import Note from "@/entwurf/hw/v2/Note.astro";
import Picture from "@/entwurf/hw/v2/Picture.astro";
import PageHead from "@/entwurf/hw/v2/PageHead.astro";
import ContactBand from "@/entwurf/hw/v2/ContactBand.astro";
import { base, services, tfm } from "@/entwurf/hw/v2/data";
import { breadcrumbNode, businessNode, webPageNode, websiteNode } from "@/entwurf/hw/v2/schema";

const path = "/leistungen/";
const title = "Leistungen: Bad, Sanitär, Heizung, Elektro, Fliesen, Renovierung | Handwerker.work";
const description = "Meisterbetrieb für Badsanierung, Elektroinstallation, Sanitär und Heizung, Fliesenverlegung sowie Sanierung und Renovierung in Bad Nauheim, der Wetterau und Frankfurt.";
const crumbs = [{ name: "Start", path: "/" }, { name: "Leistungen", path }];
const schema = [businessNode(), websiteNode(), webPageNode(path, title, description, crumbs), breadcrumbNode(path, crumbs)];
// From the "Beratung und Planung" and "Service und Wartung" blocks of the current overview page.
const extras = [
  { title: "Beratung und Planung", items: ["Kostenlose Erstberatung vor Ort", "3D-Badplanung und Visualisierung", "Energie- und Fördermittelberatung"] },
  { title: "Service und Wartung", items: ["Störungsbehebung", "Rohrbruch- und Leckageortung", "Wartungsverträge und Heizungswartung", "E-Check und Wartungsberichte"] },
];
---
<Layout title={title} description={description} livePath={path} schema={schema} current="leistungen">
  <PageHead crumbs={[{ name: "Leistungen" }]} title="Leistungen" intro={["Ihr Meisterbetrieb für Badsanierung, Elektroinstallation, Sanitär und Heizung, Fliesenverlegung sowie Sanierung und Renovierung. Einzelne Arbeiten oder das ganze Projekt, mit einem Ansprechpartner für alle Gewerke."]} />

  <section class="band" aria-label="Alle Leistungen">
    <div class="wrap">
      <ul class="list rel">
        {services.map(service => (
          <li class="entry">
            <a class="entry-photo" href={`${base}/leistungen/${service.slug}`} tabindex="-1" aria-hidden="true"><Picture name={service.image} alt="" sizes="(min-width: 860px) 30vw, 100vw" /></a>
            <div class="entry-text">
              <h2><a href={`${base}/leistungen/${service.slug}`}>{service.name}</a></h2>
              <p class="soft">{service.summary}</p>
              <ul class="items">{service.groups.flatMap(group => group.items).slice(0, 4).map(item => <li>{item}</li>)}</ul>
              <a class="text-link" href={`${base}/leistungen/${service.slug}`}>{service.name} im Detail</a>
            </div>
          </li>
        ))}
        <Note n={1} style="right:0;top:-48px">Eine Übersicht mit kurzen Wegen in jede Leistung. Heute gibt es zwei Leistungsseiten mit gleichem Inhalt, eine davon mit „| 100%“ im Titel.</Note>
      </ul>
    </div>
  </section>

  <section class="band band-grout" aria-labelledby="extras-title">
    <div class="wrap">
      <h2 id="extras-title" class="sr-only">Beratung, Service und Gebäudebetreuung</h2>
      <div class="extras">
        {extras.map(extra => (
          <div class="extra">
            <h3>{extra.title}</h3>
            <ul class="items">{extra.items.map(item => <li>{item}</li>)}</ul>
          </div>
        ))}
        <div class="extra extra-b2b dark">
          <h3>{tfm.name}</h3>
          <p class="soft">{tfm.summary}</p>
          <a class="text-link" href={tfm.href}>Zur Gebäudebetreuung</a>
        </div>
      </div>
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .list { display: grid; border-top: 2px solid var(--slate); }
  .entry { display: grid; gap: 20px 40px; padding-block: 28px; border-bottom: 1px solid var(--grout-line); }
  @media (min-width: 860px) { .entry { grid-template-columns: 340px 1fr; } }
  .entry-photo { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--grout); }
  .entry-photo :global(picture), .entry-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .entry-text { display: grid; gap: 12px; align-content: start; }
  .entry-text h2 { font-size: var(--step-3); }
  .entry-text h2 a { text-decoration: none; }
  .entry-text h2 a:hover { color: var(--copper); }
  .entry-text .items { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 6px 32px; }
  .extras { display: grid; gap: var(--joint); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .extra { display: grid; gap: 14px; align-content: start; padding: 24px; background: var(--board); }
  .extra-b2b { background: var(--slate); }
</style>
