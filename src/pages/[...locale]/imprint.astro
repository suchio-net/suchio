---
import type { GetStaticPaths } from "astro";
import LegalPage from "@/components/legal-page.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { localeStaticPaths, t, type Locale } from "@/lib/i18n";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<SiteLayout
  locale={locale}
  title={t(locale, "imprint.title")}
  description={t(locale, "meta.imprintDescription")}
  noindex
>
  <LegalPage locale={locale} kind="imprint" />
</SiteLayout>
