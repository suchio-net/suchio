---
import type { GetStaticPaths } from "astro";
import SiteLayout from "@/layouts/site-layout.astro";
import AboutScenes from "@/components/about-scenes.astro";
import FinalCta from "@/components/final-cta.astro";
import Reveal from "@/components/reveal.astro";
import SectionHeading from "@/components/section-heading.astro";
import { localeStaticPaths, localizePath, t, type Locale } from "@/lib/i18n";
import { breadcrumbNode, organizationReference, pageNode } from "@/lib/structured-data";
export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const principles = [
  ["about.principle1Title", "about.principle1Copy"],
  ["about.principle2Title", "about.principle2Copy"],
  ["about.principle3Title", "about.principle3Copy"],
  ["about.principle4Title", "about.principle4Copy"],
] as const;
---

<SiteLayout
  locale={locale}
  title={t(locale, "meta.aboutTitle")}
  description={t(locale, "meta.aboutDescription")}
  schema={[
    pageNode(locale, localizePath("/about", locale), t(locale, "meta.aboutTitle"), "AboutPage", {
      about: organizationReference,
      mainEntity: organizationReference,
    }),
    breadcrumbNode(locale, [{ name: t(locale, "nav.about"), path: localizePath("/about", locale) }]),
  ]}
>
  <main id="main-content">
    <section class="px-page pt-page-title pb-section-compact">
      <Reveal className="mx-auto max-w-[70rem]">
        <h1 class="m-0 max-w-[22ch] text-display-sm text-balance">{t(locale, "about.title")}</h1>
        <p class="mt-6 mb-0 max-w-[38rem] text-lead text-muted text-balance">{t(locale, "about.copy")}</p>
      </Reveal>
    </section>

    <section class="px-page pb-section">
      <div class="mx-auto max-w-[70rem]">
        <SectionHeading title={t(locale, "about.pov")} copy={t(locale, "about.pov1")} />
        <AboutScenes locale={locale} />
        <p class="mt-12 mb-0 max-w-[38rem] text-lg/7 text-ink">{t(locale, "about.pov2")}</p>
      </div>
    </section>

    <section class="px-page pb-section">
      <div class="mx-auto max-w-[70rem]">
        <SectionHeading title={t(locale, "about.howTitle")} copy={t(locale, "about.howCopy")} />
        <div class="grid grid-cols-2 gap-x-grid max-compact:grid-cols-1">
          {principles.map(([headingKey, copyKey]) => (
            <div class="border-t border-line-strong pt-6 pb-9">
              <h3 class="m-0 text-heading-sm">{t(locale, headingKey)}</h3>
              <p class="mt-2 mb-0 max-w-[38rem] text-base/6 text-muted">{t(locale, copyKey)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCta locale={locale} />
  </main>
</SiteLayout>
