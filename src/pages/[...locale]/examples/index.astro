---
import type { GetStaticPaths } from "astro";
import ConceptPreview from "@/components/concept-preview.astro";
import CtaButton from "@/components/cta-button.astro";
import EditorialHero from "@/components/editorial-hero.astro";
import FinalCta from "@/components/final-cta.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { getExamplesCopy } from "@/i18n/examples";
import { localeStaticPaths, localizePath, type Locale } from "@/lib/i18n";
import { pageNode } from "@/lib/structured-data";
import { industryPreview, industrySlugs } from "@/examples/industries";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const examples = getExamplesCopy(locale);
const copy = examples.overview;
---

<SiteLayout
  locale={locale}
  title={copy.title.replace(/ \| Suchio$/, "")}
  description={copy.description}
  schema={[pageNode(locale, localizePath("/examples", locale), copy.title)]}
>
  <main id="main-content">
    <EditorialHero title={copy.h1} copy={copy.intro} />
    <section class="px-page pb-section">
      <div class="mx-auto grid max-w-layout grid-cols-2 gap-8 max-nav:grid-cols-1">
        {industrySlugs.map((industry) => {
          const path = localizePath(`/examples/${industry}`, locale);
          const card = examples[industry];
          return (
            <article class="rounded-card bg-white p-card-fluid shadow-surface">
              <a href={path} tabindex="-1" aria-hidden="true" class="mb-6 block">
                <ConceptPreview base={industryPreview(industry)} sizes="(max-width: 900px) 100vw, 36rem" />
              </a>
              <h2 class="m-0 text-heading-md">{card.label}</h2>
              <p class="mt-3 text-lg/7 text-muted">{card.cardText}</p>
              <CtaButton href={path} className="mt-8 [&>span:first-child]:min-w-0">
                {card.cardLink}
              </CtaButton>
            </article>
          );
        })}
      </div>
    </section>

    <FinalCta locale={locale} />
  </main>
</SiteLayout>
