---
import type { GetStaticPaths } from "astro";
import ConceptPreview from "@/components/concept-preview.astro";
import CtaButton from "@/components/cta-button.astro";
import EditorialHero from "@/components/editorial-hero.astro";
import FinalCta from "@/components/final-cta.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { getExamplesCopy } from "@/i18n/examples";
import { localeStaticPaths, localizePath, type Locale } from "@/lib/i18n";
import { pageNode } from "@/lib/structured-data";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { overview: copy } = getExamplesCopy(locale);
---

<SiteLayout
  locale={locale}
  title={copy.title.replace(/ \| Suchio$/, "")}
  description={copy.description}
  schema={[pageNode(locale, localizePath("/examples", locale), copy.title)]}
>
  <main id="main-content">
    <EditorialHero title={copy.h1} copy={copy.intro} />
    <section class="px-page pb-section">
      <div class="mx-auto max-w-[70rem]">
        <article class="mx-auto max-w-[45rem] rounded-card bg-white p-card-fluid shadow-surface">
          <a href={localizePath("/examples/hotels", locale)} tabindex="-1" aria-hidden="true" class="mb-6 block">
            <ConceptPreview sizes="(max-width: 760px) 100vw, 640px" />
          </a>
          <h2 class="m-0 text-heading-md">{copy.cardTitle}</h2>
          <p class="mt-3 text-lg/7 text-muted">{copy.cardText}</p>
          <CtaButton href={localizePath("/examples/hotels", locale)} className="mt-8 [&>span:first-child]:min-w-0">
            {copy.cardLink}
          </CtaButton>
        </article>
      </div>
    </section>

    <FinalCta locale={locale} />
  </main>
</SiteLayout>
