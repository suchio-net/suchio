---
import type { GetStaticPaths } from "astro";
import ConceptPreview from "@/components/concept-preview.astro";
import CtaButton from "@/components/cta-button.astro";
import EditorialHero from "@/components/editorial-hero.astro";
import Faq from "@/components/faq.astro";
import SectionHeading from "@/components/section-heading.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { getExamplesCopy } from "@/i18n/examples";
import { localeStaticPaths, localizePath, type Locale } from "@/lib/i18n";
import { breadcrumbNode, faqEntities, pageNode } from "@/lib/structured-data";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { overview, hotels: copy } = getExamplesCopy(locale);
const path = localizePath("/examples/hotels", locale);
const conceptHref = "/examples/hotels/flughotel-nordtor";
const faqs = copy.faqs.map((item) => ({
  ...item,
  answerLink: item.linkText ? { text: item.linkText, href: localizePath("/services/seo", locale) } : undefined,
}));
---

<SiteLayout
  locale={locale}
  title={copy.title.replace(/ \| Suchio$/, "")}
  description={copy.description}
  schema={[
    pageNode(locale, path, copy.title, "WebPage"),
    pageNode(locale, path, copy.faqHeading, "FAQPage", {
      "@id": `${new URL(path, Astro.site)}#faq`,
      mainEntity: faqEntities(copy.faqs),
    }),
    breadcrumbNode(locale, [
      { name: overview.h1, path: localizePath("/examples", locale) },
      { name: overview.cardTitle, path },
    ]),
  ]}
>
  <main id="main-content">
    <EditorialHero title={copy.h1} copy={copy.intro}>
      <ol class="m-0 flex list-none items-center gap-2 p-0 text-sm text-muted">
        <li>
          <a
            class="underline decoration-line-strong underline-offset-4 hover:decoration-ink"
            href={localizePath("/examples", locale)}
          >
            {overview.h1}
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{overview.cardTitle}</li>
      </ol>
    </EditorialHero>

    <section class="px-page pb-section">
      <article class="mx-auto grid max-w-[70rem] grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-8 rounded-card bg-white p-card-fluid shadow-surface max-compact:grid-cols-1">
        <div>
          <p class="m-0 text-sm text-muted">{copy.concept.label}</p>
          <h2 class="mt-3 text-heading-md">{copy.concept.title}</h2>
          <p class="mt-3 max-w-reading text-lg/7 text-muted">{copy.concept.text}</p>
          <a
            class="mt-6 inline-block text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
            href={conceptHref}
          >
            {copy.concept.link}
          </a>
        </div>
        <a href={conceptHref} tabindex="-1" aria-hidden="true" class="block max-compact:-order-1">
          <ConceptPreview />
        </a>
      </article>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <SectionHeading title={copy.requirementsHeading} />
        <ol class="m-0 grid list-none grid-cols-2 gap-4 p-0 max-compact:grid-cols-1">
          {copy.requirements.map((item) => (
            <li class="rounded-card bg-white p-card-padding shadow-surface">
              <h3 class="m-0 text-heading-sm">{item.title}</h3>
              <p class="mt-3 text-base/6 text-muted">{item.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-white px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <SectionHeading title={copy.costsHeading} />
        <ul class="m-0 grid gap-3 pl-5 text-lg/7 text-muted">
          {copy.costs.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mt-6 text-lg/7 text-muted">{copy.costsAfter}</p>
      </div>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <SectionHeading title={copy.processHeading} />
        <ol class="m-0 grid list-inside list-decimal grid-cols-2 gap-4 p-0 max-compact:grid-cols-1">
          {copy.process.map((item) => (
            <li class="rounded-card bg-white p-card-padding text-meta text-muted shadow-surface">
              <h3 class="mt-4 text-heading-sm text-ink">{item.title}</h3>
              <p class="mt-3 text-base/6 text-muted">{item.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-page py-section">
      <SectionHeading title={copy.faqHeading} align="center" />
      <div class="mx-auto max-w-[820px]">
        <Faq items={faqs} id={`hotels-${locale}`} />
      </div>
    </section>

    <section class="flex min-h-[28rem] flex-col items-center justify-center bg-black px-page py-section text-center text-inverse">
      <div class="reveal min-w-0 w-full" data-reveal>
        <h2 class="mx-auto max-w-[18ch] text-display-sm text-white">{copy.cta.heading}</h2>
        <p class="mx-auto mt-6 mb-7 max-w-[35rem] text-lg/7 text-inverse-muted">{copy.cta.text}</p>
        <div class="flex justify-center gap-3">
          <CtaButton
            href={`${localizePath("/contact", locale)}?service=websites-apps`}
            light
            className="[&>span:first-child]:min-w-0"
          >
            {copy.cta.button}
          </CtaButton>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
