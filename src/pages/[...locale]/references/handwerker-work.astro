---
import type { GetStaticPaths } from "astro";
import ConceptPreview from "@/components/concept-preview.astro";
import CtaButton from "@/components/cta-button.astro";
import EditorialHero from "@/components/editorial-hero.astro";
import FinalCta from "@/components/final-cta.astro";
import SectionHeading from "@/components/section-heading.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { getReferencesCopy } from "@/i18n/references";
import { localeStaticPaths, localizePath, type Locale } from "@/lib/i18n";
import { breadcrumbNode, pageNode } from "@/lib/structured-data";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { handwerkerWork: copy } = getReferencesCopy(locale);
const path = localizePath("/references/handwerker-work", locale);
const site = "https://handwerker.work/";
---

<SiteLayout
  locale={locale}
  title={copy.title.replace(/ \| Suchio$/, "")}
  description={copy.description}
  schema={[
    pageNode(locale, path, copy.title, "WebPage", {
      about: { "@type": "Organization", name: copy.name, url: site },
    }),
    breadcrumbNode(locale, [{ name: copy.name, path }]),
  ]}
>
  <main id="main-content">
    <EditorialHero title={copy.h1} copy={copy.intro}>
      <CtaButton href={site} className="mt-4 [&>span:first-child]:min-w-0">
        {copy.visit}
      </CtaButton>
    </EditorialHero>

    <section class="px-page pb-section">
      <div class="mx-auto max-w-layout">
        <a href={site} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-shell shadow-floating">
          <ConceptPreview
            base="/references/handwerker-work-preview"
            sizes="(max-width: 1200px) 100vw, 75rem"
            className=""
          />
        </a>
      </div>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto max-w-layout">
        <SectionHeading title={copy.resultsHeading} />
        <dl class="m-0 grid grid-cols-4 gap-4 max-nav:grid-cols-2 max-narrow:grid-cols-1">
          {copy.results.map((item) => (
            <div class="flex flex-col rounded-card bg-white p-card-padding shadow-surface">
              <dt class="order-2 mt-3 text-base/6 text-muted">{item.label}</dt>
              <dd class="order-1 m-0 text-heading-lg tabular-nums">{item.after}</dd>
              {item.before && (
                <dd class="order-3 m-0 mt-1 text-meta text-muted tabular-nums">
                  {copy.beforeLabel} {item.before}
                </dd>
              )}
            </div>
          ))}
        </dl>
        <p class="mt-6 max-w-[45rem] text-meta text-muted">{copy.resultsNote}</p>
      </div>
    </section>

    <section class="bg-white px-page py-section">
      <div class="mx-auto grid max-w-layout grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-x-split gap-y-8 max-nav:grid-cols-1">
        <div class="reveal" data-reveal>
          <h2 class="m-0 text-heading-lg">{copy.startHeading}</h2>
          <p class="mt-4 max-w-[26rem] text-lg/7 text-muted">{copy.startText}</p>
        </div>
        <ul class="m-0 list-none border-b border-line p-0">
          {copy.start.map((item) => (
            <li class="border-t border-line py-5 text-lg/7">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-page py-section">
      <div class="mx-auto max-w-layout">
        <SectionHeading title={copy.workHeading} />
        <ul class="m-0 grid list-none grid-cols-2 gap-x-split p-0 max-nav:grid-cols-1">
          {copy.work.map((item) => (
            <li class="border-t border-line py-6">
              <h3 class="m-0 text-heading-sm">{item.title}</h3>
              <p class="mt-2 max-w-[30rem] text-base/6 text-muted">{item.copy}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-page pb-section">
      <div class="mx-auto max-w-layout">
        <SectionHeading title={copy.pagesHeading} />
        <ul class="m-0 grid list-none grid-cols-3 gap-4 p-0 max-nav:grid-cols-1">
          {copy.pages.map((item) => (
            <li class="rounded-card bg-white p-card-padding shadow-surface">
              <a
                class="text-heading-sm text-ink underline decoration-line-strong underline-offset-4 transition-[text-decoration-color] hover:decoration-ink"
                href={item.href}
              >
                {item.label}
              </a>
              <p class="mt-2 text-base/6 text-muted">{item.copy}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <FinalCta
      locale={locale}
      title={copy.cta.heading}
      copy={copy.cta.text}
      button={copy.cta.button}
      href={`${localizePath("/contact", locale)}?service=websites-apps`}
    />
  </main>
</SiteLayout>
