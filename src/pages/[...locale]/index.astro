---
import type { GetStaticPaths } from "astro";
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import CtaButton from "@/components/cta-button.astro";
import Faq from "@/components/faq.astro";
import FinalCta from "@/components/final-cta.astro";
import OfferVisual from "@/components/offer-visual.astro";
import ReferenceTeaser from "@/components/reference-teaser.astro";
import Reveal from "@/components/reveal.astro";
import SectionHeading from "@/components/section-heading.astro";
import { serviceStyles } from "@/components/service-styles";
import WhatsAppButton from "@/components/whatsapp-button.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { getFaqs } from "@/lib/faqs";
import { localeStaticPaths, localizePath, t, type Locale } from "@/lib/i18n";
import { getServiceCatalog } from "@/lib/service-catalog";
import { faqEntities, organizationReference, pageNode } from "@/lib/structured-data";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const faqs = await getFaqs(locale);
---

<SiteLayout
  locale={locale}
  description={t(locale, "meta.homeDescription")}
  schema={[
    pageNode(locale, localizePath("/", locale), t(locale, "meta.siteTitle"), "FAQPage", {
      about: organizationReference,
      mainEntity: faqEntities(faqs),
    }),
  ]}
>
  <main id="main-content">
    <section
      id="intro"
      class="hero--home relative isolate grid min-h-0 min-w-0 grid-cols-[minmax(0,1fr)] bg-canvas [place-items:start_center] px-page pt-page-title pb-section"
    >
      <div class="flex min-w-0 w-full max-w-[62rem] flex-col items-center text-center">
        <h1 class="shiny-text mt-6 mb-6 w-full max-w-[18ch] text-display-lg text-ink">
          <>
            {t(locale, "home.heroLine1")} <em class="hero-accent">{t(locale, "home.heroAccent")}</em>.<br />
            {t(locale, "home.heroLine2")}
          </>
        </h1>
        <p class="hero-copy m-0 max-w-narrow text-lead text-muted">{t(locale, "home.heroDescription")}</p>
        <div class="hero-actions mt-8 flex gap-3 max-narrow:w-[min(20rem,100%)]">
          <CtaButton href={localizePath("/contact", locale)} className="max-narrow:flex-1 [&>span:first-child]:min-w-0">
            {t(locale, "home.ctaContact")}
          </CtaButton>
          <WhatsAppButton locale={locale} />
        </div>
      </div>
    </section>
    <ReferenceTeaser locale={locale} />
    <section id="services" class="px-page py-section">
      <SectionHeading title={t(locale, "home.section1Title")} copy={t(locale, "home.servicesCopy")} align="center" />
      <div class="mx-auto grid max-w-[70rem] grid-cols-2 gap-4 max-nav:grid-cols-1">
        {getServiceCatalog(locale).map((service, index) => (
          <Reveal className="min-w-0" delay={index * 50}>
            <a
              class="pill-button flex h-full min-w-0 flex-col overflow-hidden rounded-card bg-white shadow-surface transition-[box-shadow,transform] duration-150 hover:shadow-surface-hover motion-reduce:transition-none"
              href={service.href}
            >
              <div class={`px-8 pt-8 max-narrow:px-4 max-narrow:pt-4 ${serviceStyles[service.id].background}`}>
                <OfferVisual animation={service.animation} locale={locale} />
              </div>
              <div class="flex flex-1 items-start gap-4 p-card-padding">
                <div class="min-w-0 flex-1">
                  <h3 class="m-0 text-heading-md">{service.copy.name}</h3>
                  <p class="mt-2 mb-0 text-base/6 text-muted">{service.copy.homeDescription}</p>
                </div>
                <span
                  class="pill-button__icon relative mt-1 size-9 flex-none overflow-hidden rounded-pill bg-inverse-surface text-white"
                  aria-hidden="true"
                >
                  <ArrowRight
                    class="pill-button__arrow pill-button__arrow--right absolute inset-[9px] size-[18px]"
                    stroke-width={1.7}
                  />
                  <ArrowUpRight
                    class="pill-button__arrow pill-button__arrow--up-right absolute inset-[9px] size-[18px] opacity-0 [transform:translate(-6px,6px)_scale(.8)]"
                    stroke-width={1.7}
                  />
                </span>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
    </section>
    <section id="faq" class="bg-canvas px-page py-section">
      <SectionHeading title={t(locale, "home.faqHeading")} align="center" />
      <div class="mx-auto max-w-[820px]">
        <Faq items={faqs} id={`home-faq-${locale}`} />
      </div>
    </section>
    <FinalCta locale={locale} singleLine />
  </main>
</SiteLayout>
