---
import type { GetStaticPaths } from "astro";
import { ArrowUpRight } from "@lucide/astro";
import CtaButton from "@/components/cta-button.astro";
import Faq from "@/components/faq.astro";
import FinalCta from "@/components/final-cta.astro";
import ReferenceTeaser from "@/components/reference-teaser.astro";
import { serviceIcons } from "@/components/service-icons";
import { serviceStyles } from "@/components/service-styles";
import { getServiceCatalog } from "@/lib/service-catalog";
import { getReferencesCopy, handwerkerWorkMeasurements as measured } from "@/i18n/references";
import Reveal from "@/components/reveal.astro";
import SectionHeading from "@/components/section-heading.astro";
import { publicWhatsAppHref } from "@/lib/contact";
import SiteLayout from "@/layouts/site-layout.astro";
import { getFaqs } from "@/lib/faqs";
import { localeStaticPaths, localizePath, t, type Locale } from "@/lib/i18n";
import { faqEntities, organizationReference, pageNode } from "@/lib/structured-data";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const faqs = await getFaqs(locale);
const references = getReferencesCopy(locale);
const heroLabel = references.teaser.heroLabel
  .replace("{before}", String(measured.pages.home[0]))
  .replace("{after}", String(measured.pages.home[1]));
const guarantees = [1, 2, 3, 4] as const;
const inquiry = [1, 2, 3] as const;
---

<SiteLayout
  locale={locale}
  description={t(locale, "meta.homeDescription")}
  schema={[
    pageNode(locale, localizePath("/", locale), t(locale, "meta.siteTitle"), "FAQPage", {
      about: organizationReference,
      mainEntity: faqEntities(faqs),
    }),
  ]}
>
  <main id="main-content">
    <section id="intro" class="hero--home px-page pt-page-title pb-12">
      <div class="mx-auto grid max-w-[70rem] min-w-0 items-center gap-12 lg:grid-cols-2">
        <div class="min-w-0">
          <h1 class="shiny-text mt-6 mb-6 text-display-lg text-ink">
            {t(locale, "home.heroLine1")} <em class="hero-accent">{t(locale, "home.heroAccent")}</em>.<br />
            {t(locale, "home.heroLine2")}
          </h1>
          <p class="hero-copy m-0 max-w-narrow text-lead text-muted">{t(locale, "home.heroDescription")}</p>
          <div class="hero-actions mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <CtaButton href={localizePath("/contact", locale)} className="shrink-0 [&>span:first-child]:min-w-0">
              {t(locale, "home.ctaContact")}
            </CtaButton>
            <a class="text-sm text-muted underline underline-offset-4 hover:text-ink" href={publicWhatsAppHref}>
              {t(locale, "home.whatsappLink")}
            </a>
          </div>
        </div>
        <figure class="relative m-0 min-w-0 overflow-hidden rounded-card shadow-surface">
          <picture>
            <source
              type="image/avif"
              srcset="/references/handwerker-work-preview-720.avif 720w, /references/handwerker-work-preview-1440.avif 1440w"
              sizes="(min-width: 1024px) 35rem, 100vw"
            />
            <img
              class="block h-auto w-full"
              src="/references/handwerker-work-preview-1440.webp"
              srcset="/references/handwerker-work-preview-720.webp 720w, /references/handwerker-work-preview-1440.webp 1440w"
              sizes="(min-width: 1024px) 35rem, 100vw"
              width="1440"
              height="900"
              alt={references.handwerkerWork.afterShot.alt}
              fetchpriority="high"
            />
          </picture>
          <figcaption class="absolute right-3 bottom-3 left-3 w-fit rounded-control bg-white px-3 py-2 text-meta shadow-surface">
            {heroLabel}
          </figcaption>
        </figure>
      </div>
    </section>
    <ReferenceTeaser locale={locale} />
    <section id="services" class="px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <Reveal>
          <h2 class="m-0 mb-8 text-heading-lg">{t(locale, "home.section1Title")}</h2>
        </Reveal>
        <div class="grid gap-3">
          {getServiceCatalog(locale).map((service) => {
            const Icon = serviceIcons[service.id];
            return (
              <Reveal>
                <a
                  class="pill-button flex min-w-0 items-center gap-5 rounded-card bg-white p-5 shadow-surface transition-[background-color,box-shadow,transform] duration-150 hover:bg-interaction hover:shadow-surface-hover motion-reduce:transition-none sm:p-6"
                  href={service.href}
                >
                  <span
                    class={`grid size-12 shrink-0 place-items-center rounded-control ${serviceStyles[service.id].icon}`}
                  >
                    <Icon class="size-6" aria-hidden="true" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-heading-sm">{service.copy.name}</span>
                    <span class="mt-2 block text-base/6 text-muted">{service.copy.homeDescription}</span>
                  </span>
                  <ArrowUpRight class="size-5 shrink-0" aria-hidden="true" />
                </a>
              </Reveal>
            );
          })}
        </div>
      </div>
    </section>
    <section class="px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <Reveal>
          <h2 class="m-0 mb-10 text-heading-lg">{t(locale, "home.guaranteesTitle")}</h2>
        </Reveal>
        <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
          {guarantees.map((index) => (
            <Reveal className="border-t border-line-strong pt-6">
              <h3 class="m-0 text-lg font-bold">{t(locale, `home.guarantees${index}Title`)}</h3>
              <p class="mt-3 mb-0 max-w-narrow text-base/6 text-muted">{t(locale, `home.guarantees${index}Copy`)}</p>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
    <section class="px-page py-section">
      <div class="mx-auto max-w-[70rem]">
        <Reveal>
          <h2 class="m-0 mb-10 text-heading-lg">{t(locale, "home.inquiryTitle")}</h2>
        </Reveal>
        <ol class="m-0 grid list-none gap-8 p-0 md:grid-cols-3">
          {inquiry.map((index) => (
            <Reveal as="li">
              <span class="font-mono text-meta text-muted" aria-hidden="true">
                {index}
              </span>
              <h3 class="mt-4 mb-3 text-heading-sm">{t(locale, `home.inquiry${index}Title`)}</h3>
              <p class="m-0 text-base/6 text-muted">{t(locale, `home.inquiry${index}Copy`)}</p>
            </Reveal>
          ))}
        </ol>
      </div>
    </section>
    <section id="faq" class="bg-canvas px-page py-section">
      <SectionHeading title={t(locale, "home.faqHeading")} align="center" />
      <div class="mx-auto max-w-[820px]">
        <Faq items={faqs} id={`home-faq-${locale}`} />
      </div>
    </section>
    <FinalCta locale={locale} singleLine />
  </main>
</SiteLayout>
