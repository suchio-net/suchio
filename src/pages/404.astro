---
import NotFoundPage from "@/components/not-found-page.astro";
import SiteLayout from "@/layouts/site-layout.astro";
import { defaultLocale } from "@/i18n/config";
import { notFoundMessages } from "@/i18n/not-found";
const copy = notFoundMessages[defaultLocale];
---

<SiteLayout locale={defaultLocale} documentTitle={copy.title} title={copy.title} description={copy.copy} noindex>
  <NotFoundPage copy={copy} homeHref="/" />
</SiteLayout>
